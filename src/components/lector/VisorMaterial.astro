---
// Visor del material de clase del taller (solo lectura, sin descarga). Cada página es una imagen barajada en piezas
// que se recompone en un canvas, como en LectorLibro. Las páginas las genera scripts/lector/material_taller.py.
export interface DocMaterial { slug: string; titulo: string; ancho: number; alto: number; cols: number; filas: number; pad: number; sal: number; base: string; paginas: (string | null)[] }
interface Props { documentos: DocMaterial[]; marca: string }
const { documentos, marca } = Astro.props;
---
<div data-visor class="select-none">
  <div class="sticky top-16 z-20 lg:top-[4.5rem] -mx-4 mb-8 flex gap-2 overflow-x-auto border-b border-linea bg-fondo/95 px-4 py-3 backdrop-blur" role="tablist">
    {documentos.map((d, i) => (
      <button type="button" role="tab" data-tab={d.slug} aria-selected={i === 0 ? 'true' : 'false'} class="visor-tab border border-linea">
        {d.titulo} <span class="opacity-60">· {d.paginas.length} {d.paginas.length === 1 ? 'pág.' : 'págs.'}</span>
      </button>
    ))}
  </div>
  {documentos.map((d, i) => (
    <section data-doc={d.slug} hidden={i !== 0} aria-label={d.titulo}>
      <div class:list={['mx-auto grid gap-6', d.ancho > d.alto ? 'max-w-5xl' : 'max-w-3xl']}>
        {d.paginas.map((_, p) => (
          <div class="relative overflow-hidden rounded-md bg-white shadow-suave ring-1 ring-linea" style={`aspect-ratio: ${d.ancho} / ${d.alto}`}>
            <canvas data-p={p} class="block h-full w-full"></canvas>
            <span class="pointer-events-none absolute bottom-1 right-2 text-[0.65rem] text-black/30">{p + 1} / {d.paginas.length}</span>
          </div>
        ))}
      </div>
    </section>
  ))}
  <p data-aviso class="pointer-events-none fixed bottom-6 left-1/2 z-50 -translate-x-1/2 rounded-full bg-black/80 px-4 py-2 text-sm text-white opacity-0 transition-opacity"></p>
  <script type="application/json" data-visor-datos set:html={JSON.stringify({ documentos, marca })} />
</div>
<div class="solo-impresion">Este material se consulta en línea en letrasyvocesdetabasco.org; no está disponible para impresión ni descarga.</div>

<style>
  .visor-tab { white-space: nowrap; border-radius: 9999px; padding: 0.45rem 1rem; font-size: 0.9rem; font-weight: 600; }
  .visor-tab[aria-selected='true'] { background: #EF7B38; border-color: #EF7B38; color: #fff; }
  .solo-impresion { display: none; }
  @media print {
    [data-visor] { display: none !important; }
    .solo-impresion { display: block !important; padding: 3rem; font: 16pt Georgia, serif; }
  }
</style>

<script>
  type Doc = { slug: string; titulo: string; ancho: number; alto: number; cols: number; filas: number; pad: number; sal: number; base: string; paginas: (string | null)[] };
  const raiz = document.querySelector<HTMLElement>('[data-visor]');
  if (raiz) {
    const { documentos, marca } = JSON.parse(raiz.querySelector('[data-visor-datos]')!.textContent!) as { documentos: Doc[]; marca: string };
    const mulberry32 = (a: number) => () => { a |= 0; a = (a + 0x6d2b79f5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
    const perm = (i: number, D: Doc) => { const r = mulberry32((i * 2654435761 + D.sal) >>> 0); const p = [...Array(D.cols * D.filas).keys()]; for (let k = p.length - 1; k > 0; k--) { const j = Math.floor(r() * (k + 1)); [p[k], p[j]] = [p[j], p[k]]; } return p; };
    const dibujar = async (c: HTMLCanvasElement, D: Doc, i: number) => {
      const n = D.paginas[i]; const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = Math.round(c.clientWidth * dpr), h = Math.round(c.clientHeight * dpr); c.width = w; c.height = h;
      const x = c.getContext('2d')!; x.imageSmoothingQuality = 'high'; x.fillStyle = '#fff'; x.fillRect(0, 0, w, h);
      if (!n) return;
      const b = await fetch(D.base + n, { credentials: 'omit' }).then((r) => (r.ok ? r.blob() : null)).catch(() => null);
      if (!b) { x.fillStyle = '#999'; x.font = `${14 * dpr}px sans-serif`; x.textAlign = 'center'; x.fillText('No se pudo cargar esta página', w / 2, h / 2); return; }
      const bm = await createImageBitmap(b);
      const TW = D.ancho / D.cols, TH = D.alto / D.filas, CW = TW + 2 * D.pad, CH = TH + 2 * D.pad, p = perm(i, D);
      for (let j = 0; j < p.length; j++) {
        const k = p[j], sx = (j % D.cols) * CW + D.pad, sy = Math.floor(j / D.cols) * CH + D.pad, col = k % D.cols, fil = Math.floor(k / D.cols);
        const dx0 = Math.round(col * TW * w / D.ancho), dx1 = Math.round((col + 1) * TW * w / D.ancho), dy0 = Math.round(fil * TH * h / D.alto), dy1 = Math.round((fil + 1) * TH * h / D.alto);
        x.drawImage(bm, sx, sy, TW, TH, dx0, dy0, dx1 - dx0, dy1 - dy0);
      }
      bm.close();
      x.fillStyle = 'rgba(80,72,64,.30)'; x.font = `${Math.max(7, w / dpr * 0.014) * dpr}px Inter, system-ui, sans-serif`; x.textAlign = 'center';
      x.fillText(marca, w / 2, h - Math.max(5, h * 0.012));
    };
    const obs = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return; const c = e.target as HTMLCanvasElement; obs.unobserve(c);
      const D = documentos.find((d) => d.slug === c.closest<HTMLElement>('[data-doc]')!.dataset.doc)!; dibujar(c, D, Number(c.dataset.p));
    }), { rootMargin: '600px 0px' });
    raiz.querySelectorAll<HTMLCanvasElement>('canvas[data-p]').forEach((c) => obs.observe(c));
    let rt = 0; addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(() => raiz.querySelectorAll<HTMLCanvasElement>('canvas[data-p]').forEach((c) => { c.width = 0; obs.observe(c); }), 250); });

    const tabs = raiz.querySelectorAll<HTMLButtonElement>('[data-tab]');
    const mostrar = (slug: string) => { tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === slug))); raiz.querySelectorAll<HTMLElement>('[data-doc]').forEach((s) => (s.hidden = s.dataset.doc !== slug)); };
    tabs.forEach((t) => t.addEventListener('click', () => { mostrar(t.dataset.tab!); history.replaceState(null, '', '#' + t.dataset.tab); }));
    const h = location.hash.slice(1); if (h && documentos.some((d) => d.slug === h)) mostrar(h);

    // Protección de lectura: sin menú contextual, arrastre, guardado ni impresión
    const aviso = (t: string) => { const a = raiz.querySelector<HTMLElement>('[data-aviso]')!; a.textContent = t; a.style.opacity = '1'; clearTimeout((a as any)._t); (a as any)._t = setTimeout(() => (a.style.opacity = '0'), 2400); };
    raiz.addEventListener('contextmenu', (e) => { e.preventDefault(); aviso('El material se consulta en línea; no se puede descargar.'); });
    raiz.addEventListener('dragstart', (e) => e.preventDefault());
    document.addEventListener('keydown', (e) => { const k = e.key.toLowerCase(); if ((e.ctrlKey || e.metaKey) && ['s', 'p', 'u'].includes(k)) { e.preventDefault(); aviso('El material solo puede consultarse en línea.'); } });
  }
</script>
