---
// Reproductor persistente: sobrevive a la navegación entre páginas (transition:persist).
// Cualquier página puede reproducir con: document.dispatchEvent(new CustomEvent('lvt:reproducir', { detail: { lista: [...], indice: 0 } }))
// Cada pista: { id, src, titulo, autor, declamador, portada?, href? }
---
<div id="reproductor" data-pagefind-ignore transition:persist="reproductor" class="fixed inset-x-0 bottom-0 z-[45] translate-y-[120%] transition-transform duration-500 ease-suave" style="padding-bottom: env(safe-area-inset-bottom, 0px)" data-estado="pausado" aria-live="polite" aria-label="Reproductor de la audioteca">
  <div class="mx-auto w-full max-w-[1200px] px-3 pb-3 sm:px-6">
    <div class="borde-luz grid grid-cols-[auto_1fr_auto] items-center gap-3 rounded-[1.25rem] bg-noche/95 p-3 text-white shadow-alta ring-1 ring-white/10 backdrop-blur-xl sm:grid-cols-[auto_1fr_auto_auto] sm:gap-4 sm:p-4">
      <button type="button" data-r-play class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-naranja text-white transition hover:scale-105 active:scale-95" aria-label="Reproducir o pausar">
        <svg data-ic-play class="h-5 w-5 translate-x-[1px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"/></svg>
        <svg data-ic-pausa class="hidden h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 4h4v16H6zM14 4h4v16h-4z"/></svg>
      </button>
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <span class="ondas text-naranja" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <p class="truncate font-serif text-[1.05rem] italic leading-tight sm:text-lg" data-r-titulo>—</p>
        </div>
        <p class="truncate text-xs text-white/60" data-r-autor></p>
        <div class="mt-2 flex items-center gap-2 text-[0.68rem] text-white/60 numero">
          <span data-r-actual>0:00</span>
          <input type="range" data-r-barra min="0" max="1000" value="0" class="h-1 flex-1 cursor-pointer appearance-none rounded-full bg-white/20 accent-[#EF7B38]" aria-label="Posición de la pista" />
          <span data-r-total>0:00</span>
        </div>
      </div>
      <div class="hidden items-center gap-1 sm:flex">
        <button type="button" data-r-prev class="grid h-10 w-10 place-items-center rounded-full text-white/70 transition hover:bg-white/10 hover:text-white" aria-label="Anterior"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h2v14H6zM20 5v14L9 12z"/></svg></button>
        <button type="button" data-r-next class="grid h-10 w-10 place-items-center rounded-full text-white/70 transition hover:bg-white/10 hover:text-white" aria-label="Siguiente"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 5h2v14h-2zM4 5v14l11-7z"/></svg></button>
        <button type="button" data-r-vel class="h-10 rounded-full px-2.5 font-display text-xs font-bold text-white/70 transition hover:bg-white/10 hover:text-white numero" aria-label="Velocidad de reproducción">1×</button>
        <a data-r-leer href="/audioteca" class="h-10 rounded-full px-3 font-display text-xs font-bold leading-10 text-naranja transition hover:bg-white/10">Leer</a>
      </div>
      <button type="button" data-r-cerrar class="grid h-10 w-10 place-items-center rounded-full text-white/60 transition hover:bg-white/10 hover:text-white" aria-label="Cerrar reproductor">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
  </div>
  <audio data-r-audio preload="none"></audio>
</div>

<script>
  type Pista = { id: string; src: string; titulo: string; autor: string; declamador?: string; portada?: string; href?: string };
  const r = document.getElementById('reproductor')!;
  if (r && !(r as any).__listo) {
    (r as any).__listo = true;
    const a = r.querySelector<HTMLAudioElement>('[data-r-audio]')!;
    const q = <T extends Element>(s: string) => r.querySelector<T>(s)!;
    let lista: Pista[] = [], i = -1;
    const vels = [1, 1.25, 1.5, 0.85];
    const fmt = (s: number) => isFinite(s) ? `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}` : '0:00';
    const actual = () => lista[i];
    const emitir = () => document.dispatchEvent(new CustomEvent('lvt:estado', { detail: { id: actual()?.id ?? null, reproduciendo: !a.paused && !a.ended, tiempo: a.currentTime, duracion: a.duration } }));
    const pintar = () => {
      const p = actual(); if (!p) return;
      q('[data-r-titulo]').textContent = p.titulo; q('[data-r-autor]').textContent = p.declamador ? `${p.autor} · ${p.declamador}` : p.autor;
      q<HTMLAnchorElement>('[data-r-leer]').href = p.href || `/audioteca#${p.id}`;
      r.dataset.estado = a.paused ? 'pausado' : 'sonando';
      q('[data-ic-play]').classList.toggle('hidden', !a.paused); q('[data-ic-pausa]').classList.toggle('hidden', a.paused);
      if ('mediaSession' in navigator) {
        navigator.mediaSession.metadata = new MediaMetadata({ title: p.titulo, artist: p.autor, album: 'Audioteca · Letras y Voces de Tabasco', artwork: [{ src: p.portada || '/apple-touch-icon.png', sizes: '512x512', type: 'image/png' }] });
        navigator.mediaSession.setActionHandler('play', () => a.play()); navigator.mediaSession.setActionHandler('pause', () => a.pause());
        navigator.mediaSession.setActionHandler('previoustrack', () => ir(i - 1)); navigator.mediaSession.setActionHandler('nexttrack', () => ir(i + 1));
      }
      emitir();
    };
    const mostrar = (v: boolean) => { r.classList.toggle('translate-y-[120%]', !v); document.body.classList.toggle('con-reproductor', v); };
    const ir = (n: number, auto = true) => {
      if (n < 0 || n >= lista.length) return;
      i = n; const p = lista[i]; if (a.src !== new URL(p.src, location.href).href) a.src = p.src;
      mostrar(true); pintar(); if (auto) a.play().catch(() => {});
      try { localStorage.setItem('lvt-ultima-pista', p.id); } catch {}
    };
    document.addEventListener('lvt:reproducir', (e: Event) => {
      const d = (e as CustomEvent).detail as { lista: Pista[]; indice: number; alternar?: boolean };
      const p = d.lista[d.indice];
      if (d.alternar !== false && actual()?.id === p.id) { a.paused ? a.play() : a.pause(); return; }
      lista = d.lista; ir(d.indice);
    });
    document.addEventListener('lvt:buscar', (e: Event) => { const t = (e as CustomEvent).detail as number; if (isFinite(t)) a.currentTime = t; });
    q('[data-r-play]').addEventListener('click', () => { if (!actual()) return; a.paused ? a.play() : a.pause(); });
    q('[data-r-prev]').addEventListener('click', () => ir(i - 1)); q('[data-r-next]').addEventListener('click', () => ir(i + 1));
    q('[data-r-cerrar]').addEventListener('click', () => { a.pause(); mostrar(false); });
    q('[data-r-vel]').addEventListener('click', (ev) => { const b = ev.currentTarget as HTMLButtonElement; const k = (vels.indexOf(a.playbackRate) + 1) % vels.length; a.playbackRate = vels[k]; b.textContent = `${vels[k]}×`; });
    const barra = q<HTMLInputElement>('[data-r-barra]'); let arrastrando = false;
    barra.addEventListener('input', () => { arrastrando = true; q('[data-r-actual]').textContent = fmt(barra.valueAsNumber / 1000 * (a.duration || 0)); });
    barra.addEventListener('change', () => { a.currentTime = barra.valueAsNumber / 1000 * (a.duration || 0); arrastrando = false; });
    a.addEventListener('timeupdate', () => { if (!arrastrando && a.duration) barra.value = String(Math.round(a.currentTime / a.duration * 1000)); q('[data-r-actual]').textContent = fmt(a.currentTime); emitir(); });
    a.addEventListener('durationchange', () => { q('[data-r-total]').textContent = fmt(a.duration); });
    ['play', 'pause', 'ended'].forEach((ev) => a.addEventListener(ev, pintar));
    a.addEventListener('ended', () => { if (i + 1 < lista.length) ir(i + 1); });
    document.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement; if (!actual() || ['INPUT', 'TEXTAREA', 'SELECT'].includes(t.tagName) || t.isContentEditable) return;
      if (e.code === 'Space' && !(t.closest('button,a,summary'))) { e.preventDefault(); a.paused ? a.play() : a.pause(); }
      if (e.key === 'ArrowRight' && e.shiftKey) a.currentTime += 10; if (e.key === 'ArrowLeft' && e.shiftKey) a.currentTime -= 10;
    });
    // Las páginas pueden pedir el estado actual al cargar
    document.addEventListener('lvt:consultar', emitir);
  }
</script>
