---
import type { Escritor } from '../../lib/escritores';
import { nombreBloque } from '../../lib/escritores';
interface Props { e: Escritor; i?: number; cita?: string; }
const { e, i = 0, cita } = Astro.props;
const sinFoto = e.foto.includes('placeholder');
const iniciales = e.nombreCorto.split(' ').filter((w) => w.length > 2 && !/^(de|la|del|los|las|y)$/i.test(w)).slice(0, 2).map((w) => w[0]).join('');
---
<a href={`/escritores/${e.id}`} class="group block" style={`--i:${i % 10}`} data-nombre={e.nombreCorto}>
  <span class="relative block aspect-[3/4] overflow-hidden rounded-pieza bg-linea">
    {sinFoto ? (
      <span class="flex h-full w-full flex-col justify-between bg-noche p-4 text-white transition duration-700 ease-suave group-hover:bg-noche-2" transition:name={`retrato-${e.id}`}>
        <img src="/assets/logos/LVT Logo Iso 6 Blanco Relleno.svg" alt="" class="h-6 w-6 opacity-50" />
        <span class="font-display text-[3.2rem] font-extrabold leading-none tracking-tight text-naranja">{iniciales}</span>
        <span class="font-serif text-[0.8rem] italic text-white/50">Sin retrato libre disponible</span>
      </span>
    ) : (
      <img src={e.foto} alt={`Retrato de ${e.nombreCorto}`} loading="lazy" decoding="async" width="600" height="800" class="retrato h-full w-full object-top group-hover:scale-[1.04] group-hover:grayscale-0" transition:name={`retrato-${e.id}`} />
    )}
    <span class="absolute left-3 top-3 rounded-full bg-fondo/90 px-2.5 py-1 text-[0.68rem] font-semibold text-grafito backdrop-blur">{nombreBloque(e.bloque)}</span>
    {cita && <span class="absolute inset-x-0 bottom-0 translate-y-full bg-gradient-to-t from-noche/95 to-noche/0 p-4 pt-10 text-white transition duration-500 ease-suave group-hover:translate-y-0"><span class="line-clamp-4 font-serif text-sm italic leading-snug">«{cita}»</span></span>}
  </span>
  <span class="mt-3 block font-display text-[1.05rem] font-bold leading-tight transition group-hover:text-naranja-tinta">{e.nombreCorto}</span>
  <span class="mt-0.5 block text-sm text-tenue numero">{e.anios}</span>
  <span class="mt-1 block font-serif text-[0.98rem] italic leading-snug text-grafito">{e.tituloHonorifico}</span>
</a>
