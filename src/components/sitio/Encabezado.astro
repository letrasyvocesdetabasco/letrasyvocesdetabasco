---
import { NAV, NAV_SECUNDARIA, RIFA_ACTIVA, CONTACTO, wa } from '../../lib/sitio';
import Logo from './Logo.astro';
const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const activo = (href: string) => ruta === href || ruta.startsWith(href + '/') || (href === '/escritores-ilustres' && ruta.startsWith('/escritores'));
const secundaria = NAV_SECUNDARIA.filter((n) => n.href !== '/rifa' || RIFA_ACTIVA);
---
<header id="encabezado" data-pagefind-ignore class="sticky top-0 z-50 border-b border-transparent bg-fondo/85 backdrop-blur-xl transition-[border-color,box-shadow] duration-300" style="padding-top: env(safe-area-inset-top, 0px)">
  <div class="envoltura-ancha flex h-16 items-center justify-between gap-4 lg:h-[4.5rem]">
    <a href="/" class="flex shrink-0 items-center" aria-label="Letras y Voces de Tabasco, inicio">
      <Logo clase="h-10 lg:h-11" />
    </a>

    <nav class="hidden items-center gap-0.5 xl:flex" aria-label="Principal">
      {NAV.map((n) => (
        <a href={n.href} aria-current={activo(n.href) ? 'page' : undefined}
           class:list={['relative whitespace-nowrap rounded-full px-3 py-2 font-display text-[0.84rem] font-semibold text-grafito transition hover:text-tinta 2xl:px-3.5',
             activo(n.href) && 'text-tinta after:absolute after:inset-x-3 after:-bottom-0.5 after:h-0.5 after:rounded-full after:bg-naranja']}>
          {n.texto}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href="/buscar" class="grid h-11 w-11 place-items-center rounded-full border border-linea text-grafito transition hover:border-naranja hover:text-tinta" aria-label="Buscar en el sitio">
        <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
      <button type="button" data-tema class="grid h-11 w-11 place-items-center rounded-full border border-linea text-grafito transition hover:border-naranja hover:text-tinta" aria-label="Cambiar entre modo claro y nocturno">
        <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
        <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a href="/taller-literario#inscripcion" class="boton-primario hidden whitespace-nowrap !min-h-[44px] !px-5 md:inline-flex">Únete al taller</a>
      <button type="button" id="abrir-menu" class="grid h-11 w-11 place-items-center rounded-full bg-tinta text-fondo xl:hidden" aria-expanded="false" aria-controls="menu-movil" aria-label="Abrir menú">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
      </button>
    </div>
  </div>
</header>

<div id="menu-movil" class="fixed inset-0 z-[55] hidden bg-noche text-white xl:hidden" role="dialog" aria-modal="true" aria-label="Menú">
  <div class="envoltura flex h-full flex-col" style="padding-top: env(safe-area-inset-top, 0px); padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 1.5rem)">
    <div class="flex h-16 items-center justify-between">
      <Logo claro clase="h-10" />
      <button type="button" id="cerrar-menu" class="grid h-11 w-11 place-items-center rounded-full border border-white/20" aria-label="Cerrar menú">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <nav class="mt-4 flex flex-1 flex-col overflow-y-auto" aria-label="Menú móvil">
      {NAV.map((n, i) => (
        <a href={n.href} class="menu-item flex items-baseline justify-between border-b border-white/10 py-3.5 font-display text-[1.5rem] font-bold leading-tight" style={`--i:${i}`}>
          <span>{n.texto}</span><span class="font-sans text-xs text-white/40 numero">{String(i + 1).padStart(2, '0')}</span>
        </a>
      ))}
      <div class="mt-5 grid grid-cols-2 gap-x-4 gap-y-1.5">
        {secundaria.map((n) => <a href={n.href} class="py-1.5 text-[0.95rem] text-white/75 hover:text-white">{n.texto}</a>)}
      </div>
    </nav>
    <div class="grid gap-3 pt-6">
      <a href="/taller-literario#inscripcion" class="boton-primario w-full">Únete al taller · es gratis</a>
      <a href={wa('Hola, Letras y Voces de Tabasco. Quisiera información.')} class="boton-claro w-full" target="_blank" rel="noopener">WhatsApp {CONTACTO.whatsappVisible}</a>
    </div>
  </div>
</div>

<style>
  .js #menu-movil:not(.hidden) .menu-item { animation: sube .6s var(--suave) both; animation-delay: calc(var(--i) * 50ms + 60ms); }
</style>

<script>
  function initEncabezado() {
    const h = document.getElementById('encabezado'); if (!h) return;
    const sombra = () => { const s = window.scrollY > 8; h.classList.toggle('border-linea', s); h.classList.toggle('shadow-suave', s); };
    sombra(); window.addEventListener('scroll', sombra, { passive: true });
    const m = document.getElementById('menu-movil')!, ab = document.getElementById('abrir-menu')!, ce = document.getElementById('cerrar-menu')!;
    const abrir = (v: boolean) => { m.classList.toggle('hidden', !v); ab.setAttribute('aria-expanded', String(v)); document.body.style.overflow = v ? 'hidden' : ''; (v ? ce : ab).focus(); };
    ab.addEventListener('click', () => abrir(true));
    ce.addEventListener('click', () => abrir(false));
    m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => abrir(false)));
    document.querySelectorAll('[data-tema]').forEach((b) => b.addEventListener('click', () => {
      const n = !document.documentElement.classList.contains('modo-nocturno');
      document.documentElement.classList.toggle('modo-nocturno', n);
      try { localStorage.setItem('lvt-theme', n ? 'nocturno' : 'diurno'); } catch {}
    }));
  }
  document.addEventListener('keydown', (e) => { const m = document.getElementById('menu-movil'); if (e.key === 'Escape' && m && !m.classList.contains('hidden')) document.getElementById('cerrar-menu')?.click(); });
  document.addEventListener('astro:page-load', initEncabezado);
</script>
