---
// Hero.astro - Gran Frontispicio Editorial & Pórtico Cinemático LVT (Gestión 2026)
const basePath = "";
---

<section id="inicio" class="relative pt-24 pb-14 sm:pt-32 sm:pb-20 bg-ink-deep text-white overflow-hidden border-b border-paper-border/20">
  
  <!-- 1. CAPAS ATMOSFÉRICAS Y CANVAS AMBIENTAL -->
  <div class="absolute inset-0 pointer-events-none z-0 overflow-hidden">
    
    <!-- Escena 1: Presentación «A corazón abierto» (Casa Cacao y Chocolate) -->
    <div 
      id="hero-bg-1" 
      class="hero-bg-slide absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-25 scale-102 transform"
      style={`background-image: url('${basePath}/assets/galeria/evento_cacao_01.jpg');`}
    ></div>

    <!-- Escena 2: Escuela de Escritores «José Gorostiza» (Conversatorio DACSyH UJAT) -->
    <div 
      id="hero-bg-2" 
      class="hero-bg-slide absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-0 scale-102 transform"
      style={`background-image: url('${basePath}/assets/escuela/galeria/conversatorio_mesa.jpg');`}
    ></div>

    <!-- Escena 3: 38° Aniversario Institucional LVT (Foto Grupal) -->
    <div 
      id="hero-bg-3" 
      class="hero-bg-slide absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-0 scale-102 transform"
      style={`background-image: url('${basePath}/assets/galeria/eventos/aniversario_38_lvt.jpg');`}
    ></div>

    <!-- Escena 4: Presentación «Tardes Tabasqueñas de Ópalos y Topacios» -->
    <div 
      id="hero-bg-4" 
      class="hero-bg-slide absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-0 scale-102 transform"
      style={`background-image: url('${basePath}/assets/galeria/eventos/presentacion_tardes_opalos_grupal.jpg');`}
    ></div>

    <!-- Escena 5: Graduación y Antología de Egresados «Plumas de Ceiba» -->
    <div 
      id="hero-bg-5" 
      class="hero-bg-slide absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-0 scale-102 transform"
      style={`background-image: url('${basePath}/assets/escuela/galeria/plumas_ceiba_expositores_1.jpg');`}
    ></div>

    <!-- Gradientes de Contraste Óptimo -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#0B0A09]/95 via-[#0B0A09]/80 to-[#0B0A09]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-cacao/20 via-transparent to-transparent"></div>
    
    <!-- Resplandor ambiental suave -->
    <div id="hero-mouse-glow" class="absolute w-[500px] h-[500px] bg-cacao/15 rounded-full blur-[100px] transition-all duration-300 pointer-events-none -top-20 -left-20"></div>

    <!-- Marca de Agua Vectorial Institucional -->
    <div class="absolute inset-0 flex items-center justify-center opacity-[0.03] pointer-events-none">
      <img 
        src={`${basePath}/assets/logos/LVT Logo Iso 6 Blanco Relleno.svg`} 
        alt="Sello de Fondo LVT" 
        class="w-[500px] sm:w-[680px] h-auto object-contain select-none" 
      />
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center flex flex-col items-center">
    
    <!-- Neo-Badge de Cristal Editorial con Enlace a Taller LVT-UJAT -->
    <a href={`${basePath}/taller-literario`} class="group inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border border-emerald-500/40 bg-emerald-950/50 text-emerald-200 text-xs sm:text-[13px] font-swiss font-medium tracking-wide mb-5 shadow-lg backdrop-blur-xl hover:border-emerald-400 hover:bg-emerald-900/60 transition duration-200">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span class="text-white font-bold">Taller Literario LVT-UJAT:</span>
      <span class="text-emerald-300">Sábados 9:00 a 11:00 hrs en Librería Universitaria UJAT · Entrada Libre y Gratuita</span>
      <span class="text-xs text-white group-hover:translate-x-0.5 transition-transform">&rarr;</span>
    </a>

    <!-- Título Monumental en Newsreader / EB Garamond -->
    <div class="min-h-[85px] sm:min-h-[110px] md:min-h-[135px] flex items-center justify-center">
      <h1 id="hero-phrase" class="font-monograph text-3xl sm:text-5xl md:text-6xl font-normal text-white max-w-4xl leading-[1.12] tracking-tight transition-all duration-500 drop-shadow-xl">
        Preservamos la palabra,<br />
        <span class="italic font-light bg-gradient-to-r from-[#EF7B38] via-[#F5DEB3] to-[#C59B27] bg-clip-text text-transparent">
          impulsamos la lírica del Sureste.
        </span>
      </h1>
    </div>

    <!-- Subtítulo con Medida Áurea de Lectura -->
    <p class="text-sm sm:text-base md:text-lg font-serif italic text-gray-300 max-w-2xl leading-relaxed mt-3 mb-7">
      «Institución literaria fundada en 1987 para custodiar la creación artística, coordinar ediciones colectivas y proyectar las letras de Tabasco hacia el mundo.»
    </p>

    <!-- Botones de Acción Editorial con Feedback Táctil de 48px -->
    <div class="flex flex-wrap gap-3.5 justify-center w-full max-w-3xl mb-12">
      <a 
        href={`${basePath}/publicaciones`} 
        class="touch-target-48 inline-flex items-center px-7 py-3 rounded-2xl bg-cacao hover:bg-cacao-dark text-white font-swiss text-xs sm:text-sm font-bold uppercase tracking-wider shadow-elevated hover:scale-102 active:scale-95 transition duration-200 gap-2 cursor-pointer border border-cacao-light/20"
      >
        <span>Catálogo Editorial</span>
        <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>

      <a 
        href={`${basePath}/taller-literario`} 
        class="touch-target-48 inline-flex items-center px-6 py-3 rounded-2xl border border-emerald-500/40 bg-emerald-950/40 hover:bg-emerald-900/60 text-emerald-300 font-swiss text-xs sm:text-sm font-bold uppercase tracking-wider backdrop-blur-md shadow-subtle hover:scale-102 active:scale-95 transition duration-200 gap-2 cursor-pointer"
      >
        <span>📖 Taller LVT-UJAT (Gratis)</span>
      </a>

      <a 
        href={`${basePath}/EEJG`} 
        class="touch-target-48 inline-flex items-center px-6 py-3 rounded-2xl border border-white/20 bg-white/[0.06] hover:bg-white/[0.12] text-white font-swiss text-xs sm:text-sm font-bold uppercase tracking-wider backdrop-blur-md shadow-subtle hover:scale-102 active:scale-95 transition duration-200 gap-2 cursor-pointer"
      >
        <span>Escuela de Escritores</span>
      </a>

      <a 
        href={`${basePath}/#rifa`} 
        class="touch-target-48 inline-flex items-center px-6 py-3 rounded-2xl border border-oro/40 bg-oro/15 hover:bg-oro/25 text-oro-bright font-swiss text-xs sm:text-sm font-bold uppercase tracking-wider backdrop-blur-md shadow-subtle hover:scale-102 active:scale-95 transition duration-200 gap-2 cursor-pointer"
      >
        <span>Gran Rifa Cultural 🎟️</span>
      </a>
    </div>

    <!-- HUD de Métricas Institucionales Flotante -->
    <div class="pt-8 border-t border-white/10 grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 w-full max-w-4xl text-center">
      <div class="bg-white/[0.04] py-3.5 px-3 rounded-2xl border border-white/10 backdrop-blur-sm hover:border-cacao/40 transition">
        <span class="block font-monograph text-2xl sm:text-3xl font-bold text-cacao-light">+39</span>
        <span class="text-[10px] sm:text-xs font-swiss font-semibold tracking-wider text-gray-300 uppercase">Años de Historia (1987-2026)</span>
      </div>
      <div class="bg-white/[0.04] py-3.5 px-3 rounded-2xl border border-white/10 backdrop-blur-sm hover:border-oro/40 transition">
        <span class="block font-monograph text-2xl sm:text-3xl font-bold text-white">+100</span>
        <span class="text-[10px] sm:text-xs font-swiss font-semibold tracking-wider text-gray-300 uppercase">Autores en su Historia</span>
      </div>
      <div class="bg-white/[0.04] py-3.5 px-3 rounded-2xl border border-white/10 backdrop-blur-sm hover:border-oro/40 transition">
        <span class="block font-monograph text-2xl sm:text-3xl font-bold text-oro-bright">+25</span>
        <span class="text-[10px] sm:text-xs font-swiss font-semibold tracking-wider text-gray-300 uppercase">Obras Editadas</span>
      </div>
      <div class="bg-white/[0.04] py-3.5 px-3 rounded-2xl border border-white/10 backdrop-blur-sm hover:border-cacao/40 transition">
        <span class="block font-monograph text-2xl sm:text-3xl font-bold text-white">100%</span>
        <span class="text-[10px] sm:text-xs font-swiss font-semibold tracking-wider text-gray-300 uppercase">Autonomía Gremial</span>
      </div>
    </div>

  </div>
</section>

<script>
  // 1. Carrusel de Fondos con Transición Suave de Todas las Escenas
  const bgSlides = Array.from(document.querySelectorAll('.hero-bg-slide'));
  let currentBgIdx = 0;

  if (bgSlides.length > 0) {
    setInterval(() => {
      bgSlides[currentBgIdx]?.classList.remove('opacity-25');
      bgSlides[currentBgIdx]?.classList.add('opacity-0');
      
      currentBgIdx = (currentBgIdx + 1) % bgSlides.length;
      
      bgSlides[currentBgIdx]?.classList.remove('opacity-0');
      bgSlides[currentBgIdx]?.classList.add('opacity-25');
    }, 6000);
  }

  // 2. Rotador Dinámico de Citas Líricas
  const phrases = [
    'Preservamos la palabra,<br><span class="italic font-light bg-gradient-to-r from-[#EF7B38] via-[#F5DEB3] to-[#C59B27] bg-clip-text text-transparent">impulsamos la lírica del Sureste.</span>',
    'Más de 38 años de memoria literaria<br><span class="italic font-light text-oro-bright">e historia colectiva en Tabasco.</span>',
    'Voces que trascienden el trópico:<br><span class="italic font-light text-cacao-light">poesía, narrativa y rigor editorial.</span>',
    'Un espacio independiente de encuentro,<br><span class="italic font-light text-oro-bright">diálogo y creación cultural.</span>'
  ];
  let currentPhraseIdx = 0;
  const phraseEl = document.getElementById('hero-phrase');

  if (phraseEl) {
    setInterval(() => {
      phraseEl.style.opacity = '0';
      phraseEl.style.transform = 'translateY(4px)';
      setTimeout(() => {
        currentPhraseIdx = (currentPhraseIdx + 1) % phrases.length;
        phraseEl.innerHTML = phrases[currentPhraseIdx];
        phraseEl.style.opacity = '1';
        phraseEl.style.transform = 'translateY(0)';
      }, 400);
    }, 5000);
  }

  // 3. Rotador de Anuncios
  const announcements = [
    'XXXIX Aniversario (1987 – 2026) · Sociedad de Escritores LVT, A.C.',
    'En Imprenta: «Animalia Literaria» — Antología 2026',
    'Escuela de Escritores: 10 Diplomados y 7 Cursos Actualizados',
    'Audioteca Lírica: Grabaciones en Audio Nativo MP3',
    'Convocatoria Abierta: Proceso de Afiliación Nuevos Socios LVT'
  ];
  let currentAnnounceIdx = 0;
  const announceEl = document.getElementById('hero-live-announcement');

  if (announceEl) {
    setInterval(() => {
      announceEl.style.opacity = '0';
      setTimeout(() => {
        currentAnnounceIdx = (currentAnnounceIdx + 1) % announcements.length;
        announceEl.innerText = announcements[currentAnnounceIdx];
        announceEl.style.opacity = '1';
      }, 400);
    }, 4500);
  }

  // 4. Spotlight dinámico de cursor
  const glow = document.getElementById('hero-mouse-glow');
  const heroSection = document.getElementById('inicio');

  if (glow && heroSection) {
    heroSection.addEventListener('mousemove', (e) => {
      const rect = heroSection.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      glow.style.transform = `translate(${x - 250}px, ${y - 250}px)`;
    });
  }
</script>
