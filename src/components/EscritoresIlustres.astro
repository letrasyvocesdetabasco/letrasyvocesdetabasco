<script>
  (function initEscritoresIlustres() {
    // 1. CARGAR DATOS
    const datosScript = document.getElementById('datos-ilustres-json');
    if (!datosScript) return;
    const autores = JSON.parse(datosScript.textContent || '[]');

    // 2. REFERENCIAS DE TARJETAS
    const cards = document.querySelectorAll('.canon-card');

    // 3. CANVAS DE PARTÍCULAS SUTILES
    const canvas = document.getElementById('canvas-atmosfera-lvt') as HTMLCanvasElement;
    if (canvas) {
      const ctx = canvas.getContext('2d');
      if (ctx) {
        let width = (canvas.width = canvas.parentElement?.clientWidth || window.innerWidth);
        let height = (canvas.height = canvas.parentElement?.clientHeight || 800);

        window.addEventListener('resize', () => {
          width = canvas.width = canvas.parentElement?.clientWidth || window.innerWidth;
          height = canvas.height = canvas.parentElement?.clientHeight || 800;
        });

        const particles: Array<{x: number; y: number; r: number; dx: number; dy: number; a: number}> = [];
        for (let i = 0; i < 24; i++) {
          particles.push({
            x: Math.random() * width,
            y: Math.random() * height,
            r: Math.random() * 2 + 1,
            dx: (Math.random() - 0.5) * 0.4,
            dy: -Math.random() * 0.5 - 0.1,
            a: Math.random() * 0.4 + 0.1
          });
        }

        let animFrameId: number;
        let isVisible = true;

        const observer = new IntersectionObserver((entries) => {
          isVisible = entries[0].isIntersecting;
          if (isVisible) loop();
          else cancelAnimationFrame(animFrameId);
        });
        observer.observe(canvas);

        function loop() {
          if (!isVisible || !ctx) return;
          ctx.clearRect(0, 0, width, height);

          particles.forEach(p => {
            p.x += p.dx;
            p.y += p.dy;
            if (p.y < 0) p.y = height;
            if (p.x < 0) p.x = width;
            if (p.x > width) p.x = 0;

            ctx.beginPath();
            ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(197, 160, 89, ${p.a})`;
            ctx.fill();
          });

          animFrameId = requestAnimationFrame(loop);
        }
        loop();
      }
    }

    // 4. REPRODUCTOR DE AUDIO AMBIENTAL
    const audioPlayer = document.getElementById('audio-player-global') as HTMLAudioElement;
    const btnPlayToggle = document.getElementById('btn-reproductor-toggle');
    const iconPlay = document.getElementById('icon-play');
    const iconPause = document.getElementById('icon-pause');
    const selectTrack = document.getElementById('select-audio-track') as HTMLSelectElement;
    const trackNameEl = document.getElementById('player-track-name');
    const volumeSlider = document.getElementById('slider-volumen') as HTMLInputElement;
    const visualizer = document.getElementById('visualizer-bars');

    if (audioPlayer && btnPlayToggle && selectTrack) {
      audioPlayer.src = selectTrack.value;
      audioPlayer.volume = parseFloat(volumeSlider?.value || "0.35");

      audioPlayer.addEventListener('play', () => {
        iconPlay?.classList.add('hidden');
        iconPause?.classList.remove('hidden');
        visualizer?.classList.remove('hidden');
        visualizer?.classList.add('flex');

        const currentModalBtn = document.querySelector('.btn-escuchar-autor') as HTMLButtonElement | null;
        if (currentModalBtn) {
          const btnTrack = currentModalBtn.getAttribute('data-audio');
          if (btnTrack && audioPlayer.src.endsWith(btnTrack)) {
            currentModalBtn.innerHTML = '<span>⏸ Pausar reproducción</span>';
          }
        }
      });

      audioPlayer.addEventListener('pause', () => {
        iconPlay?.classList.remove('hidden');
        iconPause?.classList.add('hidden');
        visualizer?.classList.add('hidden');
        visualizer?.classList.remove('flex');

        const currentModalBtn = document.querySelector('.btn-escuchar-autor') as HTMLButtonElement | null;
        if (currentModalBtn) {
          currentModalBtn.innerHTML = '<span>▶ Reproducir esta obra</span>';
        }
      });

      btnPlayToggle.addEventListener('click', () => {
        if (audioPlayer.paused) {
          audioPlayer.play().catch(err => console.log("Audio play error:", err));
        } else {
          audioPlayer.pause();
        }
      });

      selectTrack.addEventListener('change', () => {
        const isPlaying = !audioPlayer.paused;
        audioPlayer.src = selectTrack.value;
        if (trackNameEl) {
          trackNameEl.textContent = selectTrack.options[selectTrack.selectedIndex].text;
        }
        if (isPlaying) {
          audioPlayer.play().catch(err => console.log("Audio play error:", err));
        }
      });

      volumeSlider?.addEventListener('input', () => {
        audioPlayer.volume = parseFloat(volumeSlider.value);
      });

      audioPlayer.addEventListener('ended', () => {
        const nextIndex = (selectTrack.selectedIndex + 1) % selectTrack.options.length;
        selectTrack.selectedIndex = nextIndex;
        audioPlayer.src = selectTrack.value;
        if (trackNameEl) {
          trackNameEl.textContent = selectTrack.options[nextIndex].text;
        }
        audioPlayer.play().catch(err => console.log("Autoplay error:", err));
      });
    }

    // 5. FILTROS DINÁMICOS POR CATEGORÍA Y BÚSQUEDA REACTIVA
    const filterButtons = document.querySelectorAll('.category-btn');
    const searchInput = document.getElementById('input-buscar-ilustres') as HTMLInputElement;
    let activeFilter = 'all';

    function applyFilters() {
      const query = (searchInput?.value || '').toLowerCase().trim();

      cards.forEach(card => {
        const cardEl = card as HTMLElement;
        const category = cardEl.getAttribute('data-category') || '';
        const searchData = cardEl.getAttribute('data-search') || '';

        const matchesFilter = (activeFilter === 'all' || category.includes(activeFilter));
        const matchesQuery = !query || searchData.includes(query);

        if (matchesFilter && matchesQuery) {
          cardEl.style.display = 'flex';
        } else {
          cardEl.style.display = 'none';
        }
      });
    }

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => {
          b.classList.remove('active', 'bg-[#EF7B38]', 'text-white');
          b.classList.add('bg-white', 'text-[#191614]');
        });
        btn.classList.add('active', 'bg-[#EF7B38]', 'text-white');
        btn.classList.remove('bg-white', 'text-[#191614]');

        activeFilter = btn.getAttribute('data-filter') || 'all';
        applyFilters();
      });
    });

    searchInput?.addEventListener('input', applyFilters);

    // 6. MODAL BIOGRÁFICO EXTENSO & VISOR DE COMPENDIO CANÓNICO
    const dialog = document.getElementById('dialog-biografia-ilustre') as HTMLDialogElement;
    const btnCerrar = document.getElementById('btn-cerrar-modal');
    const modalTarget = document.getElementById('modal-content-target');
    const botonesModal = document.querySelectorAll('.btn-abrir-modal');

    const tabBtnSemblanza = document.getElementById('tab-btn-semblanza');
    const tabBtnCompendio = document.getElementById('tab-btn-compendio');
    const viewSemblanza = document.getElementById('view-semblanza');
    const viewCompendio = document.getElementById('view-compendio');
    const compendioRendered = document.getElementById('compendio-rendered-content');
    const readingBox = document.getElementById('compendio-reading-box');
    const fontDec = document.getElementById('compendio-font-dec');
    const fontInc = document.getElementById('compendio-font-inc');

    let currentAutor: any = null;
    let compendioFontSize = 16;
    const btnCerrarMobile = document.querySelector('.btn-cerrar-modal-mobile');

    // Cache en memoria para compendios cargados
    const compendioCache: Record<string, string> = {};

    function renderMarkdownToHtml(md: string): string {
      if (!md) return '';

      const cleanMd = md.replace(/^\uFEFF/, '');
      const escaped = cleanMd
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');

      const lines = escaped.split(/\r?\n/);
      const out: string[] = [];

      let currentP: string[] = [];
      let currentList: 'ul' | 'ol' | null = null;
      let currentQuote: string[] = [];

      function flushP() {
        if (currentP.length > 0) {
          const text = currentP.join('<br/>');
          out.push(`<p class="my-3 leading-relaxed font-serif text-[#2D2926]">${text}</p>`);
          currentP = [];
        }
      }

      function flushQuote() {
        if (currentQuote.length > 0) {
          const text = currentQuote.join('<br/>');
          out.push(`<blockquote class="p-3 my-3 bg-[#FAF7F0] border-l-4 border-[#EF7B38] italic font-serif text-sm text-[#191614] rounded-r-lg">${text}</blockquote>`);
          currentQuote = [];
        }
      }

      let inCodeBlock = false;
      let codeBlockContent: string[] = [];

      function flushList() {
        if (currentList) {
          out.push(currentList === 'ul' ? '</ul>' : '</ol>');
          currentList = null;
        }
      }

      function flushCodeBlock() {
        if (inCodeBlock) {
          out.push(`<pre class="p-3 my-3 bg-[#1C1814] text-[#FAF7F0] rounded-xl overflow-x-auto text-xs font-mono border border-[#383129] leading-relaxed"><code>${codeBlockContent.join('\n')}</code></pre>`);
          codeBlockContent = [];
          inCodeBlock = false;
        }
      }

      function formatInlines(str: string): string {
        return str
          .replace(/\[([^\]]+)\]\((https?:\/\/[^\s\)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer" class="text-[#EF7B38] underline hover:text-[#8F3812] font-semibold">$1</a>')
          .replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold text-[#191614]">$1</strong>')
          .replace(/\*(.*?)\*/g, '<em class="italic">$1</em>')
          .replace(/`([^`]+)`/g, '<code class="px-1.5 py-0.5 rounded bg-[#FAF7F0] border border-[#E3D7C5] font-mono text-xs text-[#EF7B38]">$1</code>');
      }

      for (let i = 0; i < lines.length; i++) {
        const rawLine = lines[i];
        const line = rawLine.trim();

        if (line.startsWith('```')) {
          if (inCodeBlock) {
            flushCodeBlock();
          } else {
            flushP();
            flushQuote();
            flushList();
            inCodeBlock = true;
            codeBlockContent = [];
          }
          continue;
        }

        if (inCodeBlock) {
          codeBlockContent.push(rawLine);
          continue;
        }

        if (!line) {
          flushP();
          flushQuote();
          flushList();
          continue;
        }

        if (/^(_{3,}|-{3,}|\*{3,})$/.test(line)) {
          flushP();
          flushQuote();
          flushList();
          out.push('<hr class="my-6 border-[#E3D7C5]"/>');
          continue;
        }

        // Títulos de compendios depurados sin anglicismos
        if (/^(DOSSIER|COMPENDIO)\s+(DOCUMENTAL|CANÓNICO)/i.test(line)) {
          flushP();
          flushQuote();
          flushList();
          out.push(`<div class="text-xs font-title font-bold uppercase tracking-widest text-[#C5A059] mb-1">COMPENDIO CANÓNICO PATRIMONIAL</div>`);
          continue;
        }
        if (/^AUTOR\s+N[°ºo]?\s+[0-9]+:.*$/i.test(line)) {
          flushP();
          flushQuote();
          flushList();
          const cleanTitle = line.replace(/^AUTOR\s+N[°ºo]?\s+[0-9]+:\s*/i, '');
          out.push(`<h1 class="text-2xl sm:text-3xl font-serif font-black text-[#191614] mt-2 mb-3 pb-2 border-b-2 border-[#C5A059]">${formatInlines(cleanTitle)}</h1>`);
          continue;
        }

        if (/^(SECCIÓN\s+[0-9]+:.*$)/i.test(line)) {
          flushP();
          flushQuote();
          flushList();
          out.push(`<h2 class="text-xl sm:text-2xl font-serif font-black text-[#EF7B38] mt-8 mb-3 pb-1 border-b border-[#EF7B38]/30">${formatInlines(line)}</h2>`);
          continue;
        }

        if (/^([IVXLCDM]+\.\s+.*$)/.test(line)) {
          flushP();
          flushQuote();
          flushList();
          out.push(`<h3 class="text-lg sm:text-xl font-serif font-bold text-[#7A5B1E] mt-6 mb-2">${formatInlines(line)}</h3>`);
          continue;
        }

        if (line.startsWith('# ')) {
          flushP();
          flushQuote();
          flushList();
          out.push(`<h1 class="text-2xl sm:text-3xl font-serif font-black text-[#191614] mt-6 mb-4 pb-2 border-b-2 border-[#C5A059]">${formatInlines(line.slice(2))}</h1>`);
          continue;
        }
        if (line.startsWith('## ')) {
          flushP();
          flushQuote();
          flushList();
          out.push(`<h2 class="text-xl sm:text-2xl font-serif font-black text-[#EF7B38] mt-6 mb-3">${formatInlines(line.slice(3))}</h2>`);
          continue;
        }
        if (line.startsWith('### ')) {
          flushP();
          flushQuote();
          flushList();
          out.push(`<h3 class="text-lg font-serif font-bold text-[#7A5B1E] mt-5 mb-2">${formatInlines(line.slice(4))}</h3>`);
          continue;
        }
        if (line.startsWith('#### ')) {
          flushP();
          flushQuote();
          flushList();
          out.push(`<h4 class="text-base font-serif font-bold text-[#191614] mt-4 mb-1">${formatInlines(line.slice(5))}</h4>`);
          continue;
        }

        if (line.startsWith('&gt; ') || line.startsWith('> ')) {
          flushP();
          flushList();
          const quoteText = line.startsWith('&gt; ') ? line.slice(5) : line.slice(2);
          currentQuote.push(formatInlines(quoteText));
          continue;
        } else {
          flushQuote();
        }

        const ulMatch = line.match(/^[\*\-]\s+(.*)$/);
        if (ulMatch) {
          flushP();
          flushQuote();
          if (currentList !== 'ul') {
            flushList();
            out.push('<ul class="my-3 space-y-1 list-disc pl-5">');
            currentList = 'ul';
          }
          out.push(`<li class="text-sm font-serif text-[#2D2926] my-1">${formatInlines(ulMatch[1])}</li>`);
          continue;
        }

        const olMatch = line.match(/^([0-9]+)\.\s+(.*)$/);
        if (olMatch) {
          flushP();
          flushQuote();
          if (currentList !== 'ol') {
            flushList();
            out.push('<ol class="my-3 space-y-1 list-decimal pl-5">');
            currentList = 'ol';
          }
          out.push(`<li class="text-sm font-serif text-[#2D2926] my-1">${formatInlines(olMatch[2])}</li>`);
          continue;
        }

        flushList();
        currentP.push(formatInlines(line));
      }

      flushP();
      flushQuote();
      flushList();
      flushCodeBlock();

      return out.join('\n');
    }

    function cargarCompendio(slug: string) {
      if (!compendioRendered) return;
      if (compendioCache[slug]) {
        compendioRendered.innerHTML = compendioCache[slug];
        return;
      }

      compendioRendered.innerHTML = '<p class="italic text-center py-8 text-gray-500">Cargando compendio canónico integral...</p>';
      
      const compendioUrl = `/dossiers/${slug}.md`;
      fetch(compendioUrl)
        .then(res => {
          if (!res.ok) throw new Error('No se pudo cargar el compendio');
          return res.text();
        })
        .then(text => {
          const html = renderMarkdownToHtml(text);
          compendioCache[slug] = html;
          const currentSlug = currentAutor ? (currentAutor.dossierSlug || currentAutor.id) : '';
          if (currentSlug === slug) {
            compendioRendered.innerHTML = html;
          }
        })
        .catch(() => {
          const currentSlug = currentAutor ? (currentAutor.dossierSlug || currentAutor.id) : '';
          if (currentSlug === slug) {
            compendioRendered.innerHTML = `
              <div class="p-6 bg-amber-50 text-amber-900 rounded-xl border border-amber-200 text-center">
                <p class="font-bold">Aviso del Consejo Editorial:</p>
                <p class="text-xs mt-1">El texto de este compendio está en proceso de digitalización o actualización patrimonial.</p>
              </div>
            `;
          }
        });
    }

    function switchTab(tab: 'semblanza' | 'compendio') {
      if (tab === 'semblanza') {
        tabBtnSemblanza?.classList.add('bg-[#EF7B38]', 'text-white');
        tabBtnSemblanza?.classList.remove('bg-white', 'text-[#191614]');
        tabBtnCompendio?.classList.remove('bg-[#EF7B38]', 'text-white');
        tabBtnCompendio?.classList.add('bg-white', 'text-[#191614]');
        viewSemblanza?.classList.remove('hidden');
        viewCompendio?.classList.add('hidden');
        viewCompendio?.classList.remove('flex');
      } else {
        tabBtnCompendio?.classList.add('bg-[#EF7B38]', 'text-white');
        tabBtnCompendio?.classList.remove('bg-white', 'text-[#191614]');
        tabBtnSemblanza?.classList.remove('bg-[#EF7B38]', 'text-white');
        tabBtnSemblanza?.classList.add('bg-white', 'text-[#191614]');
        viewSemblanza?.classList.add('hidden');
        viewCompendio?.classList.remove('hidden');
        viewCompendio?.classList.add('flex');
        if (currentAutor) {
          cargarCompendio(currentAutor.dossierSlug || currentAutor.id);
        }
      }
    }

    tabBtnSemblanza?.addEventListener('click', () => switchTab('semblanza'));
    tabBtnCompendio?.addEventListener('click', () => switchTab('compendio'));

    fontDec?.addEventListener('click', () => {
      compendioFontSize = Math.max(14, compendioFontSize - 1);
      if (readingBox) readingBox.style.fontSize = `${compendioFontSize}px`;
    });

    fontInc?.addEventListener('click', () => {
      compendioFontSize = Math.min(24, compendioFontSize + 1);
      if (readingBox) readingBox.style.fontSize = `${compendioFontSize}px`;
    });

    function abrirModalAutor(id: string, initialTab: 'semblanza' | 'compendio' = 'semblanza') {
      const autor = autores.find((a: any) => a.id === id);
      if (!autor || !modalTarget || !dialog) return;

      currentAutor = autor;
      const bloqueEtiqueta = autor.bloqueCanon === 'tabasquenos' 
        ? '🌴 Voces de Tabasco' 
        : autor.bloqueCanon === 'mexicanos' 
          ? '🦅 Letras de México' 
          : '🌍 Horizonte Internacional';

      modalTarget.innerHTML = `
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          
          <!-- Columna Izquierda: Retrato y Ficha Técnica -->
          <div class="lg:col-span-4 space-y-4">
            <div class="rounded-2xl overflow-hidden border-2 border-[#C5A059] bg-[#FAF7F0] shadow-md aspect-[4/5]">
              <img 
                src="${autor.foto}" 
                alt="${autor.nombre}" 
                class="w-full h-full object-cover object-top"
                onerror="this.onerror=null; this.src='${autor.fotoFallback || autor.foto}';"
              />
            </div>
            
            <div class="bg-white p-4 rounded-xl border border-[#E3D7C5] shadow-xs text-xs space-y-2">
              <p><strong>Nacimiento:</strong> ${autor.nacimiento}</p>
              <p><strong>Fallecimiento:</strong> ${autor.fallecimiento}</p>
              <p><strong>Origen:</strong> ${autor.municipioOrigen}</p>
              <p><strong>Movimiento:</strong> ${autor.movimiento}</p>
              <p><strong>Ámbito:</strong> ${bloqueEtiqueta}</p>
            </div>

            <!-- Pista recomendada de este autor -->
            <div class="bg-[#FAF7F0] p-4 rounded-xl border border-[#C5A059]/50 text-xs">
              <p class="font-title font-bold text-[#7A5B1E] uppercase tracking-wider text-[10px] mb-1">
                Música recomendada para su lectura:
              </p>
              <p class="font-serif font-bold text-[#191614]">${autor.audioSugerido.titulo}</p>
              <p class="text-[11px] text-[#7A7268]">${autor.audioSugerido.compositor}</p>
              <button 
                type="button" 
                class="btn-escuchar-autor min-h-[44px] mt-2.5 w-full py-2 px-3 rounded-xl bg-[#EF7B38] hover:bg-[#8F3812] text-white text-xs font-title font-bold transition flex items-center justify-center gap-1.5 cursor-pointer"
                data-audio="${autor.audioSugerido.archivo}"
                data-name="${autor.audioSugerido.titulo}"
              >
                <span>▶ Reproducir esta obra</span>
              </button>
            </div>

            <!-- Botón rápido al compendio -->
            <button 
              type="button" 
              class="btn-ir-a-compendio min-h-[44px] w-full py-2.5 px-4 rounded-xl bg-[#191614] hover:bg-[#EF7B38] text-white text-xs font-title font-bold transition flex items-center justify-center gap-2 cursor-pointer shadow-sm"
            >
              <span>📖 Leer Compendio Canónico</span>
            </button>
          </div>

          <!-- Columna Derecha: Biografía Extensa, Obras y Citas -->
          <div class="lg:col-span-8 space-y-6">
            <div>
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[10px] font-title font-bold uppercase tracking-wider bg-[#EF7B38]/10 text-[#EF7B38] mb-2 border border-[#EF7B38]/20">
                ${bloqueEtiqueta} · ${autor.badge}
              </div>
              <h2 class="text-3xl sm:text-4xl font-serif font-black text-[#191614]">${autor.nombre}</h2>
              <p class="text-sm font-serif italic text-[#7A5B1E] font-semibold mt-1">«${autor.tituloHonorifico}»</p>
            </div>

            <!-- Párrafos de Biografía Extensa -->
            <div class="prose prose-sm font-serif text-[#2D2926] leading-relaxed space-y-3.5 border-t border-[#E3D7C5] pt-4">
              ${autor.biografiaCompleta.map((p: string) => `<p>${p}</p>`).join('')}
            </div>

            <!-- Legado Patrimonial -->
            <div class="p-4 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-xs">
              <p class="font-title font-bold text-amber-900 uppercase tracking-widest text-[10px] mb-1">🏛️ Legado para Tabasco y las Letras Universales</p>
              <p class="font-serif italic text-[#2D2926] leading-relaxed">${autor.legadoPatrimonial}</p>
            </div>

            <!-- Obras Capitales Detalladas -->
            <div class="space-y-3">
              <h3 class="font-title font-bold text-xs uppercase tracking-widest text-[#191614]">📚 Obras Capitales & Bibliografía</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                ${autor.obrasCapitales.map((obra: any) => `
                  <div class="p-3 bg-white rounded-xl border border-[#E3D7C5] shadow-xs">
                    <div class="flex items-center justify-between gap-1 mb-1">
                      <span class="font-serif font-bold text-xs text-[#191614]">${obra.titulo}</span>
                      <span class="text-[10px] font-mono font-bold text-[#EF7B38]">${obra.anio}</span>
                    </div>
                    <p class="text-[10px] font-title text-[#7A5B1E] font-semibold uppercase">${obra.genero}</p>
                    <p class="text-[11px] font-sans text-[#4A443E] mt-1 line-clamp-2">${obra.descripcion}</p>
                  </div>
                `).join('')}
              </div>
            </div>

            <!-- Citas Célebres -->
            <div class="space-y-3">
              <h3 class="font-title font-bold text-xs uppercase tracking-widest text-[#191614]">💬 Citas Textuales Célebres</h3>
              <div class="space-y-2">
                ${autor.citasMemorables.map((c: any) => `
                  <div class="p-3.5 bg-white rounded-xl border-l-2 border-[#EF7B38] border-r border-t border-b border-[#E3D7C5] shadow-xs">
                    <p class="font-serif italic text-xs text-[#191614]">«${c.cita}»</p>
                    <p class="text-[10px] text-[#7A7268] font-title font-bold mt-1 text-right">— ${c.obra}</p>
                  </div>
                `).join('')}
              </div>
            </div>

            <!-- Datos Biográficos Curiosos -->
            <div class="space-y-2">
              <h3 class="font-title font-bold text-xs uppercase tracking-widest text-[#191614]">💡 Datos Biográficos Relevantes</h3>
              <ul class="list-disc pl-5 space-y-1 text-xs font-sans text-[#4A443E]">
                ${autor.datosCuriosos.map((d: string) => `<li>${d}</li>`).join('')}
              </ul>
            </div>

          </div>

        </div>
      `;

      const btnEscuchar = modalTarget.querySelector('.btn-escuchar-autor') as HTMLButtonElement;
      if (btnEscuchar && audioPlayer && !audioPlayer.paused) {
        const initialTrack = btnEscuchar.getAttribute('data-audio');
        if (initialTrack && audioPlayer.src.endsWith(initialTrack)) {
          btnEscuchar.innerHTML = '<span>⏸ Pausar reproducción</span>';
        }
      }

      btnEscuchar?.addEventListener('click', () => {
        const trackUrl = btnEscuchar.getAttribute('data-audio');
        const trackTitle = btnEscuchar.getAttribute('data-name');
        if (audioPlayer && trackUrl) {
          if (audioPlayer.src.endsWith(trackUrl) && !audioPlayer.paused) {
            audioPlayer.pause();
          } else {
            audioPlayer.src = trackUrl;
            if (trackNameEl) trackNameEl.textContent = trackTitle || 'Pista de Autor';
            for (let i = 0; i < selectTrack.options.length; i++) {
              if (selectTrack.options[i].value === trackUrl) {
                selectTrack.selectedIndex = i;
                break;
              }
            }
            audioPlayer.play().catch(e => console.log(e));
          }
        }
      });

      const btnIrCompendio = modalTarget.querySelector('.btn-ir-a-compendio');
      btnIrCompendio?.addEventListener('click', () => {
        switchTab('compendio');
      });

      switchTab(initialTab === 'compendio' ? 'compendio' : 'semblanza');

      const modalBox = dialog.querySelector('.custom-scrollbar');
      if (modalBox) modalBox.scrollTop = 0;
      if (readingBox) readingBox.scrollTop = 0;

      lastFocusedElement = document.activeElement as HTMLElement;
      document.body.style.overflow = 'hidden';
      dialog.showModal();
    }

    let lastFocusedElement: HTMLElement | null = null;

    botonesModal.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = btn.getAttribute('data-autor-id');
        const initialTab = (btn.getAttribute('data-tab') || 'semblanza') as 'semblanza' | 'compendio';
        if (id) abrirModalAutor(id, initialTab);
      });
    });

    cards.forEach(card => {
      card.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('button') || target.closest('a')) return;
        const id = card.getAttribute('data-id');
        if (id) abrirModalAutor(id, 'semblanza');
      });
    });

    function cerrarModal() {
      if (dialog && dialog.open) {
        dialog.close();
      }
    }

    btnCerrar?.addEventListener('click', cerrarModal);
    btnCerrarMobile?.addEventListener('click', cerrarModal);

    dialog?.addEventListener('close', () => {
      document.body.style.overflow = '';
      if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
        lastFocusedElement.focus();
        lastFocusedElement = null;
      }
    });

    if (!('closedBy' in HTMLDialogElement.prototype)) {
      dialog?.addEventListener('click', (event) => {
        if (event.target !== dialog) return;
        const innerContainer = dialog.firstElementChild as HTMLElement;
        const rect = (innerContainer || dialog).getBoundingClientRect();
        const isContent = (
          rect.top <= event.clientY &&
          event.clientY <= rect.bottom &&
          rect.left <= event.clientX &&
          event.clientX <= rect.right
        );
        if (!isContent) {
          cerrarModal();
        }
      });
    }

    // 7. BOTÓN COPIAR CITA
    const toast = document.getElementById('toast-copia');
    const botonesCopiar = document.querySelectorAll('.btn-copiar-cita');

    botonesCopiar.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const cita = btn.getAttribute('data-cita');
        if (!cita) return;

        function mostrarToast() {
          if (toast) {
            toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
            toast.classList.add('translate-y-0', 'opacity-100');
            setTimeout(() => {
              toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
              toast.classList.remove('translate-y-0', 'opacity-100');
            }, 2500);
          }
        }

        if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
          navigator.clipboard.writeText(cita)
            .then(mostrarToast)
            .catch(() => {
              try {
                const ta = document.createElement('textarea');
                ta.value = cita;
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
                mostrarToast();
              } catch (err) {}
            });
        } else {
          try {
            const ta = document.createElement('textarea');
            ta.value = cita;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            mostrarToast();
          } catch (err) {}
        }
      });
    });

  })();
</script>
