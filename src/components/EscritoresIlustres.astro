---
// src/components/EscritoresIlustres.astro
// Canon Literario de 30 Autores & Galería Tridimensional
// Sociedad de Escritores «Letras y Voces de Tabasco, A.C.»
import { ESCRITORES_ILUSTRES } from '../data/escritores_ilustres';

interface Props {
  mostrarPabellonCompleto?: boolean;
  tituloSeccion?: string;
  subtituloSeccion?: string;
}

const {
  mostrarPabellonCompleto = true,
  tituloSeccion = "Panteón Canónico de Escritores Ilustres",
  subtituloSeccion = "Los grandes arquitectos de la palabra que definieron la identidad lírica, narrativa y el pensamiento universal. Treinta monografías exhaustivas con textos íntegros y archivo patrimonial."
} = Astro.props;

const basePath = "";
---

<section id="escritores-ilustres" class="relative py-20 bg-[#FAF7F0] overflow-hidden border-b border-[#E3D7C5]">
  <!-- 1. Fondo de Partículas Sutiles / Atmósfera Fluvial Flotante (Ultra-ligero, 0 dependencias) -->
  <canvas id="canvas-atmosfera-lvt" class="absolute inset-0 pointer-events-none opacity-40 z-0"></canvas>

  <!-- Decoración perimetral dorada de inspiración bibliófila -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-px bg-gradient-to-r from-transparent via-[#C5A059]/40 to-transparent"></div>
  <div class="absolute -top-24 -right-24 w-96 h-96 bg-[#EF7B38]/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-[#C5A059]/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 z-10">
    
    <!-- CABECERA PRINCIPAL -->
    <div class="text-center max-w-4xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-[#EF7B38]/10 text-[#EF7B38] text-[11px] sm:text-xs font-title font-extrabold uppercase tracking-widest border border-[#EF7B38]/20 shadow-xs mb-4">
        <span class="w-2 h-2 rounded-full bg-[#EF7B38] animate-pulse"></span>
        <span>Canon Literario de 30 Autores · Colección Patrimonial LVT</span>
      </div>
      
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-black text-[#191614] tracking-tight leading-tight">
        Panteón Canónico de 
        <span class="relative inline-block text-transparent bg-clip-text bg-gradient-to-r from-[#EF7B38] via-[#C5A059] to-[#8F3812]">
          Escritores Ilustres
          <svg class="absolute -bottom-1.5 left-0 w-full h-2 text-[#EF7B38]/30" viewBox="0 0 100 20" preserveAspectRatio="none">
            <path d="M0 10 Q 50 20, 100 10" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
          </svg>
        </span>
      </h2>
      
      <p class="mt-4 text-base sm:text-lg font-serif italic text-[#4A443E] leading-relaxed max-w-3xl mx-auto">
        {subtituloSeccion}
      </p>

      <!-- Divisor simétrico estilo libro clásico -->
      <div class="flex items-center justify-center gap-3 mt-6">
        <div class="w-16 h-px bg-[#C5A059]"></div>
        <span class="text-[#C5A059] text-xs font-title font-bold tracking-widest">🏛️ · 30 AUTORES · 📜</span>
        <div class="w-16 h-px bg-[#C5A059]"></div>
      </div>
    </div>

    <!-- BANNER MAESTRO DE DESCARGA DEL CANON COMPLETO EN ZIP -->
    <div class="max-w-4xl mx-auto mb-10 bg-gradient-to-r from-[#191614] via-[#2D2620] to-[#191614] rounded-2xl p-5 sm:p-6 border border-[#C5A059]/40 shadow-xl text-white flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3.5 text-left">
        <div class="w-12 h-12 rounded-xl bg-[#EF7B38]/20 border border-[#EF7B38]/40 flex items-center justify-center text-2xl shrink-0">
          📦
        </div>
        <div>
          <h3 class="text-sm sm:text-base font-serif font-black text-[#F6F0E2]">
            Canon Literario Completo en un Solo Archivo (ZIP)
          </h3>
          <p class="text-[11px] sm:text-xs text-gray-300 font-sans mt-0.5">
            Descargue las 30 monografías críticas íntegras (162,135 palabras), fichas de metadatos y retratos históricos normalizados.
          </p>
        </div>
      </div>

      <a 
        href="/descargas/LVT_CANON_LITERARIO_30_AUTORES.zip" 
        download="LVT_CANON_LITERARIO_30_AUTORES.zip"
        class="shrink-0 px-5 py-2.5 rounded-xl bg-[#EF7B38] hover:bg-[#8F3812] text-white text-xs font-title font-bold tracking-wider uppercase transition shadow-md hover:shadow-lg flex items-center gap-2 cursor-pointer active:scale-95"
      >
        <span>📥 Descargar ZIP (6.1 MB)</span>
      </a>
    </div>

    <!-- REPRODUCTOR SONORO AMBIENTAL DE ALTA FIDELIDAD -->
    <div class="max-w-4xl mx-auto mb-10 bg-white/90 backdrop-blur-md rounded-2xl p-4 sm:p-5 border border-[#E3D7C5] shadow-elevated flex flex-col md:flex-row items-center justify-between gap-4 transition-all duration-300 hover:border-[#C5A059]">
      <div class="flex items-center gap-4 w-full md:w-auto">
        <button 
          type="button" 
          id="btn-reproductor-toggle" 
          class="w-12 h-12 rounded-xl bg-gradient-to-br from-[#EF7B38] to-[#8F3812] hover:brightness-110 text-white flex items-center justify-center shrink-0 shadow-md transition-transform duration-200 active:scale-95 cursor-pointer"
          aria-label="Reproducir música ambiental"
        >
          <svg id="icon-play" class="w-6 h-6 ml-0.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
          <svg id="icon-pause" class="w-6 h-6 hidden" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
          </svg>
        </button>

        <div class="text-left">
          <div class="flex items-center gap-2">
            <span class="text-[10px] font-title font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-[#C5A059]/15 text-[#7A5B1E]">
              Atmósfera Sonora
            </span>
            <div id="visualizer-bars" class="hidden flex items-end gap-1 h-3.5">
              <span class="w-0.5 bg-[#EF7B38] h-3 animate-pulse"></span>
              <span class="w-0.5 bg-[#C5A059] h-2 animate-bounce"></span>
              <span class="w-0.5 bg-[#EF7B38] h-3.5 animate-pulse"></span>
              <span class="w-0.5 bg-[#C5A059] h-1.5 animate-bounce"></span>
            </div>
          </div>
          <p id="player-track-name" class="text-xs sm:text-sm font-serif font-bold text-[#191614] truncate max-w-[240px] sm:max-w-xs">
            Claude Debussy — Claro de Luna
          </p>
          <p class="text-[11px] text-[#7A7268] font-sans">
            Música clásica y grabaciones patrimoniales en alta fidelidad
          </p>
        </div>
      </div>

      <!-- Selector de Pista y Volumen -->
      <div class="flex items-center justify-end gap-3 w-full md:w-auto">
        <select 
          id="select-audio-track" 
          class="text-xs font-title font-bold bg-[#FAF7F0] border border-[#E3D7C5] rounded-xl px-3 py-2 text-[#191614] focus:outline-none focus:border-[#EF7B38] cursor-pointer"
        >
          <option value="/assets/audio/debussy_clair_de_lune.mp3">🎹 Claude Debussy — Claro de Luna</option>
          <option value="/assets/audio/chopin_nocturne_op9.mp3">🎹 Frédéric Chopin — Nocturno Op. 9</option>
          <option value="/assets/audio/satie_gymnopedie_1.mp3">🎹 Erik Satie — Gymnopédie No. 1</option>
          <option value="/assets/audio/beethoven_moonlight_sonata.mp3">🎹 L.V. Beethoven — Sonata Claro de Luna</option>
          <option value="/assets/audio/bach_air_on_g_string.mp3">🎻 J.S. Bach — Aire en Sol</option>
          <option value="/assets/audios/cortazar_angeles.mp3">🎙️ Julio Cortázar — Voz Original</option>
          <option value="/assets/audios/rulfo_hidrante.mp3">🎙️ Juan Rulfo — Grabación Histórica</option>
          <option value="/assets/audios/sabines_cuerpo.mp3">🎙️ Jaime Sabines — Poema Lírico</option>
          <option value="/assets/audio/marimba_tabasquena_acustica.mp3">🎶 Marimba Tabasqueña Tradicional</option>
          <option value="/assets/audio/guitarra_poetica_suave.mp3">🎸 Guitarra Poética de Cuerdas</option>
        </select>

        <div class="flex items-center gap-1.5 text-xs text-[#7A7268]">
          <svg class="w-4 h-4 text-[#7A5B1E]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
          </svg>
          <input 
            type="range" 
            id="slider-volumen" 
            min="0" 
            max="1" 
            step="0.05" 
            value="0.35" 
            class="w-16 sm:w-20 accent-[#EF7B38] cursor-pointer" 
            title="Volumen"
          />
        </div>
      </div>
      <audio id="audio-player-global" preload="none"></audio>
    </div>

    <!-- CONTROLES: FILTROS POR BLOQUE CANÓNICO Y BUSCADOR REACTIVO -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 mb-10">
      
      <!-- Filtros por Bloque Canónico -->
      <div class="flex flex-wrap justify-center gap-2" id="filter-container">
        <button type="button" class="category-btn active px-4 py-2 rounded-xl text-xs font-title font-bold uppercase tracking-wider bg-[#EF7B38] text-white shadow-sm transition cursor-pointer" data-filter="all">
          Todos ({ESCRITORES_ILUSTRES.length})
        </button>
        <button type="button" class="category-btn px-4 py-2 rounded-xl text-xs font-title font-bold uppercase tracking-wider bg-white text-[#191614] border border-[#E3D7C5] hover:border-[#EF7B38] hover:text-[#EF7B38] transition cursor-pointer shadow-subtle" data-filter="tabasquenos">
          🌴 Tabasqueños (12)
        </button>
        <button type="button" class="category-btn px-4 py-2 rounded-xl text-xs font-title font-bold uppercase tracking-wider bg-white text-[#191614] border border-[#E3D7C5] hover:border-[#EF7B38] hover:text-[#EF7B38] transition cursor-pointer shadow-subtle" data-filter="mexicanos">
          🦅 Grandes de México (10)
        </button>
        <button type="button" class="category-btn px-4 py-2 rounded-xl text-xs font-title font-bold uppercase tracking-wider bg-white text-[#191614] border border-[#E3D7C5] hover:border-[#EF7B38] hover:text-[#EF7B38] transition cursor-pointer shadow-subtle" data-filter="universales">
          🌍 Universales (8)
        </button>
      </div>

      <!-- Buscador dinámico -->
      <div class="relative w-full md:w-80">
        <input 
          type="text" 
          id="input-buscar-ilustres" 
          placeholder="Buscar autor, obra, verso o región..." 
          class="w-full pl-10 pr-4 py-2.5 text-xs font-sans rounded-xl bg-white border border-[#E3D7C5] text-[#191614] placeholder-gray-400 focus:outline-none focus:border-[#EF7B38] focus:ring-1 focus:ring-[#EF7B38] shadow-subtle transition"
        />
        <svg class="w-4 h-4 text-[#7A5B1E] absolute left-3.5 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

    </div>

    <!-- CUADRÍCULA 3D DE TARJETAS DE ESCRITORES ILUSTRES -->
    <div id="grid-escritores" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 perspective-1000">
      {ESCRITORES_ILUSTRES.map((autor) => {
        const primeraCita = autor.citasMemorables[0] || { cita: 'La palabra viva perdura.', obra: 'Acervo' };
        const bloqueEtiqueta = autor.bloqueCanon === 'tabasquenos' ? '🌴 Tabasco' : autor.bloqueCanon === 'mexicanos' ? '🦅 México' : '🌍 Universal';
        return (
          <article 
            class="card-3d group relative bg-white rounded-3xl border border-[#E3D7C5] shadow-elevated p-6 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:border-[#EF7B38] hover:shadow-2xl cursor-pointer"
            data-category={`${autor.bloqueCanon} ${autor.categoria}`}
            data-search={`${autor.nombre.toLowerCase()} ${autor.tituloHonorifico.toLowerCase()} ${autor.municipioOrigen.toLowerCase()} ${autor.bloqueCanon} ${autor.obrasCapitales.map(o => o.titulo.toLowerCase()).join(' ')} ${primeraCita.cita.toLowerCase()}`}
            data-id={autor.id}
          >
            <!-- Brillo especular dinámico que sigue el cursor -->
            <div class="card-shine absolute inset-0 pointer-events-none rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

            <!-- Cabecera de la tarjeta con Retrato y Badge -->
            <div>
              <div class="flex items-center justify-between gap-2 mb-4">
                <span class="px-3 py-1 rounded-full text-[10px] font-title font-extrabold uppercase tracking-wider bg-[#FAF7F0] text-[#7A5B1E] border border-[#E3D7C5]">
                  {bloqueEtiqueta} · {autor.badge}
                </span>
                <span class="text-[11px] font-mono font-bold text-[#7A7268]">
                  ⏱️ {autor.tiempoLecturaMinutos || 30}m · {autor.anios}
                </span>
              </div>

              <!-- Retrato con Marco Editorial y Efecto Profundidad 3D -->
              <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden bg-[#FAF7F0] border border-[#E3D7C5] mb-5 shadow-subtle group-hover:scale-[1.02] transition-transform duration-500">
                <img 
                  src={`${basePath}${autor.foto}`} 
                  alt={autor.nombre} 
                  class="w-full h-full object-cover object-center"
                  loading="lazy"
                  onerror={`this.onerror=null; this.src='${basePath}${autor.fotoFallback}'`}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/10 to-transparent"></div>
                <div class="absolute bottom-2.5 left-3 right-3 text-white">
                  <p class="text-[11px] font-sans uppercase tracking-widest text-[#F6F0E2] opacity-90 truncate">
                    📍 {autor.municipioOrigen}
                  </p>
                </div>
              </div>

              <!-- Título y Nombre -->
              <h3 class="text-xl sm:text-2xl font-serif font-black text-[#191614] group-hover:text-[#EF7B38] transition-colors line-clamp-1">
                {autor.nombre}
              </h3>
              
              <p class="text-xs font-serif italic text-[#7A5B1E] mt-1 line-clamp-1 font-semibold">
                «{autor.tituloHonorifico}»
              </p>

              <!-- Cita emblemática resaltada -->
              <div class="mt-4 p-3.5 rounded-xl bg-[#FAF7F0] border-l-2 border-[#EF7B38] border-r border-t border-b border-[#E3D7C5]/50">
                <p class="text-xs font-serif italic text-[#222222] line-clamp-3 leading-relaxed">
                  «{primeraCita.cita}»
                </p>
                <div class="mt-2 flex items-center justify-between text-[10px] text-[#7A7268] font-sans">
                  <span class="truncate max-w-[170px] font-bold">— {primeraCita.obra}</span>
                  <button 
                    type="button" 
                    class="btn-copiar-cita text-[#EF7B38] hover:text-[#8F3812] font-bold transition flex items-center gap-1 cursor-pointer"
                    data-cita={`«${primeraCita.cita}» — ${autor.nombre}, ${primeraCita.obra}. Compartido desde letrasyvocesdetabasco.org`}
                    title="Copiar cita para compartir"
                  >
                    <span>Copiar</span>
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                  </button>
                </div>
              </div>

              <!-- Lista condensada de obras capitales -->
              <div class="mt-4 space-y-1.5">
                <p class="text-[10px] font-title font-bold uppercase tracking-widest text-[#7A7268]">
                  Obras Representativas:
                </p>
                <div class="flex flex-wrap gap-1.5">
                  {autor.obrasCapitales.slice(0, 3).map(obra => (
                    <span class="inline-block px-2 py-0.5 rounded-md bg-white border border-[#E3D7C5] text-[10px] font-sans text-[#4A443E]">
                      📖 {obra.titulo} ({obra.anio})
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <!-- Botones de Acción Dual: Semblanza o Lectura de Dossier -->
            <div class="mt-6 pt-4 border-t border-[#E3D7C5]/70 flex items-center justify-between gap-2">
              <button 
                type="button" 
                class="btn-abrir-modal w-1/2 py-2.5 rounded-xl bg-[#FAF7F0] hover:bg-[#F2ECE1] text-[#191614] border border-[#E3D7C5] text-[11px] font-title font-bold uppercase tracking-wider transition flex items-center justify-center gap-1 shadow-xs cursor-pointer active:scale-95"
                data-autor-id={autor.id}
                data-tab="semblanza"
              >
                <span>🔍 Semblanza</span>
              </button>

              <button 
                type="button" 
                class="btn-abrir-modal w-1/2 py-2.5 rounded-xl bg-[#191614] hover:bg-[#EF7B38] text-white text-[11px] font-title font-bold uppercase tracking-wider transition flex items-center justify-center gap-1 shadow-sm cursor-pointer active:scale-95"
                data-autor-id={autor.id}
                data-tab="dossier"
              >
                <span>📖 Leer Dossier</span>
              </button>
            </div>

          </article>
        );
      })}
    </div>

  </div>

  <!-- 2. MODAL BIOGRÁFICO & VISOR INTEGRAL DE DOSSIER CANÓNICO -->
  <dialog 
    id="dialog-biografia-ilustre" 
    class="backdrop:bg-black/75 backdrop:backdrop-blur-md bg-transparent p-2 sm:p-4 max-w-5xl w-full mx-auto my-auto rounded-3xl border-0 overflow-visible focus:outline-none"
  >
    <div class="relative bg-[#FAF7F0] rounded-3xl border-2 border-[#C5A059] shadow-2xl p-5 sm:p-8 max-h-[92vh] overflow-y-auto custom-scrollbar text-[#191614] flex flex-col">
      
      <!-- Barra Superior de Control del Modal -->
      <div class="flex items-center justify-between border-b border-[#E3D7C5] pb-4 mb-6">
        <!-- Pestañas de Navegación del Modal -->
        <div class="flex items-center gap-2">
          <button 
            type="button" 
            id="tab-btn-semblanza" 
            class="px-3.5 py-1.5 rounded-xl text-xs font-title font-bold uppercase tracking-wider bg-[#EF7B38] text-white shadow-xs transition cursor-pointer"
          >
            📜 Semblanza & Obras
          </button>
          <button 
            type="button" 
            id="tab-btn-dossier" 
            class="px-3.5 py-1.5 rounded-xl text-xs font-title font-bold uppercase tracking-wider bg-white text-[#191614] border border-[#E3D7C5] hover:border-[#EF7B38] hover:text-[#EF7B38] transition cursor-pointer"
          >
            📖 Dossier Canónico Completo
          </button>
        </div>

        <!-- Botón de Cerrar Modal -->
        <button 
          type="button" 
          id="btn-cerrar-modal" 
          class="w-9 h-9 rounded-full bg-[#191614] hover:bg-[#EF7B38] text-white flex items-center justify-center transition-colors shadow-md cursor-pointer shrink-0 ml-3"
          aria-label="Cerrar ventana"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Vista 1: Semblanza Biográfica y Obras -->
      <div id="view-semblanza" class="space-y-6">
        <div id="modal-content-target">
          <!-- Rellenado por JavaScript con los datos de ESCRITORES_ILUSTRES -->
        </div>
      </div>

      <!-- Vista 2: Lector Inmersivo de Dossier Canónico Completo -->
      <div id="view-dossier" class="hidden flex-col space-y-4">
        
        <!-- Barra de herramientas del lector de texto -->
        <div class="flex flex-wrap items-center justify-between gap-3 p-3 bg-white rounded-xl border border-[#E3D7C5]">
          <div class="flex items-center gap-2">
            <span class="text-[11px] font-title font-bold uppercase tracking-wider text-[#7A5B1E]">
              Tamaño de Fuente:
            </span>
            <button type="button" id="dossier-font-dec" class="w-7 h-7 rounded-lg bg-[#FAF7F0] border border-[#E3D7C5] font-bold text-xs hover:bg-[#EF7B38] hover:text-white transition">A-</button>
            <button type="button" id="dossier-font-inc" class="w-7 h-7 rounded-lg bg-[#FAF7F0] border border-[#E3D7C5] font-bold text-xs hover:bg-[#EF7B38] hover:text-white transition">A+</button>
          </div>

          <div class="flex items-center gap-2">
            <a 
              id="btn-descargar-dossier-md" 
              href="#" 
              download 
              class="px-3 py-1.5 rounded-lg bg-[#FAF7F0] hover:bg-[#EF7B38] hover:text-white text-[#191614] border border-[#E3D7C5] text-xs font-title font-bold transition flex items-center gap-1.5"
            >
              <span>📥 Descargar Archivo (.md)</span>
            </a>
          </div>
        </div>

        <!-- Contenedor del texto del Dossier -->
        <div 
          id="dossier-reading-box" 
          class="p-6 sm:p-10 bg-white rounded-2xl border border-[#E3D7C5] shadow-xs max-h-[65vh] overflow-y-auto custom-scrollbar font-serif text-base leading-relaxed text-[#191614]"
        >
          <div id="dossier-rendered-content" class="space-y-4 max-w-3xl mx-auto">
            <p class="italic text-center py-8 text-gray-500">Cargando texto canónico integral...</p>
          </div>
        </div>

      </div>

    </div>
  </dialog>

  <!-- TOAST DE CONFIRMACIÓN AL COPIAR CITA -->
  <div 
    id="toast-copia" 
