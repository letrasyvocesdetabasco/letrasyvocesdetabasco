<script>
  (function initEscritoresIlustres() {
    // 1. CARGAR DATOS
    const datosScript = document.getElementById('datos-ilustres-json');
    if (!datosScript) return;
    const autores = JSON.parse(datosScript.textContent || '[]');

    // 2. FÍSICAS 3D Y EFECTO BRILLO ESPECULAR
    const cards = document.querySelectorAll('.card-3d');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!prefersReducedMotion) {
      cards.forEach(card => {
        const cardEl = card as HTMLElement;
        const shine = cardEl.querySelector('.card-shine') as HTMLElement;

        cardEl.addEventListener('mousemove', (e) => {
          const rect = cardEl.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;

          const centerX = rect.width / 2;
          const centerY = rect.height / 2;
          
          const rotateX = ((y - centerY) / centerY) * -5;
          const rotateY = ((x - centerX) / centerX) * 5;

          cardEl.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.01, 1.01, 1.01)`;
          
          if (shine) {
            shine.style.setProperty('--mouse-x', `${(x / rect.width) * 100}%`);
            shine.style.setProperty('--mouse-y', `${(y / rect.height) * 100}%`);
          }
        });

        cardEl.addEventListener('mouseleave', () => {
          cardEl.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
        });
      });
    }

    // 3. CANVAS DE PARTÍCULAS SUTILES
    const canvas = document.getElementById('canvas-atmosfera-lvt') as HTMLCanvasElement;
    if (canvas) {
      const ctx = canvas.getContext('2d');
      if (ctx) {
        let width = (canvas.width = canvas.parentElement?.clientWidth || window.innerWidth);
        let height = (canvas.height = canvas.parentElement?.clientHeight || 800);

        window.addEventListener('resize', () => {
          width = canvas.width = canvas.parentElement?.clientWidth || window.innerWidth;
          height = canvas.height = canvas.parentElement?.clientHeight || 800;
        });

        const particles: Array<{x: number; y: number; r: number; dx: number; dy: number; a: number}> = [];
        for (let i = 0; i < 24; i++) {
          particles.push({
            x: Math.random() * width,
            y: Math.random() * height,
            r: Math.random() * 2 + 1,
            dx: (Math.random() - 0.5) * 0.4,
            dy: -Math.random() * 0.5 - 0.1,
            a: Math.random() * 0.4 + 0.1
          });
        }

        let animFrameId: number;
        let isVisible = true;

        const observer = new IntersectionObserver((entries) => {
          isVisible = entries[0].isIntersecting;
          if (isVisible) loop();
          else cancelAnimationFrame(animFrameId);
        });
        observer.observe(canvas);

        function loop() {
          if (!isVisible || !ctx) return;
          ctx.clearRect(0, 0, width, height);

          particles.forEach(p => {
            p.x += p.dx;
            p.y += p.dy;
            if (p.y < 0) p.y = height;
            if (p.x < 0) p.x = width;
            if (p.x > width) p.x = 0;

            ctx.beginPath();
            ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(197, 160, 89, ${p.a})`;
            ctx.fill();
          });

          animFrameId = requestAnimationFrame(loop);
        }
        loop();
      }
    }

    // 4. REPRODUCTOR DE AUDIO AMBIENTAL
    const audioPlayer = document.getElementById('audio-player-global') as HTMLAudioElement;
    const btnPlayToggle = document.getElementById('btn-reproductor-toggle');
    const iconPlay = document.getElementById('icon-play');
    const iconPause = document.getElementById('icon-pause');
    const selectTrack = document.getElementById('select-audio-track') as HTMLSelectElement;
    const trackNameEl = document.getElementById('player-track-name');
    const volumeSlider = document.getElementById('slider-volumen') as HTMLInputElement;
    const visualizer = document.getElementById('visualizer-bars');

    if (audioPlayer && btnPlayToggle && selectTrack) {
      audioPlayer.src = selectTrack.value;
      audioPlayer.volume = parseFloat(volumeSlider?.value || "0.35");

      btnPlayToggle.addEventListener('click', () => {
        if (audioPlayer.paused) {
          audioPlayer.play().then(() => {
            iconPlay?.classList.add('hidden');
            iconPause?.classList.remove('hidden');
            visualizer?.classList.remove('hidden');
            visualizer?.classList.add('flex');
          }).catch(err => console.log("Audio play error:", err));
        } else {
          audioPlayer.pause();
          iconPlay?.classList.remove('hidden');
          iconPause?.classList.add('hidden');
          visualizer?.classList.add('hidden');
          visualizer?.classList.remove('flex');
        }
      });

      selectTrack.addEventListener('change', () => {
        const isPlaying = !audioPlayer.paused;
        audioPlayer.src = selectTrack.value;
        if (trackNameEl) {
          trackNameEl.textContent = selectTrack.options[selectTrack.selectedIndex].text;
        }
        if (isPlaying) {
          audioPlayer.play();
        }
      });

      volumeSlider?.addEventListener('input', () => {
        audioPlayer.volume = parseFloat(volumeSlider.value);
      });

      audioPlayer.addEventListener('ended', () => {
        const nextIndex = (selectTrack.selectedIndex + 1) % selectTrack.options.length;
        selectTrack.selectedIndex = nextIndex;
        selectTrack.dispatchEvent(new Event('change'));
        audioPlayer.play();
      });
    }

    // 5. FILTROS POR CATEGORÍA / BLOQUE CANÓNICO Y BÚSQUEDA
    const filterButtons = document.querySelectorAll('.category-btn');
    const searchInput = document.getElementById('input-buscar-ilustres') as HTMLInputElement;
    let activeFilter = 'all';

    function applyFilters() {
      const query = (searchInput?.value || '').toLowerCase().trim();

      cards.forEach(card => {
        const cardEl = card as HTMLElement;
        const category = cardEl.getAttribute('data-category') || '';
        const searchData = cardEl.getAttribute('data-search') || '';

        const matchesFilter = (activeFilter === 'all' || category.includes(activeFilter));
        const matchesQuery = !query || searchData.includes(query);

        if (matchesFilter && matchesQuery) {
          cardEl.style.display = 'flex';
        } else {
          cardEl.style.display = 'none';
        }
      });
    }

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => {
          b.classList.remove('active', 'bg-[#EF7B38]', 'text-white');
          b.classList.add('bg-white', 'text-[#191614]');
        });
        btn.classList.add('active', 'bg-[#EF7B38]', 'text-white');
        btn.classList.remove('bg-white', 'text-[#191614]');

        activeFilter = btn.getAttribute('data-filter') || 'all';
        applyFilters();
      });
    });

    searchInput?.addEventListener('input', applyFilters);

    // 6. MODAL BIOGRÁFICO EXTENSO & VISOR DE DOSSIER
    const dialog = document.getElementById('dialog-biografia-ilustre') as HTMLDialogElement;
    const btnCerrar = document.getElementById('btn-cerrar-modal');
    const modalTarget = document.getElementById('modal-content-target');
    const botonesModal = document.querySelectorAll('.btn-abrir-modal');

    const tabBtnSemblanza = document.getElementById('tab-btn-semblanza');
    const tabBtnDossier = document.getElementById('tab-btn-dossier');
    const viewSemblanza = document.getElementById('view-semblanza');
    const viewDossier = document.getElementById('view-dossier');
    const dossierRendered = document.getElementById('dossier-rendered-content');
    const btnDescargarDossier = document.getElementById('btn-descargar-dossier-md') as HTMLAnchorElement;
    const readingBox = document.getElementById('dossier-reading-box');
    const fontDec = document.getElementById('dossier-font-dec');
    const fontInc = document.getElementById('dossier-font-inc');

    let currentAutor: any = null;
    let dossierFontSize = 16;

    // Función liviana para convertir Markdown a HTML limpio y legible
    function renderMarkdownToHtml(md: string): string {
      if (!md) return '';
      let html = md
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');

      // Headings
      html = html.replace(/^# (.*$)/gim, '<h1 class="text-2xl sm:text-3xl font-serif font-black text-[#191614] mt-6 mb-4 pb-2 border-b-2 border-[#C5A059]">$1</h1>');
      html = html.replace(/^## (.*$)/gim, '<h2 class="text-xl sm:text-2xl font-serif font-black text-[#EF7B38] mt-6 mb-3">$1</h2>');
      html = html.replace(/^### (.*$)/gim, '<h3 class="text-lg font-serif font-bold text-[#7A5B1E] mt-5 mb-2">$1</h3>');
      html = html.replace(/^#### (.*$)/gim, '<h4 class="text-base font-serif font-bold text-[#191614] mt-4 mb-1">$1</h4>');

      // Blockquotes
      html = html.replace(/^\> (.*$)/gim, '<blockquote class="p-3 my-3 bg-[#FAF7F0] border-l-4 border-[#EF7B38] italic font-serif text-sm text-[#191614] rounded-r-lg">$1</blockquote>');

      // Separadores
      html = html.replace(/^---$/gim, '<hr class="my-6 border-[#E3D7C5]"/>');

      // Bold & Italic
      html = html.replace(/\*\*(.*?)\*\*/gim, '<strong class="font-bold text-[#191614]">$1</strong>');
      html = html.replace(/\*(.*?)\*/gim, '<em class="italic">$1</em>');

      // Listas
      html = html.replace(/^\* (.*$)/gim, '<li class="ml-4 list-disc">$1</li>');
      html = html.replace(/^- (.*$)/gim, '<li class="ml-4 list-disc">$1</li>');

      // Párrafos
      html = html
        .split('\n\n')
        .map(p => {
          p = p.trim();
          if (!p) return '';
          if (p.startsWith('<h') || p.startsWith('<blockquote') || p.startsWith('<hr') || p.startsWith('<li')) return p;
          return `<p class="my-3 leading-relaxed font-serif text-[#2D2926]">${p.replace(/\n/g, '<br/>')}</p>`;
        })
        .join('');

      return html;
    }

    function cargarDossier(slug: string) {
      if (!dossierRendered) return;
      dossierRendered.innerHTML = '<p class="italic text-center py-8 text-gray-500">Cargando texto canónico integral...</p>';
      
      const dossierUrl = `/dossiers/${slug}.md`;
      fetch(dossierUrl)
        .then(res => {
          if (!res.ok) throw new Error('No se pudo cargar el dossier');
          return res.text();
        })
        .then(text => {
          dossierRendered.innerHTML = renderMarkdownToHtml(text);
        })
        .catch(err => {
          dossierRendered.innerHTML = `
            <div class="p-6 bg-red-50 text-red-800 rounded-xl border border-red-200 text-center">
              <p class="font-bold">Aviso del Consejo Editorial:</p>
              <p class="text-xs mt-1">El texto canónico está resguardado en el archivo maestro. Puede descargarlo directamente en el botón superior.</p>
            </div>
          `;
        });
    }

    function switchTab(tab: 'semblanza' | 'dossier') {
      if (tab === 'semblanza') {
        tabBtnSemblanza?.classList.add('bg-[#EF7B38]', 'text-white');
        tabBtnSemblanza?.classList.remove('bg-white', 'text-[#191614]');
        tabBtnDossier?.classList.remove('bg-[#EF7B38]', 'text-white');
        tabBtnDossier?.classList.add('bg-white', 'text-[#191614]');
        viewSemblanza?.classList.remove('hidden');
        viewDossier?.classList.add('hidden');
        viewDossier?.classList.remove('flex');
      } else {
        tabBtnDossier?.classList.add('bg-[#EF7B38]', 'text-white');
        tabBtnDossier?.classList.remove('bg-white', 'text-[#191614]');
        tabBtnSemblanza?.classList.remove('bg-[#EF7B38]', 'text-white');
        tabBtnSemblanza?.classList.add('bg-white', 'text-[#191614]');
        viewSemblanza?.classList.add('hidden');
        viewDossier?.classList.remove('hidden');
        viewDossier?.classList.add('flex');
        if (currentAutor) {
          cargarDossier(currentAutor.dossierSlug || currentAutor.id);
        }
      }
    }

    tabBtnSemblanza?.addEventListener('click', () => switchTab('semblanza'));
    tabBtnDossier?.addEventListener('click', () => switchTab('dossier'));

    fontDec?.addEventListener('click', () => {
      dossierFontSize = Math.max(14, dossierFontSize - 1);
      if (readingBox) readingBox.style.fontSize = `${dossierFontSize}px`;
    });

    fontInc?.addEventListener('click', () => {
      dossierFontSize = Math.min(24, dossierFontSize + 1);
      if (readingBox) readingBox.style.fontSize = `${dossierFontSize}px`;
    });

    botonesModal.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = btn.getAttribute('data-autor-id');
        const initialTab = btn.getAttribute('data-tab') || 'semblanza';
        const autor = autores.find((a: any) => a.id === id);
        if (!autor || !modalTarget || !dialog) return;

        currentAutor = autor;

        if (btnDescargarDossier) {
          btnDescargarDossier.href = `/dossiers/${autor.dossierSlug || autor.id}.md`;
          btnDescargarDossier.download = `${autor.dossierSlug || autor.id}_dossier_canonico.md`;
        }

        const bloqueEtiqueta = autor.bloqueCanon === 'tabasquenos' ? '🌴 Tabasco' : autor.bloqueCanon === 'mexicanos' ? '🦅 México' : '🌍 Universal';

        modalTarget.innerHTML = `
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- Columna Izquierda: Placa / Retrato y Datos Clave -->
            <div class="lg:col-span-4 space-y-4">
              <div class="rounded-2xl overflow-hidden border-2 border-[#C5A059] bg-[#FAF7F0] shadow-md">
                <img 
                  src="${autor.foto}" 
                  alt="${autor.nombre}" 
                  class="w-full h-auto object-cover"
                />
              </div>
              
              <div class="bg-white p-4 rounded-xl border border-[#E3D7C5] shadow-xs text-xs space-y-2">
                <p><strong>Nacimiento:</strong> ${autor.nacimiento}</p>
                <p><strong>Fallecimiento:</strong> ${autor.fallecimiento}</p>
                <p><strong>Origen:</strong> ${autor.municipioOrigen}</p>
                <p><strong>Movimiento:</strong> ${autor.movimiento}</p>
                <p><strong>Canon:</strong> ${bloqueEtiqueta} (⏱️ ${autor.tiempoLecturaMinutos || 30} min lectura)</p>
              </div>

              <!-- Pista recomendada de este autor -->
              <div class="bg-[#FAF7F0] p-4 rounded-xl border border-[#C5A059]/50 text-xs">
                <p class="font-title font-bold text-[#7A5B1E] uppercase tracking-wider text-[10px] mb-1">
                  Música recomendada para su lectura:
                </p>
                <p class="font-serif font-bold text-[#191614]">${autor.audioSugerido.titulo}</p>
                <p class="text-[11px] text-[#7A7268]">${autor.audioSugerido.compositor}</p>
                <button 
                  type="button" 
                  class="btn-escuchar-autor mt-2.5 w-full py-1.5 px-3 rounded-lg bg-[#EF7B38] hover:bg-[#8F3812] text-white text-[11px] font-title font-bold transition flex items-center justify-center gap-1.5 cursor-pointer"
                  data-audio="${autor.audioSugerido.archivo}"
                  data-name="${autor.audioSugerido.titulo}"
                >
                  <span>▶ Reproducir esta obra</span>
                </button>
              </div>

              <!-- Botón rápido al dossier -->
              <button 
                type="button" 
                class="btn-ir-a-dossier w-full py-2.5 px-4 rounded-xl bg-[#191614] hover:bg-[#EF7B38] text-white text-xs font-title font-bold transition flex items-center justify-center gap-2 cursor-pointer shadow-sm"
              >
                <span>📖 Leer Dossier Completo</span>
              </button>
            </div>

            <!-- Columna Derecha: Biografía Extensa, Obras y Citas -->
            <div class="lg:col-span-8 space-y-6">
              <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[10px] font-title font-bold uppercase tracking-wider bg-[#EF7B38]/10 text-[#EF7B38] mb-2 border border-[#EF7B38]/20">
                  ${bloqueEtiqueta} · ${autor.badge}
                </div>
                <h2 class="text-3xl sm:text-4xl font-serif font-black text-[#191614]">${autor.nombre}</h2>
                <p class="text-sm font-serif italic text-[#7A5B1E] font-semibold mt-1">«${autor.tituloHonorifico}»</p>
              </div>

              <!-- Párrafos de Biografía Extensa -->
              <div class="prose prose-sm font-serif text-[#2D2926] leading-relaxed space-y-3.5 border-t border-[#E3D7C5] pt-4">
                ${autor.biografiaCompleta.map((p: string) => `<p>${p}</p>`).join('')}
              </div>

              <!-- Legado Patrimonial -->
              <div class="p-4 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-xs">
                <p class="font-title font-bold text-amber-900 uppercase tracking-widest text-[10px] mb-1">🏛️ Legado para Tabasco y las Letras Universales</p>
                <p class="font-serif italic text-[#2D2926] leading-relaxed">${autor.legadoPatrimonial}</p>
              </div>

              <!-- Obras Capitales Detalladas -->
              <div class="space-y-3">
                <h3 class="font-title font-bold text-xs uppercase tracking-widest text-[#191614]">📚 Obras Capitales & Bibliografía</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  ${autor.obrasCapitales.map((obra: any) => `
                    <div class="p-3 bg-white rounded-xl border border-[#E3D7C5] shadow-xs">
                      <div class="flex items-center justify-between gap-1 mb-1">
                        <span class="font-serif font-bold text-xs text-[#191614]">${obra.titulo}</span>
                        <span class="text-[10px] font-mono font-bold text-[#EF7B38]">${obra.anio}</span>
                      </div>
                      <p class="text-[10px] font-title text-[#7A5B1E] font-semibold uppercase">${obra.genero}</p>
                      <p class="text-[11px] font-sans text-[#4A443E] mt-1 line-clamp-2">${obra.descripcion}</p>
                    </div>
                  `).join('')}
                </div>
              </div>

              <!-- Citas Célebres -->
              <div class="space-y-3">
                <h3 class="font-title font-bold text-xs uppercase tracking-widest text-[#191614]">💬 Citas Textuales Célebres</h3>
                <div class="space-y-2">
                  ${autor.citasMemorables.map((c: any) => `
                    <div class="p-3.5 bg-white rounded-xl border-l-2 border-[#EF7B38] border-r border-t border-b border-[#E3D7C5] shadow-xs">
                      <p class="font-serif italic text-xs text-[#191614]">«${c.cita}»</p>
                      <p class="text-[10px] text-[#7A7268] font-title font-bold mt-1 text-right">— ${c.obra}</p>
                    </div>
                  `).join('')}
                </div>
              </div>

              <!-- Datos Curiosos -->
              <div class="space-y-2">
                <h3 class="font-title font-bold text-xs uppercase tracking-widest text-[#191614]">💡 Datos Biográficos Curiosos</h3>
                <ul class="list-disc pl-5 space-y-1 text-xs font-sans text-[#4A443E]">
                  ${autor.datosCuriosos.map((d: string) => `<li>${d}</li>`).join('')}
                </ul>
              </div>

            </div>

          </div>
        `;

        // Evento al botón de audio dentro del modal
        const btnEscuchar = modalTarget.querySelector('.btn-escuchar-autor');
        btnEscuchar?.addEventListener('click', () => {
          const trackUrl = btnEscuchar.getAttribute('data-audio');
          const trackTitle = btnEscuchar.getAttribute('data-name');
          if (audioPlayer && trackUrl) {
            audioPlayer.src = trackUrl;
            if (trackNameEl) trackNameEl.textContent = trackTitle || 'Pista de Autor';
            audioPlayer.play().then(() => {
              iconPlay?.classList.add('hidden');
              iconPause?.classList.remove('hidden');
              visualizer?.classList.remove('hidden');
              visualizer?.classList.add('flex');
            }).catch(e => console.log(e));
          }
        });

        // Evento botón ir a dossier
        const btnIrDossier = modalTarget.querySelector('.btn-ir-a-dossier');
        btnIrDossier?.addEventListener('click', () => {
          switchTab('dossier');
        });

        switchTab(initialTab === 'dossier' ? 'dossier' : 'semblanza');

        dialog.showModal();
      });
    });

    // Cerrar modal al hacer clic en botón de cerrar o fuera del cuadro
    btnCerrar?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('click', (e) => {
      const rect = dialog.getBoundingClientRect();
      if (
        e.clientX < rect.left ||
        e.clientX > rect.right ||
        e.clientY < rect.top ||
        e.clientY > rect.bottom
      ) {
        dialog.close();
      }
    });

    // 7. BOTÓN COPIAR CITA CON FEEDBACK VISUAL
    const toast = document.getElementById('toast-copia');
    const botonesCopiar = document.querySelectorAll('.btn-copiar-cita');

    botonesCopiar.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const cita = btn.getAttribute('data-cita');
        if (cita) {
          navigator.clipboard.writeText(cita).then(() => {
            if (toast) {
              toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
              toast.classList.add('translate-y-0', 'opacity-100');
              setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
                toast.classList.remove('translate-y-0', 'opacity-100');
              }, 2500);
            }
          });
        }
      });
    });

  })();
</script>
