---
// GobernanzaHub.astro - Pabellón Maestro Institucional con Navegación por Pestañas Exclusivas
const basePath = "";
---

<section id="gobernanza" class="py-28 bg-editorial border-b border-editorial-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Cabecera de la Sección -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-editorial-warm border border-editorial-border text-terracota font-title text-[11px] font-bold uppercase tracking-widest mb-3 shadow-subtle">
        <span class="w-2 h-2 rounded-full bg-terracota"></span>
        <span>Marco Institucional • Gestión 2026 – 2029</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-carbon">
        Gobernanza, Legalidad y Membresía
      </h2>
      <p class="text-sm sm:text-base text-gray-600 mt-3 font-light leading-relaxed">
        Estructura jurídica, representación directiva, protocolos de admisión gremial y repositorio de documentación oficial.
      </p>
      <div class="w-20 h-0.5 bg-terracota mx-auto mt-4 rounded-full"></div>
    </div>

    <!-- Barra de Pestañas Maestras Exclusivas -->
    <div class="flex justify-center mb-14">
      <div class="inline-flex flex-wrap justify-center p-1.5 rounded-3xl bg-editorial-warm border border-editorial-border shadow-subtle gap-1.5">
        <button 
          id="hub-tab-directiva" 
          type="button" 
          class="hub-tab active px-5 sm:px-7 py-3 rounded-2xl text-xs font-title font-bold uppercase tracking-wider bg-terracota text-white shadow-md transition duration-300"
          data-target="hub-view-directiva"
        >
          🏛️ Mesa Directiva
        </button>
        <button 
          id="hub-tab-solvencia" 
          type="button" 
          class="hub-tab px-5 sm:px-7 py-3 rounded-2xl text-xs font-title font-bold uppercase tracking-wider text-carbon hover:text-terracota transition duration-300"
          data-target="hub-view-solvencia"
        >
          ⚖️ Solvencia & Convenios
        </button>
        <button 
          id="hub-tab-membresia" 
          type="button" 
          class="hub-tab px-5 sm:px-7 py-3 rounded-2xl text-xs font-title font-bold uppercase tracking-wider text-carbon hover:text-terracota transition duration-300"
          data-target="hub-view-membresia"
        >
          ✍️ Cómo Ingresar a LVT
        </button>
        <button 
          id="hub-tab-descargas" 
          type="button" 
          class="hub-tab px-5 sm:px-7 py-3 rounded-2xl text-xs font-title font-bold uppercase tracking-wider text-carbon hover:text-terracota transition duration-300"
          data-target="hub-view-descargas"
        >
          📂 Descargas
        </button>
      </div>
    </div>

    <!-- VISTA 1: MESA DIRECTIVA (ACTIVA POR DEFECTO) -->
    <div id="hub-view-directiva" class="hub-view tab-content-active">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
        
        <!-- Presidente -->
        <div class="bg-white rounded-3xl border border-editorial-border shadow-subtle hover:shadow-elevated hover:-translate-y-1.5 transition duration-300 overflow-hidden flex flex-col group">
          <div class="relative overflow-hidden aspect-[4/5] bg-editorial-warm">
            <img 
              src={`${basePath}/assets/directiva/juan_david_perez_cabrera.jpg`} 
              alt="Lic. Juan David Pérez Cabrera - Presidente de Letras y Voces de Tabasco, A.C." 
              class="w-full h-full object-cover object-center grayscale contrast-115 group-hover:scale-103 transition duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-carbon/85 via-carbon/20 to-transparent opacity-85 group-hover:opacity-95 transition"></div>
            <div class="absolute bottom-5 left-5 right-5 text-white">
              <span class="text-[10px] font-title font-bold uppercase tracking-widest text-dorado-light block mb-1">
                Presidencia & Representación Legal
              </span>
              <h3 class="font-serif text-2xl font-bold text-white leading-tight">
                Lic. Juan David Pérez Cabrera
              </h3>
            </div>
          </div>
          <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between space-y-4">
            <p class="text-xs sm:text-sm text-gray-600 font-light leading-relaxed">
              Dirección general, representación legal, gestión de alianzas interinstitucionales con entidades de gobierno y vinculación estratégica del gremio literario.
            </p>
            <div class="pt-4 border-t border-editorial-border flex items-center justify-between text-xs font-title font-bold uppercase tracking-wider text-gray-500">
              <span>Periodo Directivo</span>
              <span class="text-terracota font-bold">2026 – 2029</span>
            </div>
          </div>
        </div>

        <!-- Secretaria -->
        <div class="bg-white rounded-3xl border border-editorial-border shadow-subtle hover:shadow-elevated hover:-translate-y-1.5 transition duration-300 overflow-hidden flex flex-col group">
          <div class="relative overflow-hidden aspect-[4/5] bg-editorial-warm">
            <img 
              src={`${basePath}/assets/directiva/eva_guadalupe_pineda_cruz.jpg`} 
              alt="Dra. Eva Guadalupe Pineda Cruz - Secretaria General de Letras y Voces de Tabasco, A.C." 
              class="w-full h-full object-cover object-center grayscale contrast-115 group-hover:scale-103 transition duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-carbon/85 via-carbon/20 to-transparent opacity-85 group-hover:opacity-95 transition"></div>
            <div class="absolute bottom-5 left-5 right-5 text-white">
              <span class="text-[10px] font-title font-bold uppercase tracking-widest text-dorado-light block mb-1">
                Secretaría General
              </span>
              <h3 class="font-serif text-2xl font-bold text-white leading-tight">
                Dra. Eva Guadalupe Pineda Cruz
              </h3>
            </div>
          </div>
          <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between space-y-4">
            <p class="text-xs sm:text-sm text-gray-600 font-light leading-relaxed">
              Acuerdos colegiados en asamblea general, control del archivo histórico, convocatorias oficiales y coordinación de correspondencia formal.
            </p>
            <div class="pt-4 border-t border-editorial-border flex items-center justify-between text-xs font-title font-bold uppercase tracking-wider text-gray-500">
              <span>Periodo Directivo</span>
              <span class="text-terracota font-bold">2026 – 2029</span>
            </div>
          </div>
        </div>

        <!-- Tesorera -->
        <div class="bg-white rounded-3xl border border-editorial-border shadow-subtle hover:shadow-elevated hover:-translate-y-1.5 transition duration-300 overflow-hidden flex flex-col group">
          <div class="relative overflow-hidden aspect-[4/5] bg-editorial-warm">
            <img 
              src={`${basePath}/assets/directiva/ana_laura_hernandez_jimenez.jpg`} 
              alt="Ana Laura Hernández Jiménez - Tesorera Institucional de Letras y Voces de Tabasco, A.C." 
              class="w-full h-full object-cover object-center grayscale contrast-115 group-hover:scale-103 transition duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-carbon/85 via-carbon/20 to-transparent opacity-85 group-hover:opacity-95 transition"></div>
            <div class="absolute bottom-5 left-5 right-5 text-white">
              <span class="text-[10px] font-title font-bold uppercase tracking-widest text-dorado-light block mb-1">
                Tesorería Institucional
              </span>
              <h3 class="font-serif text-2xl font-bold text-white leading-tight">
                Ana Laura Hernández Jiménez
              </h3>
            </div>
          </div>
          <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between space-y-4">
            <p class="text-xs sm:text-sm text-gray-600 font-light leading-relaxed">
              Administración financiera, control y transparencia de fondos editoriales, expedición de recibos y regularización de aportaciones voluntarias.
            </p>
            <div class="pt-4 border-t border-editorial-border flex items-center justify-between text-xs font-title font-bold uppercase tracking-wider text-gray-500">
              <span>Periodo Directivo</span>
              <span class="text-terracota font-bold">2026 – 2029</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Comisión de Honor y Justicia -->
      <div class="mt-8 pt-8 border-t border-editorial-border">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 mb-6">
          <div>
            <span class="text-[10px] font-title font-bold text-terracota uppercase tracking-widest block mb-0.5">Vigilancia Estatutaria</span>
            <h3 class="font-serif text-xl sm:text-2xl font-bold text-carbon">Comisión de Honor y Justicia (2026–2029)</h3>
          </div>
          <span class="text-xs font-serif italic text-gray-500">Preservación ética y estatutaria</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-5 rounded-2xl bg-white border border-editorial-border shadow-subtle flex items-start gap-4">
            <div class="w-14 h-14 rounded-2xl overflow-hidden bg-editorial-warm shrink-0 border border-editorial-border">
              <img 
                src={`${basePath}/assets/directiva/liliana_chuzeville_cordoba.png`} 
                alt="Dra. Liliana Chuzeville Córdoba"
                class="w-full h-full object-cover grayscale"
                loading="lazy"
              />
            </div>
            <div class="space-y-1">
              <span class="px-2 py-0.5 rounded-full bg-editorial-warm text-terracota text-[9px] font-title font-bold uppercase tracking-wider inline-block">
                Delegada Emérita · Expresidenta LVT
              </span>
              <h4 class="font-serif font-bold text-base text-carbon">Dra. Liliana Chuzeville Córdoba</h4>
              <p class="text-xs text-gray-600 font-light leading-relaxed">
                Doctora en Criminología, Expresidenta de LVT, titular de la Comisión de Honor y Justicia y Directora General de la Escuela de Escritores «José Gorostiza».
              </p>
            </div>
          </div>

          <div class="p-5 rounded-2xl bg-white border border-editorial-border shadow-subtle flex items-start gap-4">
            <div class="w-14 h-14 rounded-2xl overflow-hidden bg-editorial-warm shrink-0 border border-editorial-border">
              <img 
                src={`${basePath}/assets/directiva/pragedis_hernandez_garcia.png`} 
                alt="Mtra. Pragedis Hernández García"
                class="w-full h-full object-cover grayscale"
                loading="lazy"
              />
            </div>
            <div class="space-y-1">
              <span class="px-2 py-0.5 rounded-full bg-editorial-warm text-terracota text-[9px] font-title font-bold uppercase tracking-wider inline-block">
                Integrante · Expresidenta LVT
              </span>
              <h4 class="font-serif font-bold text-base text-carbon">Mtra. Pragedis Hernández García</h4>
              <p class="text-xs text-gray-600 font-light leading-relaxed">
                Expresidenta de LVT, integrante de la Comisión de Honor y Justicia y compiladora de «Tardes Tabasqueñas de Ópalos y Topacios».
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Socios Activos Acreditados -->
      <div class="mt-8 pt-8 border-t border-editorial-border">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 mb-6">
          <div>
            <span class="text-[10px] font-title font-bold text-terracota uppercase tracking-widest block mb-0.5">Padrón Estatutario</span>
            <h3 class="font-serif text-xl sm:text-2xl font-bold text-carbon">Socios Activos Acreditados (2026–2029)</h3>
          </div>
          <span class="text-xs font-serif italic text-gray-500">Membresía con voz y voto colegiado</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs">
          <div class="p-4 rounded-2xl bg-white border border-editorial-border shadow-subtle flex gap-3.5 items-start">
            <div class="w-12 h-12 rounded-xl overflow-hidden bg-editorial-warm shrink-0 border border-editorial-border">
              <img 
                src={`${basePath}/assets/autores/juan_manuel_canepa.png`} 
                alt="Mtro. Juan Manuel Cánepa Bertolini"
                class="w-full h-full object-cover grayscale"
                loading="lazy"
              />
            </div>
            <div class="space-y-1 flex-1">
              <span class="px-2 py-0.5 rounded-md bg-editorial-warm text-terracota text-[9px] font-title font-bold uppercase block w-max">Socio Activo</span>
              <h4 class="font-serif font-bold text-sm text-carbon">Mtro. Juan Manuel Cánepa Bertolini</h4>
              <p class="text-gray-600 font-light">Escritor, compositor musical y conferencista. Participante en antologías institucionales.</p>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-white border border-editorial-border shadow-subtle flex gap-3.5 items-start">
            <div class="w-12 h-12 rounded-xl overflow-hidden bg-editorial-warm shrink-0 border border-editorial-border">
              <img 
                src={`${basePath}/assets/autores/maria_cervantes.png`} 
                alt="Dra. María de los Ángeles Cervantes Rosas"
                class="w-full h-full object-cover grayscale"
                loading="lazy"
              />
            </div>
            <div class="space-y-1 flex-1">
              <span class="px-2 py-0.5 rounded-md bg-editorial-warm text-terracota text-[9px] font-title font-bold uppercase block w-max">Socia Activa</span>
              <h4 class="font-serif font-bold text-sm text-carbon">Dra. María de los Ángeles Cervantes Rosas</h4>
              <p class="text-gray-600 font-light">Doctora en Ciencias Administrativas (SNI I), poeta y pintora plástica. Autora de «A corazón abierto».</p>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-white border border-editorial-border shadow-subtle flex gap-3.5 items-start">
            <div class="w-12 h-12 rounded-xl overflow-hidden bg-editorial-warm shrink-0 border border-editorial-border flex items-center justify-center text-sm font-serif font-bold text-terracota">
              PP
            </div>
            <div class="space-y-1 flex-1">
              <span class="px-2 py-0.5 rounded-md bg-editorial-warm text-terracota text-[9px] font-title font-bold uppercase block w-max">Socia Activa</span>
              <h4 class="font-serif font-bold text-sm text-carbon">Paulina Pineda</h4>
              <p class="text-gray-600 font-light">Escritora y promotora cultural tabasqueña, participante en lecturas líricas y actividades colegiadas.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- VISTA 2: SOLVENCIA & CONVENIOS -->
    <div id="hub-view-solvencia" class="hub-view hidden">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
        <div class="p-7 rounded-3xl bg-white border border-editorial-border shadow-subtle">
          <span class="text-[10px] font-title font-bold text-gray-400 uppercase tracking-widest block mb-1">Personalidad Jurídica</span>
          <h3 class="font-serif text-xl font-bold text-carbon mb-2">Constitución Legal</h3>
          <p class="text-xs text-gray-600 font-light leading-relaxed">
            Asociación Civil constituida conforme a las leyes vigentes, facultada para la gestión, edición, fomento y difusión de la literatura.
          </p>
        </div>

        <div class="p-7 rounded-3xl bg-white border border-editorial-border shadow-subtle">
          <span class="text-[10px] font-title font-bold text-gray-400 uppercase tracking-widest block mb-1">Misión Estatutaria</span>
          <h3 class="font-serif text-xl font-bold text-carbon mb-2">Objeto Cultural</h3>
          <p class="text-xs text-gray-600 font-light leading-relaxed">
            Fomento, edición y preservación del patrimonio lírico, formación de nuevas generaciones y vinculación con la comunidad artística.
          </p>
        </div>

        <div class="p-7 rounded-3xl bg-white border border-editorial-border shadow-subtle">
          <span class="text-[10px] font-title font-bold text-gray-400 uppercase tracking-widest block mb-1">Colegiado 2026–2029</span>
          <h3 class="font-serif text-xl font-bold text-carbon mb-2">Gobernanza</h3>
          <p class="text-xs text-gray-600 font-light leading-relaxed">
            Órganos de gobierno electos por asamblea general ordinaria con acuerdos colegiados y rendición periódica de cuentas.
          </p>
        </div>

        <div class="p-7 rounded-3xl bg-white border border-editorial-border shadow-subtle">
          <span class="text-[10px] font-title font-bold text-gray-400 uppercase tracking-widest block mb-1">Sureste de México</span>
          <h3 class="font-serif text-xl font-bold text-carbon mb-2">Sede & Vinculación</h3>
          <p class="text-xs text-gray-600 font-light leading-relaxed">
            Domicilio fiscal y sede operativa en Villahermosa, con convenios en recintos universitarios y centros culturales del Estado.
          </p>
        </div>
      </div>

      <!-- Recintos de Colaboración -->
      <div class="p-8 rounded-3xl bg-white border border-editorial-border shadow-subtle text-center">
        <span class="text-xs font-title font-bold uppercase tracking-widest text-gray-500 block mb-6">
          Recintos y Entidades de Colaboración y Difusión Cultural
        </span>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-xs font-serif font-bold text-carbon">
          <div class="p-4 bg-editorial-warm rounded-2xl border border-editorial-border">Secretaría de Cultura Tabasco</div>
          <div class="p-4 bg-editorial-warm rounded-2xl border border-editorial-border">Casa Cacao y Chocolate</div>
          <div class="p-4 bg-editorial-warm rounded-2xl border border-editorial-border">Universidad Juárez Autónoma</div>
          <div class="p-4 bg-editorial-warm rounded-2xl border border-editorial-border">Gremio Independiente</div>
        </div>
      </div>
    </div>

    <!-- VISTA 3: CÓMO INGRESAR A LVT -->
    <div id="hub-view-membresia" class="hub-view hidden">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
        <div class="bg-white p-8 rounded-3xl border border-editorial-border shadow-subtle flex flex-col justify-between">
          <div>
            <span class="text-2xl font-serif font-bold text-terracota block mb-2">Paso 01</span>
            <h3 class="font-serif text-2xl font-bold text-carbon mb-3">Solicitud & Muestra</h3>
            <p class="text-xs sm:text-sm text-gray-600 font-light leading-relaxed">
              Envío de semblanza biográfica, carta de motivos y un compendio literario con muestras de obra inédita o publicada (poesía, cuento o ensayo).
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-editorial-border text-xs text-gray-400">
            Recepción por Secretaría General
          </div>
        </div>

        <div class="bg-white p-8 rounded-3xl border border-editorial-border shadow-subtle flex flex-col justify-between">
          <div>
            <span class="text-2xl font-serif font-bold text-dorado block mb-2">Paso 02</span>
            <h3 class="font-serif text-2xl font-bold text-carbon mb-3">Dictamen Colegiado</h3>
            <p class="text-xs sm:text-sm text-gray-600 font-light leading-relaxed">
              El Comité Editorial y la Mesa Directiva evalúan la calidad estética, originalidad y congruencia estilística del material presentado.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-editorial-border text-xs text-gray-400">
            Dictamen en Sesión Ordinaria
          </div>
        </div>

        <div class="bg-white p-8 rounded-3xl border border-editorial-border shadow-subtle flex flex-col justify-between">
          <div>
            <span class="text-2xl font-serif font-bold text-terracota block mb-2">Paso 03</span>
            <h3 class="font-serif text-2xl font-bold text-carbon mb-3">Toma de Protesta</h3>
            <p class="text-xs sm:text-sm text-gray-600 font-light leading-relaxed">
              Ratificación en Asamblea General, entrega de constancia de acreditación e integración formal al padrón y proyectos editoriales en marcha.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-editorial-border text-xs text-gray-400">
            Acreditación Estatutaria
          </div>
        </div>
      </div>

      <div class="text-center">
        <a 
          href="https://wa.me/522205889391?text=Hola%20Mesa%20Directiva%20de%20LVT,%20deseo%20iniciar%20mi%20proceso%20de%20afiliaci%C3%B3n%20como%20socio%20escritor." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-2 px-9 py-4 rounded-full bg-terracota text-white font-title text-xs font-bold uppercase tracking-wider hover:bg-terracota-hover shadow-elevated hover:scale-103 transition"
        >
          <span>Iniciar Postulación por WhatsApp</span>
        </a>
      </div>
    </div>

    <!-- VISTA 4: CENTRO DE DESCARGAS PDF -->
    <div id="hub-view-descargas" class="hub-view hidden">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Doc 1: Solicitud de Ingreso -->
        <div class="bg-white p-7 rounded-3xl border border-editorial-border shadow-subtle flex flex-col justify-between">
          <div>
            <span class="px-3 py-1 rounded-full bg-green-100 text-green-800 text-[10px] font-title font-bold uppercase tracking-widest inline-block mb-3">Afiliación Oficial</span>
            <h3 class="font-serif text-xl font-bold text-carbon mb-2">Solicitud de Ingreso</h3>
            <p class="text-xs text-gray-600 font-light leading-relaxed mb-4">
              Formato oficial de postulación para escritoras y escritores que desean integrarse a la asociación.
            </p>
          </div>
          <a 
            href="https://wa.me/522205889391?text=Hola%20Secretar%C3%ADa%20General%20LVT,%20solicito%20el%20formato%20oficial%20de%20ingreso." 
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-3 rounded-2xl bg-green-600 hover:bg-green-700 text-white font-title text-xs font-bold uppercase tracking-wider transition text-center shadow-subtle inline-block"
          >
            Solicitar Formato
          </a>
        </div>

        <!-- Doc 2: Convocatorias -->
        <div class="bg-white p-7 rounded-3xl border border-editorial-border shadow-subtle flex flex-col justify-between">
          <div>
            <span class="px-3 py-1 rounded-full bg-terracota/15 text-terracota text-[10px] font-title font-bold uppercase tracking-widest inline-block mb-3">Bases 2026</span>
            <h3 class="font-serif text-xl font-bold text-carbon mb-2">Bases de Convocatorias</h3>
            <p class="text-xs text-gray-600 font-light leading-relaxed mb-4">
              Requisitos de formato y entrega de textos poéticos y narrativos para antologías y concursos.
            </p>
          </div>
          <a 
            href={`${basePath}/descargas#convocatorias`} 
            class="w-full py-3 rounded-2xl bg-editorial-warm border border-editorial-border text-carbon hover:bg-terracota hover:text-white font-title text-xs font-bold uppercase tracking-wider transition text-center shadow-subtle inline-block"
          >
            Ver Convocatorias
          </a>
        </div>

        <!-- Doc 3: Guía Editorial -->
        <div class="bg-white p-7 rounded-3xl border border-editorial-border shadow-subtle flex flex-col justify-between">
          <div>
            <span class="px-3 py-1 rounded-full bg-dorado/20 text-dorado text-[10px] font-title font-bold uppercase tracking-widest inline-block mb-3">Fondo Editorial</span>
            <h3 class="font-serif text-xl font-bold text-carbon mb-2">Criterios de Publicación</h3>
            <p class="text-xs text-gray-600 font-light leading-relaxed mb-4">
              Guía de estilo y dictamen colegiado para autores participantes en el fondo editorial LVT.
            </p>
          </div>
          <a 
            href={`${basePath}/publicaciones`} 
