---
// CentroDescargas.astro - Centro de Formatos Oficiales, Guías Editoriales y Recursos Públicos LVT
const basePath = "";
---

<section id="descargas" class="py-14 sm:py-16 bg-[#FDFBF7] text-[#222222] border-b border-[#E6DCCE]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
    
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#EF7B38]/10 border border-[#EF7B38]/20 text-[#EF7B38] font-title text-[10px] sm:text-xs font-bold uppercase tracking-widest shadow-xs">
        <span class="w-2 h-2 rounded-full bg-[#EF7B38]"></span>
        <span>Formatos Oficiales & Recursos para Autores</span>
      </div>
      <h2 class="font-title text-2xl sm:text-4xl lg:text-5xl font-black text-[#222222] tracking-tight">
        Centro de Formatos y <span class="text-[#EF7B38]">Recursos</span>
      </h2>
      <p class="text-xs sm:text-sm md:text-base text-[#555555] font-serif italic leading-relaxed">
        Acceso público a formatos de postulación, guías de estilo para antologías, convocatorias vigentes y materiales para medios de comunicación.
      </p>
      <div class="w-16 h-0.5 bg-[#EF7B38] mx-auto rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <!-- Recurso 1: Solicitud de Ingreso Gremial -->
      <div class="bg-white p-6 sm:p-7 rounded-3xl border border-[#E6DCCE] shadow-subtle hover:shadow-xl hover:border-[#EF7B38] transition-all flex flex-col justify-between group">
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-0.5 rounded-full bg-green-100 text-green-800 text-[10px] font-title font-bold uppercase tracking-wider">
              Afiliación
            </span>
            <span class="text-xs text-gray-400 font-mono">Oficial LVT</span>
          </div>
          <h3 class="font-title text-lg font-bold text-[#222222] group-hover:text-[#EF7B38] transition leading-snug">
            Solicitud de Ingreso Gremial
          </h3>
          <p class="text-xs text-[#555555] font-sans leading-relaxed">
            Formato oficial de postulación para escritoras y escritores interesados en incorporarse como socios de Letras y Voces de Tabasco, A.C.
          </p>
        </div>
        <div class="pt-5 mt-4 border-t border-[#E6DCCE]">
          <a 
            href="https://wa.me/522205889391?text=Hola%20Secretar%C3%ADa%20General%20LVT,%20solicito%20el%20formato%20oficial%20para%20postularme%20como%20nuevo%20socio." 
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-2.5 rounded-xl bg-green-600 hover:bg-green-700 text-white font-title text-xs font-bold uppercase tracking-wider transition text-center shadow-xs inline-flex items-center justify-center gap-1.5"
          >
            <span>Solicitar Formato</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- Recurso 2: Guía de Criterios Editoriales -->
      <div class="bg-white p-6 sm:p-7 rounded-3xl border border-[#E6DCCE] shadow-subtle hover:shadow-xl hover:border-[#EF7B38] transition-all flex flex-col justify-between group">
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-0.5 rounded-full bg-[#EF7B38]/15 text-[#EF7B38] text-[10px] font-title font-bold uppercase tracking-wider">
              Editorial
            </span>
            <span class="text-xs text-gray-400 font-mono">Guía de Estilo</span>
          </div>
          <h3 class="font-title text-lg font-bold text-[#222222] group-hover:text-[#EF7B38] transition leading-snug">
            Criterios de Publicación
          </h3>
          <p class="text-xs text-[#555555] font-sans leading-relaxed">
            Pautas formales, métrica, tipografía, extensión y requisitos de entrega de manuscritos para antologías colectivas del Fondo Editorial.
          </p>
        </div>
        <div class="pt-5 mt-4 border-t border-[#E6DCCE]">
          <a 
            href={`${basePath}/publicaciones`} 
            class="w-full py-2.5 rounded-xl bg-white border border-[#E6DCCE] text-[#222222] hover:bg-[#EF7B38] hover:text-white hover:border-[#EF7B38] font-title text-xs font-bold uppercase tracking-wider transition text-center shadow-xs inline-flex items-center justify-center gap-1.5"
          >
            <span>Ver Publicaciones</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- Recurso 3: Convocatorias y Certámenes -->
      <div class="bg-white p-6 sm:p-7 rounded-3xl border border-[#E6DCCE] shadow-subtle hover:shadow-xl hover:border-[#EF7B38] transition-all flex flex-col justify-between group">
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-0.5 rounded-full bg-[#C59B27]/20 text-[#B8860B] text-[10px] font-title font-bold uppercase tracking-wider">
              Convocatorias
            </span>
            <span class="text-xs text-gray-400 font-mono">Bases 2026</span>
          </div>
          <h3 class="font-title text-lg font-bold text-[#222222] group-hover:text-[#EF7B38] transition leading-snug">
            Bases de Convocatorias
          </h3>
          <p class="text-xs text-[#555555] font-sans leading-relaxed">
            Consulte las bases de participación de Nuevos Socios, estado de Animalia Literaria en imprenta y directorio de certámenes literarios.
          </p>
        </div>
        <div class="pt-5 mt-4 border-t border-[#E6DCCE]">
          <a 
            href={`${basePath}/descargas#convocatorias`} 
            class="w-full py-2.5 rounded-xl bg-[#222222] hover:bg-[#EF7B38] text-white font-title text-xs font-bold uppercase tracking-wider transition text-center shadow-xs inline-flex items-center justify-center gap-1.5"
          >
            <span>Ver Convocatorias</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- Recurso 4: Compendio de Prensa & Medios -->
      <div class="bg-white p-6 sm:p-7 rounded-3xl border border-[#E6DCCE] shadow-subtle hover:shadow-xl hover:border-[#EF7B38] transition-all flex flex-col justify-between group">
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-0.5 rounded-full bg-blue-100 text-blue-800 text-[10px] font-title font-bold uppercase tracking-wider">
              Prensa
            </span>
            <span class="text-xs text-gray-400 font-mono">Institucional</span>
          </div>
          <h3 class="font-title text-lg font-bold text-[#222222] group-hover:text-[#EF7B38] transition leading-snug">
            Compendio de Prensa & Medios
          </h3>
          <p class="text-xs text-[#555555] font-sans leading-relaxed">
            Semblanza institucional de 39 años de trayectoria, logotipos oficiales vectoriales e información de contacto para coberturas culturales.
          </p>
        </div>
        <div class="pt-5 mt-4 border-t border-[#E6DCCE]">
          <a 
            href="mailto:lvt.correo@gmail.com?subject=Solicitud%20de%20Compendio%20de%20Prensa%20LVT" 
            class="w-full py-2.5 rounded-xl bg-white border border-[#E6DCCE] text-[#222222] hover:bg-[#EF7B38] hover:text-white hover:border-[#EF7B38] font-title text-xs font-bold uppercase tracking-wider transition text-center shadow-xs inline-flex items-center justify-center gap-1.5"
          >
            <span>Solicitar por Correo</span>
            <span>✉️</span>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
