---
// EscuelaGorostiza.astro - Filial Académica Oficial de Letras y Voces de Tabasco, A.C. (Actualización 2026)
import { 
  IDENTIDAD_ESCUELA, 
  DIPLOMADOS_GOROSTIZA, 
  CURSOS_CONTINUOS_GOROSTIZA,
  TALLERES_LIBRES_ESCUELA, 
  PIONEROS_Y_REFERENTES_EEJG,
  DIRECTIVAS_ACTUALES_EEJG
} from '../data/escuela';

const basePath = "";
---

<section id="escuela-gorostiza" class="py-14 sm:py-16 bg-[#FDFBF7] text-[#222222] border-b border-[#E6DCCE] relative overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-12 sm:space-y-16">
    
    <!-- ================================================================= -->
    <!-- 1. ENCABEZADO INSTITUCIONAL CON LOGOTIPO OFICIAL & FILOSOFÍA PEDAGÓGICA -->
    <!-- ================================================================= -->
    <!-- 1. ENCABEZADO INSTITUCIONAL CON LOGOTIPO OFICIAL & FILOSOFÍA PEDAGÓGICA -->
    <!-- ================================================================= -->
    <div class="max-w-4xl mx-auto space-y-6 text-center">
      
      <!-- Sello / Logotipo Oficial Centrado con Aura Editorial -->
      <div class="flex flex-col items-center justify-center">
        <div class="relative group">
          <div class="absolute -inset-1.5 bg-gradient-to-r from-[#C62828]/25 via-[#B8860B]/20 to-[#C62828]/25 rounded-full blur-md opacity-75 group-hover:opacity-100 transition duration-300"></div>
          <div class="relative w-32 h-32 sm:w-40 sm:h-40 rounded-full bg-white p-2 shadow-2xl border-2 border-[#C62828] overflow-hidden flex items-center justify-center">
            <img 
              src={`${basePath}/assets/logo-eejg.jpeg`} 
              alt="Escuela de Escritores «José Gorostiza» · Logotipo Oficial" 
              class="w-full h-full object-cover rounded-full group-hover:scale-105 transition duration-300"
            />
          </div>
        </div>
      </div>

      <!-- Identidad y Título Monumental Centrado -->
      <div class="space-y-3 max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#C62828]/10 border border-[#C62828]/25 text-[#C62828] font-title text-xs sm:text-sm font-bold uppercase tracking-wider shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#C62828] animate-pulse"></span>
          <span>Filial Académica Oficial · Sociedad de Escritores Letras y Voces de Tabasco, A.C.</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-title font-black text-[#1a1a1a] tracking-tight leading-[1.15]">
          Escuela de Escritores <br class="hidden sm:inline" />
          <span class="text-[#C62828] inline-block whitespace-nowrap">«José Gorostiza»</span>
        </h1>

        <p class="font-serif italic text-lg sm:text-2xl text-[#8D6E63] font-semibold">
          «{IDENTIDAD_ESCUELA.lema}»
        </p>

        <p class="font-sans text-sm sm:text-base text-[#444444] leading-relaxed max-w-2xl mx-auto">
          {IDENTIDAD_ESCUELA.mision}
        </p>
      </div>
      
      <!-- Ficha de Contacto Rápido del Cartel Oficial 2026 -->
      <div class="flex flex-wrap justify-center items-center gap-3 pt-2 text-xs sm:text-sm font-title max-w-3xl mx-auto">
        <span class="px-4 py-2 bg-white rounded-xl border border-[#E6DCCE] shadow-xs text-gray-700 font-medium">
          📍 Villahermosa, Tabasco (Presencial y En Línea · 50% Teoría / 50% Práctica)
        </span>
        <a 
          href={`https://wa.me/${IDENTIDAD_ESCUELA.contactoDirecto.telefonosClean[0]}?text=Hola%20Dra.%20Liliana%20Chuzeville,%20deseo%20informes%20de%20la%20Escuela%20de%20Escritores.`}
          target="_blank"
          rel="noopener"
          class="px-4 py-2 bg-green-50 text-green-800 rounded-xl border border-green-200 shadow-xs hover:bg-green-100 transition flex items-center gap-1.5 font-bold"
        >
          <span>📲 WhatsApp Dir. General: {IDENTIDAD_ESCUELA.contactoDirecto.telefonos[0]}</span>
        </a>
        <a 
          href={`https://wa.me/${IDENTIDAD_ESCUELA.contactoDirecto.telefonosClean[1]}?text=Hola%20Dra.%20Rebeca%20D%C3%ADaz,%20deseo%20información%20académica%20de%20la%20Escuela%20de%20Escritores.`}
          target="_blank"
          rel="noopener"
          class="px-4 py-2 bg-green-50 text-green-800 rounded-xl border border-green-200 shadow-xs hover:bg-green-100 transition flex items-center gap-1.5 font-bold"
        >
          <span>📲 WhatsApp Dir. Académica: {IDENTIDAD_ESCUELA.contactoDirecto.telefonos[1]}</span>
        </a>
        <a 
          href={`mailto:${IDENTIDAD_ESCUELA.contactoDirecto.email}`}
          class="px-4 py-2 bg-white rounded-xl border border-[#E6DCCE] shadow-xs hover:text-[#C62828] transition font-bold"
        >
          ✉️ {IDENTIDAD_ESCUELA.contactoDirecto.email}
        </a>
      </div>

      <div class="w-24 h-1 bg-gradient-to-r from-[#C62828] via-[#B8860B] to-[#C62828] mx-auto mt-6 rounded-full"></div>
    </div>

    <!-- ================================================================= -->
    <!-- 2. DIRECTIVAS DE LA ESCUELA: LILIANA (1ª) Y REBECA (2ª)           -->
    <!-- ================================================================= -->
    <div class="mb-14">
      <div class="text-center max-w-2xl mx-auto mb-8">
        <h3 class="font-title text-xl sm:text-2xl font-bold text-[#222222]">
          Cuerpo Directivo de la Escuela Gorostiza
        </h3>
        <p class="text-xs sm:text-sm text-[#555555] font-serif italic mt-1">
          Liderazgo pedagógico, gestión académica y vinculación institucional.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        
        <!-- 1. Tarjeta: Directora General (Dra. Liliana Chuzeville Córdoba) - PRIMERA -->
        <div class="bg-white rounded-3xl border border-[#E6DCCE] shadow-subtle hover:shadow-elevated transition-all overflow-hidden flex flex-col sm:flex-row group">
          <div class="sm:w-44 aspect-[4/5] sm:aspect-auto overflow-hidden bg-editorial-warm relative shrink-0">
            <img 
              src={`${basePath}/assets/escuela/liliana_chuzeville_cordoba.png`} 
              alt="Dra. Liliana Chuzeville Córdoba - Directora General" 
              class="w-full h-full object-cover object-center grayscale contrast-110 group-hover:scale-103 transition duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent sm:hidden"></div>
          </div>
          <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between space-y-2">
            <div>
              <span class="px-2.5 py-0.5 rounded-full bg-[#F5EFE6] text-[#EF7B38] text-[10px] font-title font-bold uppercase tracking-wider inline-block mb-1">
                Directora General
              </span>
              <h4 class="font-serif text-lg sm:text-xl font-bold text-[#222222] leading-snug">
                Dra. Liliana Chuzeville Córdoba
              </h4>
              <p class="text-xs sm:text-sm text-[#555555] font-sans leading-relaxed mt-1.5">
                Doctora en Criminología, escritora, investigadora y expresidenta de LVT. Galardonada con «Palmas de Oro» y «México en tus manos». Titular de la dirección general y vinculación académica.
              </p>
            </div>
            <div class="pt-3 border-t border-[#E6DCCE] flex items-center justify-between">
              <span class="text-[10px] font-serif italic text-[#B8860B]">Gestión & Vinculación</span>
              <a 
                href="https://wa.me/529932647502?text=Hola%20Dra.%20Liliana%20Chuzeville,%20deseo%20información%20general%20de%20la%20Escuela%20de%20Escritores." 
                target="_blank" 
                rel="noopener noreferrer" 
                class="px-3 py-1 bg-green-50 hover:bg-green-100 text-green-800 border border-green-200 rounded-lg text-xs font-title font-bold transition flex items-center gap-1"
              >
                <span>📲 9932647502</span>
              </a>
            </div>
          </div>
        </div>

        <!-- 2. Tarjeta: Directora Académica (Dra. Rebeca Díaz Suárez) - SEGUNDA -->
        <div class="bg-white rounded-3xl border border-[#E6DCCE] shadow-subtle hover:shadow-elevated transition-all overflow-hidden flex flex-col sm:flex-row group">
          <div class="sm:w-44 aspect-[4/5] sm:aspect-auto overflow-hidden bg-editorial-warm relative shrink-0">
            <img 
              src={`${basePath}/assets/escuela/rebeca_diaz_suarez.png`} 
              alt="Dra. Rebeca Díaz Suárez - Directora Académica" 
              class="w-full h-full object-cover object-center grayscale contrast-110 group-hover:scale-103 transition duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent sm:hidden"></div>
          </div>
          <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between space-y-2">
            <div>
              <span class="px-2.5 py-0.5 rounded-full bg-[#F5EFE6] text-[#EF7B38] text-[10px] font-title font-bold uppercase tracking-wider inline-block mb-1">
                Directora Académica
              </span>
              <h4 class="font-serif text-lg sm:text-xl font-bold text-[#222222] leading-snug">
                Dra. Rebeca Díaz Suárez
              </h4>
              <p class="text-xs sm:text-sm text-[#555555] font-sans leading-relaxed mt-1.5">
                Doctora, poeta, ensayista, promotora cultural y expresidenta de LVT. Catedrática titular de creación lírica, métrica, apreciación literaria y coordinación curricular pedagógica.
              </p>
            </div>
            <div class="pt-3 border-t border-[#E6DCCE] flex items-center justify-between">
              <span class="text-[10px] font-serif italic text-[#B8860B]">Pilar Pedagógico</span>
              <a 
                href="https://wa.me/529931467390?text=Hola%20Dra.%20Rebeca%20Díaz,%20deseo%20información%20académica%20de%20la%20Escuela%20de%20Escritores." 
                target="_blank" 
                rel="noopener noreferrer" 
                class="px-3 py-1 bg-green-50 hover:bg-green-100 text-green-800 border border-green-200 rounded-lg text-xs font-title font-bold transition flex items-center gap-1"
              >
                <span>📲 9931467390</span>
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- ================================================================= -->
    <!-- 3. ORIGEN FUNDACIONAL, ARQ. MARIO DE LILLE Y ALIANZA UJAT         -->
    <!-- ================================================================= -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      
      <!-- Historia y Dirección del Arq. Mario de Lille -->
      <div class="lg:col-span-7 bg-white p-6 sm:p-8 rounded-3xl border border-[#E6DCCE] shadow-subtle flex flex-col justify-between space-y-4">
        <div class="space-y-3">
          <div class="flex flex-wrap items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full bg-[#F5EFE6] text-[#EF7B38] text-[10px] font-title font-bold uppercase tracking-wider">
              Bienio 2001 – 2003
            </span>
            <span class="text-xs text-gray-500 font-mono">
              Patrocinio Histórico: UJAT & ICT (hoy IEC)
            </span>
          </div>

          <h3 class="text-xl sm:text-2xl font-title font-bold text-[#222222]">
            Cimiento Pedagógico & Dirección Fundacional
          </h3>

          <p class="font-sans text-xs sm:text-sm text-[#555555] leading-relaxed">
            Inaugurada formalmente en <strong class="text-[#222222]">septiembre de 2001</strong> con la primera generación del Diplomado en Creación Literaria, la institución fue concebida durante la gestión directiva 2001–2003 de la Sociedad de Escritores «Letras y Voces de Tabasco», A.C.
          </p>

          <p class="font-sans text-xs sm:text-sm text-[#555555] leading-relaxed">
            Su primer director y rector pedagógico fue el insigne <strong class="text-[#222222]">Arquitecto Mario de Lille Fuentes (†)</strong> —novelista, dramaturgo, poeta y pilar fundador primordial de LVT—, quien estructuró los planes de estudio, la metodología de taller colegiado y la visión formativa que ha marcado a más de dos décadas de egresados.
          </p>

          <div class="pt-2 border-t border-[#E6DCCE] space-y-2">
            <span class="text-[11px] font-title font-bold uppercase text-[#EF7B38] tracking-wider block">
              Pioneros y Directivos Históricos de la Escuela:
            </span>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs font-title">
              <div class="p-2.5 rounded-xl bg-[#F5EFE6] border border-[#E6DCCE]">
                <div class="font-bold text-[#222222]">Arq. Mario de Lille (†)</div>
                <div class="text-[10px] text-gray-500">Fundador (2001)</div>
              </div>
              <div class="p-2.5 rounded-xl bg-[#F5EFE6] border border-[#E6DCCE]">
                <div class="font-bold text-[#222222]">Mtra. G. Azuara</div>
                <div class="text-[10px] text-gray-500">Directora Histórica</div>
              </div>
              <div class="p-2.5 rounded-xl bg-[#F5EFE6] border border-[#E6DCCE]">
                <div class="font-bold text-[#222222]">Lic. M. Palacios</div>
                <div class="text-[10px] text-gray-500">Pionero Fundador</div>
              </div>
              <div class="p-2.5 rounded-xl bg-[#F5EFE6] border border-[#E6DCCE]">
                <div class="font-bold text-[#222222]">Mtra. L. Chuzeville</div>
                <div class="text-[10px] text-gray-500">Directora General</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Alianza Estratégica con la UJAT (+24 Años) -->
      <div class="lg:col-span-5 bg-gradient-to-br from-[#1C1814] to-[#25201B] p-6 sm:p-8 rounded-3xl border border-[#3A2E26] text-white shadow-elevated flex flex-col justify-between space-y-4">
        <div class="space-y-3">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#EF7B38] animate-pulse"></span>
            <span class="text-xs font-title font-bold uppercase tracking-widest text-[#F5DEB3]">
              Convenio Interinstitucional Vigente
            </span>
          </div>

          <h3 class="text-xl font-title font-black text-white">
            Alianza Estratégica con la UJAT
          </h3>

          <p class="text-xs sm:text-sm font-serif italic text-gray-300 leading-relaxed">
            Convenio oficial con más de <strong class="text-[#F5DEB3]">24 años de vigencia ininterrumpida</strong>, refrendado públicamente entre el Rector de la UJAT, <strong class="text-white">Lic. Guillermo Narváez Osorio</strong>, y la Directora General de la Escuela, <strong class="text-white">Mtra. Liliana Chuzeville Córdoba</strong>.
          </p>

          <ul class="space-y-2 text-xs sm:text-sm font-sans text-gray-200">
            {IDENTIDAD_ESCUELA.alianzaUjat.beneficios.map((beneficio) => (
              <li class="flex items-start gap-2">
                <span class="text-[#EF7B38] font-bold text-xs">✓</span>
                <span>{beneficio}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="p-3 rounded-2xl bg-black/40 border border-[#3A2E26] text-center">
          <span class="text-[9px] font-title font-bold uppercase tracking-widest text-[#EF7B38] block mb-0.5">
            Plataforma de Práctica Profesional
          </span>
          <span class="text-xs sm:text-sm font-serif italic text-[#F5DEB3]">
            Programa «Emergiendo desde las Palabras» en TV UJAT
          </span>
        </div>
      </div>

    </div>

    <!-- ================================================================= -->
    <!-- 4. OFERTA CURRICULAR COMPLETA 2026: 10 DIPLOMADOS Y 7 CURSOS      -->
    <!-- ================================================================= -->
    <div id="diplomados" class="space-y-6">
      
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 pb-3 border-b border-[#E6DCCE]">
        <div>
          <span class="text-xs font-title font-bold uppercase tracking-widest text-[#EF7B38]">Oferta Académica Estandarizada (Cartel 2026)</span>
          <h3 class="text-xl sm:text-2xl font-title font-bold text-[#222222] mt-0.5">10 Diplomados con Aval Curricular</h3>
        </div>
        <div class="flex items-center gap-2 text-xs sm:text-sm font-title text-[#555555]">
          <span>📋 Metodología: <strong>50% Teoría / 50% Práctica</strong> · Presencial y En Línea</span>
        </div>
      </div>

      <!-- Cuadrícula de los 10 Diplomados -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {DIPLOMADOS_GOROSTIZA.map((d, index) => (
          <div class="bg-white p-5 sm:p-6 rounded-2xl border border-[#E6DCCE] shadow-subtle hover:border-[#EF7B38] hover:shadow-elevated transition-all flex flex-col justify-between space-y-4 group">
            <div class="space-y-3">
              
              <div class="flex justify-between items-start gap-2">
                <span class="px-2.5 py-0.5 rounded-full bg-[#F5EFE6] text-[#EF7B38] text-[10px] font-title font-bold uppercase tracking-wider">
                  Diplomado #{index + 1}
                </span>
                <span class="text-[11px] font-mono text-gray-600 bg-gray-100 px-2 py-0.5 rounded-md font-bold">
                  {d.enfoque}
                </span>
              </div>

              <div>
                <h4 class="text-base sm:text-lg font-title font-black text-[#222222] group-hover:text-[#EF7B38] transition-colors leading-snug">
                  {d.nombre}
                </h4>
                <p class="text-xs sm:text-sm font-serif italic text-[#B8860B] mt-1">{d.perfilEgresado}</p>
              </div>

              <div class="pt-2 border-t border-[#E6DCCE] space-y-1.5 text-xs text-[#555555]">
                <strong class="text-[#222222] font-title text-[10px] uppercase tracking-wider block">Temas Clave:</strong>
                <ul class="space-y-1 list-disc list-inside text-xs text-gray-600">
                  {d.materiasClave.slice(0, 4).map((materia) => (
                    <li class="truncate">{materia}</li>
                  ))}
                </ul>
              </div>

            </div>

            <div class="pt-3 border-t border-[#E6DCCE] flex justify-between items-center text-xs">
              <span class="text-[11px] font-serif italic text-gray-500">Aval UJAT & LVT</span>
              <a 
                href={`https://wa.me/${IDENTIDAD_ESCUELA.contactoDirecto.telefonosClean[0]}?text=Hola,%20deseo%20inscribirme%20o%20solicitar%20información%20del%20${encodeURIComponent(d.nombre)}.`}
                target="_blank" 
                rel="noopener noreferrer" 
                class="px-3.5 py-1.5 rounded-xl bg-[#EF7B38] hover:bg-[#D96620] text-white font-title text-[11px] font-bold uppercase tracking-wider transition shadow-xs"
              >
                Inscribirme →
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>

    <!-- ================================================================= -->
    <!-- 5. CATÁLOGO DE 7 CURSOS CONTINUOS & TALLERES                      -->
    <!-- ================================================================= -->
    <div id="cursos" class="space-y-6 pt-6 border-t border-[#E6DCCE]">
      
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 pb-2">
        <div>
          <span class="text-xs font-title font-bold uppercase tracking-widest text-[#EF7B38]">Formación Temática Breve</span>
          <h3 class="text-xl sm:text-2xl font-title font-bold text-[#222222] mt-0.5">7 Cursos Continuos (50% Teoría / 50% Práctica)</h3>
        </div>
        <span class="text-xs sm:text-sm font-serif italic text-gray-500">Impartidos permanentemente a lo largo del año</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {CURSOS_CONTINUOS_GOROSTIZA.map((c) => (
          <div class="p-4 rounded-2xl bg-white border border-[#E6DCCE] shadow-subtle hover:border-[#EF7B38] transition flex flex-col justify-between space-y-3">
            <div class="space-y-1.5">
              <span class="px-2 py-0.5 rounded-md bg-[#F5EFE6] text-[#EF7B38] text-[9px] font-title font-bold uppercase">
                Curso Continuo
              </span>
              <h4 class="font-title font-bold text-sm text-[#222222]">{c.nombre}</h4>
              <p class="text-xs font-sans text-gray-600 leading-relaxed">{c.descripcion}</p>
            </div>
            <a 
              href={`https://wa.me/${IDENTIDAD_ESCUELA.contactoDirecto.telefonosClean[0]}?text=Hola,%20deseo%20información%20sobre%20el%20${encodeURIComponent(c.nombre)}.`}
              target="_blank"
              rel="noopener"
              class="text-[11px] font-title font-bold uppercase text-[#EF7B38] hover:text-[#D96620] transition-colors block text-right pt-2 border-t border-[#E6DCCE]"
            >
              Pedir Informes &rarr;
            </a>
          </div>
        ))}

        <!-- Tarjeta Insignia: Taller Literario Sabatino UJAT -->
        <div class="p-5 rounded-2xl bg-gradient-to-br from-white to-[#F5EFE6] border-2 border-[#EF7B38]/50 shadow-md flex flex-col justify-between space-y-3 relative overflow-hidden sm:col-span-2">
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-0.5 rounded-md bg-[#EF7B38] text-white text-[9px] font-title font-bold uppercase">
                Presencial · Entrada Gratuita
              </span>
              <span class="text-[10px] font-mono font-bold text-emerald-700">Sábados 9:00 a 11:00 hrs</span>
            </div>
            <h4 class="font-title font-bold text-base text-[#222222]">
              Taller Literario LVT-UJAT (Gratis)
            </h4>
            <p class="text-xs font-serif italic text-gray-500">
              Coordinación: Colegiado de Letras y Voces de Tabasco, A.C.
            </p>
            <p class="text-xs font-sans text-gray-600 leading-relaxed">
              Programa de 24 semanas y 4 módulos (Narrativa, Poesía, Ensayo y Crónica/Edición) en la Librería Universitaria UJAT. Incluye clínica de textos, diálogo respetuoso y publicación en la antología colectiva impresa con aval institucional.
            </p>
          </div>
          <div class="pt-2 border-t border-[#E6DCCE] flex items-center justify-between">
            <span class="text-[10px] font-mono text-gray-500">Sin costo ni inscripción previa</span>
            <a 
              href={`${basePath}/taller-literario`} 
              class="text-xs font-title font-bold uppercase text-[#C62828] hover:text-[#B71C1C] flex items-center gap-1 transition"
            >
              <span>Ver Programa de 24 Sesiones</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Tarjeta de Talleres -->
        <div class="p-4 rounded-2xl bg-[#F5EFE6] border border-[#E6DCCE] flex flex-col justify-between space-y-3">
