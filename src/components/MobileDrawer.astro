---
// MobileDrawer.astro - Panel Lateral Táctil Móvil Institucional LVT (100dvh & 48px Touch Targets)
const basePath = "";
---

<!-- Fondo Oscuro de Bloqueo (Backdrop) -->
<div 
  id="global-mobile-backdrop" 
  class="fixed inset-0 bg-black/80 backdrop-blur-sm z-[99998] opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
  aria-hidden="true"
></div>

<!-- Panel Lateral Deslizable Táctil de Pantalla Completa (Drawer) -->
<aside 
  id="global-mobile-drawer" 
  class="fixed top-0 right-0 bottom-0 w-[88vw] max-w-sm bg-[#12100E]/98 backdrop-blur-2xl z-[99999] shadow-2xl border-l border-white/10 text-white flex flex-col justify-between transform translate-x-full transition-transform duration-300 ease-out lg:hidden h-[100dvh] overscroll-contain"
  role="dialog" 
  aria-modal="true" 
  aria-label="Menú de Navegación Móvil"
>
  
  <!-- 1. Encabezado Fijo del Menú -->
  <div class="p-4 border-b border-white/10 flex items-center justify-between bg-[#191614] shrink-0">
    <div class="flex items-center gap-2.5">
      <img 
        src={`${basePath}/assets/logos/LVT Logo Iso 6 Blanco Relleno.svg`} 
        alt="LVT" 
        class="h-8 w-auto object-contain"
        onerror="this.src='/assets/logos/LVT Logo Iso 1 Original.png'"
      />
      <div>
        <span class="font-swiss font-bold text-xs uppercase tracking-wider text-white block leading-tight">
          Letras y Voces
        </span>
        <span class="text-[10px] font-serif italic text-oro-bright block">
          Sociedad de Escritores, A.C.
        </span>
      </div>
    </div>
    
    <!-- Botón de Cierre Ergonómico (48x48px) -->
    <button 
      id="global-mobile-close-btn" 
      type="button" 
      class="touch-target-48 rounded-2xl bg-white/10 border border-white/15 text-gray-200 hover:text-red-400 hover:bg-white/20 active:scale-95 transition cursor-pointer"
      aria-label="Cerrar menú de navegación"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- 2. Cuerpo Desplazable con Secciones Reestructuradas -->
  <div class="p-4 overflow-y-auto flex-1 space-y-3 font-swiss text-xs font-semibold uppercase tracking-wider">
    
    <!-- TARJETA DESTACADA: ESCRITORES ILUSTRES Y ALTERNADOR DE MODO NOCTURNO -->
    <div class="rounded-2xl p-4 bg-gradient-to-br from-[#EF7B38]/25 via-[#C5A059]/15 to-[#191614] border-2 border-[#EF7B38]/50 shadow-xl space-y-3">
      <div class="flex items-center justify-between">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#EF7B38] text-white text-[10px] font-swiss font-extrabold uppercase tracking-wider shadow-xs">
          🏛️ Patrimonio Literario
        </span>
        <span class="text-[10px] font-mono font-bold text-[#C5A059]">Archivo Histórico</span>
      </div>
      
      <a 
        href={`${basePath}/escritores-ilustres`} 
        class="drawer-nav-item block group"
      >
        <strong class="font-serif font-black text-sm tracking-wide block text-white group-hover:text-[#EF7B38] transition leading-snug normal-case">
          Panteón Canónico de Escritores Ilustres
        </strong>
        <span class="text-[11px] text-gray-300 font-sans normal-case block mt-0.5 leading-relaxed">
          Monografías críticas, obras representativas y retratos de Tabasco, México y el mundo.
        </span>
      </a>

      <div class="pt-2.5 border-t border-white/10 flex items-center justify-between gap-2">
        <a 
          href={`${basePath}/escritores-ilustres`}
          class="drawer-nav-item flex-1 min-h-[44px] py-2.5 px-3 rounded-xl bg-[#EF7B38] hover:bg-[#8F3812] text-white text-center text-xs font-swiss font-bold uppercase tracking-wider active:scale-95 transition shadow-sm flex items-center justify-center gap-1.5"
        >
          <span>Consultar Autores</span>
          <span>→</span>
        </a>
        
        <!-- Alternador Oficial de Modo Nocturno / Diurno -->
        <button 
          type="button" 
          id="drawer-tema-toggle-btn" 
          class="min-h-[44px] px-3 py-2 rounded-xl bg-white/10 hover:bg-white/20 border border-white/15 text-white text-xs font-swiss font-bold flex items-center gap-1.5 transition active:scale-95 cursor-pointer shrink-0"
          aria-label="Alternar tema en menú móvil"
        >
          <span id="drawer-icono-tema" class="text-sm">🌙</span>
          <span id="drawer-texto-tema" class="text-[10px] font-mono uppercase">Modo Nocturno</span>
        </button>
      </div>
    </div>

    <!-- 1. INICIO -->
    <a 
      href={`${basePath}/`} 
      class="drawer-nav-item flex items-center justify-between p-3.5 rounded-2xl bg-white/[0.04] border border-white/10 hover:border-cacao hover:bg-white/[0.08] text-white active:scale-98 transition"
    >
      <span class="font-bold tracking-wide">Inicio</span>
      <span class="text-[10px] text-gray-400 font-mono">01</span>
    </a>

    <!-- 2. QUIÉNES SOMOS (LVT INSTITUCIONAL) -->
    <div class="rounded-2xl bg-white/[0.04] border border-white/10 overflow-hidden">
      <div class="flex items-center justify-between p-3.5 text-white">
        <a href={`${basePath}/historia`} class="drawer-nav-item flex-1">
          <span class="font-bold text-sm tracking-wide block">Quiénes Somos</span>
          <span class="text-[10px] text-gray-400 font-serif italic normal-case block">Identidad & Gobernanza LVT</span>
        </a>
        <button type="button" class="drawer-toggle-sub touch-target-48 p-2 rounded-xl bg-white/10 hover:bg-white/20 text-gray-200 transition cursor-pointer" data-target="sub-quienes-somos" aria-label="Desplegar submenú Quiénes Somos">
          <svg class="w-4 h-4 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>
      </div>

      <div id="sub-quienes-somos" class="p-3 bg-[#0B0A09]/60 border-t border-white/10 space-y-1.5 text-[11px] normal-case hidden">
        <a href={`${basePath}/historia`} class="drawer-nav-item block p-2.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-gray-200 border border-white/5 transition">
          <strong class="text-white block font-swiss uppercase text-[10px] tracking-wider">Historia & Fundadores 1987–2026</strong>
          <span class="text-[10px] text-gray-400">39 años de trayectoria en el sureste mexicano.</span>
        </a>
        <a href={`${basePath}/historia#directiva`} class="drawer-nav-item block p-2.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-gray-200 border border-white/5 transition">
          <strong class="text-white block font-swiss uppercase text-[10px] tracking-wider">Mesa Directiva (2026–2029)</strong>
          <span class="text-[10px] text-gray-400">Presidencia de Juan David Pérez Cabrera y colegiado.</span>
        </a>
        <a href={`${basePath}/historia#solvencia`} class="drawer-nav-item block p-2.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-gray-200 border border-white/5 transition">
          <strong class="text-white block font-swiss uppercase text-[10px] tracking-wider">Solvencia Jurídica & Estatutos</strong>
          <span class="text-[10px] text-gray-400">Registro notarial, ética gremial y facultades.</span>
        </a>
        <a href={`${basePath}/descargas`} class="drawer-nav-item block p-2.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-gray-200 border border-white/5 transition">
          <strong class="text-white block font-swiss uppercase text-[10px] tracking-wider">Convocatorias & Descargas</strong>
          <span class="text-[10px] text-gray-400">Estatutos públicos, formatos de postulación y certámenes.</span>
        </a>
      </div>
    </div>

    <!-- 3. SALA DE LECTURA (CONSOLIDADA) -->
    <div class="rounded-2xl bg-white/[0.04] border border-white/10 overflow-hidden">
      <div class="flex items-center justify-between p-3.5 text-white">
        <a href={`${basePath}/publicaciones`} class="drawer-nav-item flex-1">
          <span class="font-bold text-sm tracking-wide block text-oro-bright">Sala de Lectura</span>
          <span class="text-[10px] text-gray-400 font-serif italic normal-case block">Antologías, Compendios & Fonoteca</span>
        </a>
        <button type="button" class="drawer-toggle-sub touch-target-48 p-2 rounded-xl bg-white/10 hover:bg-white/20 text-gray-200 transition cursor-pointer" data-target="sub-sala-lectura" aria-label="Desplegar submenú Sala de Lectura">
          <svg class="w-4 h-4 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>
      </div>

      <div id="sub-sala-lectura" class="p-3 bg-[#0B0A09]/60 border-t border-white/10 space-y-1.5 text-[11px] normal-case hidden">
        <a href={`${basePath}/publicaciones`} class="drawer-nav-item block p-2.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-gray-200 border border-white/5 transition">
          <strong class="text-white block font-swiss uppercase text-[10px] tracking-wider flex items-center justify-between">
            <span>📚 Fondo Editorial & Antologías</span>
            <span class="text-[9px] text-[#EF7B38]">Oficial</span>
          </strong>
          <span class="text-[10px] text-gray-400">Obras colectivas impresas con registro INDAUTOR e ISBN.</span>
        </a>
        <a href={`${basePath}/escritores-ilustres`} class="drawer-nav-item block p-2.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-gray-200 border border-white/5 transition">
          <strong class="text-white block font-swiss uppercase text-[10px] tracking-wider text-cacao-light">
            🏛️ Escritores Ilustres
          </strong>
          <span class="text-[10px] text-gray-400">Voces de Tabasco, Letras de México y Horizonte Internacional.</span>
        </a>
        <a href={`${basePath}/audioteca`} class="drawer-nav-item block p-2.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-gray-200 border border-white/5 transition">
          <strong class="text-white block font-swiss uppercase text-[10px] tracking-wider text-oro-bright">
            🎙️ Audioteca Lírica MP3
          </strong>
          <span class="text-[10px] text-gray-400">Grabaciones de voz y lecturas de autores representativos.</span>
        </a>
        <a href={`${basePath}/autores`} class="drawer-nav-item block p-2.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-gray-200 border border-white/5 transition">
          <strong class="text-white block font-swiss uppercase text-[10px] tracking-wider">
            ✍️ Padrón Oficial de Escritores
          </strong>
          <span class="text-[10px] text-gray-400">Directorio de miembros y semblanzas activas.</span>
        </a>
      </div>
    </div>

    <!-- 4. FORMACIÓN LITERARIA & TALLER SABATINO -->
    <div class="rounded-2xl bg-white/[0.04] border border-white/10 overflow-hidden">
      <div class="flex items-center justify-between p-3.5 bg-gradient-to-r from-cacao/20 to-transparent text-white">
        <a href={`${basePath}/EEJG`} class="drawer-nav-item flex-1">
          <span class="font-bold text-sm tracking-wide block text-cacao-light">Formación Académica</span>
          <span class="text-[10px] text-gray-400 font-serif italic normal-case block">Escuela de Escritores «José Gorostiza»</span>
        </a>
        <button type="button" class="drawer-toggle-sub touch-target-48 p-2 rounded-xl bg-white/10 hover:bg-white/20 text-cacao-light transition cursor-pointer" data-target="sub-escuela" aria-label="Desplegar submenú Formación">
          <svg class="w-4 h-4 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>
      </div>
      
      <div id="sub-escuela" class="p-3 bg-[#0B0A09]/60 border-t border-white/10 space-y-1.5 text-[11px] normal-case hidden">
        <a href={`${basePath}/taller-literario`} class="drawer-nav-item block p-2.5 rounded-xl bg-cacao/15 hover:bg-cacao/25 text-white border border-cacao/30 transition">
          <strong class="text-white block font-swiss uppercase text-[10px] tracking-wider text-cacao-light flex items-center justify-between">
            <span>📖 Taller Sabatino LVT-UJAT</span>
            <span class="text-[9px] text-emerald-400 font-bold">100% Libre</span>
          </strong>
          <span class="text-[10px] text-gray-300">Sábados 11:00 a 13:00 hrs en Librería Universitaria UJAT.</span>
        </a>
        <a href={`${basePath}/EEJG#diplomados`} class="drawer-nav-item block p-2.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-gray-200 border border-white/5 transition">
          <strong class="text-white block font-swiss uppercase text-[10px] tracking-wider text-cacao-light">10 Diplomados Curriculares</strong>
          <span class="text-[10px] text-gray-400">Creación, Redacción, Periodismo, Guion y Oratoria.</span>
        </a>
        <a href={`${basePath}/EEJG#cursos`} class="drawer-nav-item block p-2.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-gray-200 border border-white/5 transition">
          <strong class="text-white block font-swiss uppercase text-[10px] tracking-wider text-cacao-light">7 Cursos Continuos & Talleres</strong>
          <span class="text-[10px] text-gray-400">Cuento, Poesía, Novela, Ensayo y Ortografía.</span>
        </a>
      </div>
    </div>



  </div>

  <!-- 3. Pie del Menú con Enlaces Oficiales y WhatsApp -->
  <div class="p-4 border-t border-white/10 bg-[#191614] space-y-2.5 shrink-0 pb-[max(1rem,env(safe-area-inset-bottom))]">
    <div class="grid grid-cols-2 gap-2">
      <a 
        href="https://www.facebook.com/letrayvoces.tabasco" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="touch-target-48 flex items-center justify-center gap-2 py-2.5 rounded-2xl bg-[#1877F2]/20 border border-[#1877F2]/40 text-[#1877F2] font-swiss text-[11px] font-bold uppercase tracking-wider hover:bg-[#1877F2] hover:text-white active:scale-95 transition"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        <span>Facebook</span>
      </a>
      <a 
        href="https://www.instagram.com/letrasyvocestabasco" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="touch-target-48 flex items-center justify-center gap-2 py-2.5 rounded-2xl bg-[#E4405F]/20 border border-[#E4405F]/40 text-[#E4405F] font-swiss text-[11px] font-bold uppercase tracking-wider hover:bg-[#E4405F] hover:text-white active:scale-95 transition"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        <span>Instagram</span>
      </a>
    </div>
    <a 
      href="https://wa.me/522205889391?text=Hola%20Sociedad%20de%20Escritores%20LVT%2C%20deseo%20informaci%C3%B3n%20institucional." 
      target="_blank" 
      rel="noopener noreferrer" 
      class="touch-target-48 flex items-center justify-center gap-2 w-full py-3 rounded-2xl bg-cacao hover:bg-cacao-dark text-white font-swiss text-xs font-bold uppercase tracking-wider shadow-lg active:scale-95 transition"
    >
      <span>WhatsApp Oficial LVT (+52 220 588 9391)</span>
    </a>
    <a 
      href="mailto:contacto@letrasyvocesdetabasco.org" 
      class="touch-target-48 flex items-center justify-center w-full py-2.5 rounded-2xl bg-white/10 hover:bg-white/15 text-gray-200 font-swiss text-xs font-bold uppercase tracking-wider active:scale-95 transition border border-white/10"
    >
      contacto@letrasyvocesdetabasco.org
    </a>
  </div>

</aside>

<script is:inline>
  // Control Maestro Global del Menú Móvil Táctil LVT
  (function setupGlobalMobileDrawer() {
    function init() {
      var backdrop = document.getElementById('global-mobile-backdrop');
      var drawer = document.getElementById('global-mobile-drawer');
      var closeBtn = document.getElementById('global-mobile-close-btn');
      var navItems = document.querySelectorAll('.drawer-nav-item');
      var subToggles = document.querySelectorAll('.drawer-toggle-sub');

      if (!backdrop || !drawer) return;

      window.openGlobalMobileNav = function() {
        drawer.classList.remove('translate-x-full');
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
        backdrop.classList.add('opacity-100', 'pointer-events-auto');
        document.body.style.overflow = 'hidden';
      };

      window.closeGlobalMobileNav = function() {
        drawer.classList.add('translate-x-full');
        backdrop.classList.remove('opacity-100', 'pointer-events-auto');
        backdrop.classList.add('opacity-0', 'pointer-events-none');
        document.body.style.overflow = '';
      };

      if (closeBtn) {
        closeBtn.addEventListener('click', window.closeGlobalMobileNav);
      }

      backdrop.addEventListener('click', window.closeGlobalMobileNav);

      navItems.forEach(function(item) {
        item.addEventListener('click', function() {
          setTimeout(window.closeGlobalMobileNav, 120);
        });
      });

      // Despliegue de Acordeones
      subToggles.forEach(function(toggle) {
        toggle.addEventListener('click', function(e) {
          e.stopPropagation();
          var targetId = toggle.getAttribute('data-target');
          var targetEl = document.getElementById(targetId);
          var svg = toggle.querySelector('svg');
          if (targetEl) {
            var isHidden = targetEl.classList.contains('hidden');
            if (isHidden) {
              targetEl.classList.remove('hidden');
              if (svg) svg.classList.add('rotate-180');
            } else {
              targetEl.classList.add('hidden');
              if (svg) svg.classList.remove('rotate-180');
            }
          }
        });
      });

      // Sincronización del Modo Nocturno / Diurno en el Drawer
      var drawerTemaBtn = document.getElementById('drawer-tema-toggle-btn');
      var drawerIcono = document.getElementById('drawer-icono-tema');
      var drawerTexto = document.getElementById('drawer-texto-tema');

      function actualizarDrawerTema() {
        var esNocturno = document.documentElement.classList.contains('modo-nocturno');
        if (drawerTexto) drawerTexto.textContent = esNocturno ? 'Modo Diurno' : 'Modo Nocturno';
        if (drawerIcono) drawerIcono.textContent = esNocturno ? '☀️' : '🌙';
        if (drawerTemaBtn) {
          if (esNocturno) {
            drawerTemaBtn.classList.add('bg-[#EF7B38]/30', 'border-[#EF7B38]');
            drawerTemaBtn.classList.remove('bg-white/10', 'border-white/15');
          } else {
            drawerTemaBtn.classList.remove('bg-[#EF7B38]/30', 'border-[#EF7B38]');
            drawerTemaBtn.classList.add('bg-white/10', 'border-white/15');
          }
        }
      }

      if (drawerTemaBtn) {
        actualizarDrawerTema();
        drawerTemaBtn.addEventListener('click', function() {
          var esNocturnoActual = document.documentElement.classList.contains('modo-nocturno');
          var nuevoEstado = !esNocturnoActual;

          if (nuevoEstado) {
            document.documentElement.classList.add('modo-nocturno');
            document.documentElement.classList.add('modo-lectura');
          } else {
            document.documentElement.classList.remove('modo-nocturno');
            document.documentElement.classList.remove('modo-lectura');
          }

          try {
            localStorage.setItem('lvt-theme', nuevoEstado ? 'nocturno' : 'diurno');
          } catch(e) {}

          actualizarDrawerTema();
          window.dispatchEvent(new CustomEvent('lvt-theme-changed', { detail: { esNocturno: nuevoEstado } }));
        });
      }

      window.addEventListener('lvt-theme-changed', function() {
        actualizarDrawerTema();
      });

      actualizarDrawerTema();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
