---
// src/pages/audioteca.astro - Fonoteca y Archivo Sonoro de 14 Obras Nativas en MP3
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import VocesDeTabasco from '../components/VocesDeTabasco.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const basePath = "";
---

<BaseLayout 
  title="Audioteca Lírica & Archivo Sonoro (14 Obras Nativas) · Sociedad de Escritores LVT"
  description="Fonoteca literaria de Letras y Voces de Tabasco con 14 reproducciones sonoras de poemas de Oliverio Girondo, Juan Rulfo, García Lorca, Jaime Sabines, Pablo Neruda y Julio Cortázar."
>
  <Navbar />

  <main class="pt-16 sm:pt-20">
    <div class="bg-paper-warm border-b border-paper-border py-3">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 text-xs font-swiss tracking-normal text-ink-muted">
        <a href="/" class="hover:text-cacao transition">Inicio</a>
        <span>/</span>
        <span class="text-cacao font-bold">Audioteca Lírica & Archivo Sonoro</span>
      </div>
    </div>

    <VocesDeTabasco />
  </main>

  <Footer />
</BaseLayout>
