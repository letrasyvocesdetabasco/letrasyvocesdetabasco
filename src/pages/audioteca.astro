---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PISTAS, aPistaJSON } from '../lib/voces';
import { porId } from '../lib/escritores';
const lvt = PISTAS.filter((p) => p.origen === 'miembro_lvt'), autores = PISTAS.filter((p) => p.origen !== 'miembro_lvt');
const liricas = PISTAS.filter((p) => p.esLirica).length, narrativas = PISTAS.length - liricas;
const lista = PISTAS.map(aPistaJSON);
const paises = [...new Set(PISTAS.map((p) => p.pais.split('/').pop()!.split(',').pop()!.trim()))];
---
<BaseLayout title="Audioteca · Lírica y narrativa en voz alta · Letras y Voces de Tabasco" description={`${PISTAS.length} grabaciones: poemas y relatos leídos por sus autores y por los miembros de Letras y Voces de Tabasco. Escucha en línea y lee el texto mientras suena.`} image="/assets/galeria/web/presentacion_leyendas_voces_grupal.webp">
  <section class="portada portada-oscura">
    <div class="grano absolute inset-0 -z-10"></div>
    <div class="absolute -left-40 top-10 -z-10 h-[34rem] w-[34rem] rounded-full bg-naranja/20 blur-[140px]"></div>
    <div class="envoltura grid gap-10 py-16 sm:py-24 lg:grid-cols-[1.2fr_1fr] lg:items-end">
      <div>
        <p class="etiqueta etiqueta-clara entra" style="--i:0">Audioteca · {PISTAS.length} grabaciones</p>
        <h1 class="titular-hero entra mt-6 max-w-[11ch]" style="--i:1">La poesía también <em>se escucha.</em></h1>
        <p class="entra mt-6 max-w-xl font-serif text-2xl italic leading-snug text-white/75" style="--i:2">Lírica y narrativa en la voz de sus autores y en las lecturas de la Sociedad. Elige una pista: puedes leer el texto mientras suena y seguir navegando sin que se detenga.</p>
        <div class="entra mt-8 flex flex-wrap gap-3" style="--i:3">
          <button type="button" class="boton-primario" data-todo>▶ Reproducir todo</button>
          <button type="button" class="boton-claro" data-azar>Al azar</button>
        </div>
      </div>
      <div class="borde-luz entra rounded-pieza bg-white/[0.06] p-6 ring-1 ring-white/15 backdrop-blur" style="--i:2" data-ahora>
        <div class="flex items-center justify-between"><p class="etiqueta etiqueta-clara">Ahora suena</p><span class="ondas text-naranja" data-ondas aria-hidden="true"><i></i><i></i><i></i><i></i></span></div>
        <p class="mt-4 font-serif text-2xl italic leading-tight" data-a-titulo>Elige una grabación</p>
        <p class="mt-1 text-sm text-white/60" data-a-autor>{liricas} de lírica · {narrativas} de narrativa</p>
        <div class="mt-5 h-16 overflow-hidden rounded-xl bg-white/5" aria-hidden="true">
          <svg class="h-full w-full text-naranja/70" viewBox="0 0 400 60" preserveAspectRatio="none" data-forma-onda>
            {Array.from({ length: 80 }, (_, i) => { const h = 6 + Math.abs(Math.sin(i * 0.41) * 34 + Math.cos(i * 0.13) * 14); return <rect x={i * 5} y={(60 - h) / 2} width="3" height={h} rx="1.5" fill="currentColor" style={`--k:${i}`} />; })}
          </svg>
        </div>
        <p class="mt-3 text-xs text-white/50">Atajos: <kbd class="rounded bg-white/10 px-1.5">espacio</kbd> pausa · <kbd class="rounded bg-white/10 px-1.5">⇧ →</kbd> adelanta 10 s</p>
      </div>
    </div>
  </section>

  <section class="envoltura mt-10">
    <div class="flex flex-col gap-4 border-y border-linea py-5 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar por género">
        <button type="button" class="chip" data-f="" aria-pressed="true">Todas <span class="ml-1.5 text-tenue numero">{PISTAS.length}</span></button>
        <button type="button" class="chip" data-f="lirica" aria-pressed="false">Lírica <span class="ml-1.5 text-tenue numero">{liricas}</span></button>
        <button type="button" class="chip" data-f="narrativa" aria-pressed="false">Narrativa <span class="ml-1.5 text-tenue numero">{narrativas}</span></button>
        <span class="mx-1 hidden h-6 w-px bg-linea sm:block"></span>
        <button type="button" class="chip" data-f="autor" aria-pressed="false">Voz del autor</button>
        <button type="button" class="chip" data-f="lvt" aria-pressed="false">Voces de LVT</button>
      </div>
      <label class="relative block sm:w-72"><span class="sr-only">Buscar grabación</span>
        <input id="buscar" type="search" placeholder="Buscar título, autor o voz" class="campo !rounded-full !pl-10" />
        <svg class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-tenue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </label>
    </div>
  </section>

  <section class="envoltura py-12">
    {[{ t: 'Voces de Letras y Voces', s: 'Lecturas grabadas por los miembros de la Sociedad', ps: lvt }, { t: 'Voces de los autores', s: 'Grabaciones históricas de poetas y narradores leyendo su obra', ps: autores }].filter((g) => g.ps.length).map((g) => (
      <div class="mb-16" data-grupo>
        <div class="flex flex-wrap items-end justify-between gap-3"><div><h2 class="titular-m">{g.t}</h2><p class="mt-1 text-sm text-grafito">{g.s}</p></div><span class="text-sm text-tenue numero" data-grupo-n>{g.ps.length} pistas</span></div>
        <ol class="mt-6 divide-y divide-linea border-y border-linea">
          {g.ps.map((p) => { const idx = PISTAS.indexOf(p); const a = porId(p.autorId || ''); return (
            <li class="pista scroll-mt-32" id={p.id} data-id={p.id} data-genero={p.esLirica ? 'lirica' : 'narrativa'} data-origen={p.origen === 'miembro_lvt' ? 'lvt' : 'autor'} data-texto={`${p.titulo} ${p.autor} ${p.declamador} ${p.pais}`.toLowerCase()}>
              <div class="grid grid-cols-[3rem_1fr_auto] items-center gap-4 py-4 sm:grid-cols-[3rem_3.5rem_1fr_auto]">
                <button type="button" data-indice={idx} class="reproducir grid h-12 w-12 place-items-center rounded-full bg-tinta text-fondo transition hover:bg-naranja" aria-label={`Escuchar ${p.titulo}`}>
                  <svg class="icono-play h-4 w-4 translate-x-[1px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"/></svg>
                  <svg class="icono-pausa hidden h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 4h4v16H6zM14 4h4v16h-4z"/></svg>
                </button>
                <span class="hidden h-14 w-14 overflow-hidden rounded-xl bg-linea sm:block">{a && <img src={a.foto} alt="" class="retrato h-full w-full object-top" loading="lazy" />}</span>
                <div class="min-w-0">
                  <p class="font-serif text-xl font-medium italic leading-tight">{p.titulo}</p>
                  <p class="mt-0.5 truncate text-sm text-grafito">{a ? <a href={`/escritores/${a.id}`} class="font-semibold text-tinta hover:text-naranja-tinta">{p.autor}</a> : <span class="font-semibold text-tinta">{p.autor}</span>} · {p.declamador}</p>
                </div>
                <div class="flex items-center gap-2 text-xs text-tenue">
                  <span class="chip !py-0.5 !text-[0.65rem]">{p.esLirica ? 'Lírica' : 'Narrativa'}</span>
                  <span class="hidden sm:inline numero" data-dur={p.audioUrl}>—</span>
                  <span class="hidden rounded-full bg-hundido px-2 py-0.5 numero" data-conteo={p.id} title="Reproducciones"></span>
                </div>
              </div>
              {p.textoPoema && (
                <details class="group pb-5 pl-16 sm:pl-[8.5rem]" data-leer>
                  <summary class="inline-flex cursor-pointer list-none items-center gap-2 text-sm font-semibold text-naranja-tinta [&::-webkit-details-marker]:hidden"><span class="transition group-open:rotate-90">›</span> Leer mientras escuchas</summary>
                  <div class="mt-4 max-w-lectura">
                    <p class="whitespace-pre-line font-serif text-lg leading-relaxed text-grafito">{p.textoPoema}</p>
                    <p class="mt-4 text-xs text-tenue">{p.descripcion}</p>
                  </div>
                </details>
              )}
            </li>
          ); })}
        </ol>
      </div>
    ))}
    <p id="sin" class="hidden py-16 text-center text-grafito">Ninguna grabación coincide.</p>
  </section>

  <section class="envoltura">
    <div class="grid gap-6 rounded-[1.75rem] bg-hundido p-8 sm:p-12 lg:grid-cols-[1.4fr_1fr] lg:items-center">
      <div><p class="etiqueta">Graba con nosotros</p><h2 class="titular-l mt-4">Tu voz también cabe aquí</h2><p class="prosa mt-4">Los socios y talleristas pueden grabar la lectura de un poema o relato propio, o de un autor en dominio público, para sumarlo a la audioteca. Grabamos en las sesiones del taller.</p></div>
      <div class="grid gap-3"><a href="/taller-literario#inscripcion" class="boton-oscuro">Quiero grabar una lectura</a><a href="/sala-de-lectura" class="boton-contorno">Textos de dominio público</a></div>
    </div>
  </section>

  <script type="application/json" id="lista-pistas" set:html={JSON.stringify(lista)} />
  <script>
    import { registrarReproduccion, conteoReproducciones, SUPABASE_ACTIVO } from '../lib/supabase';
    function init() {
      const nodo = document.getElementById('lista-pistas'); if (!nodo) return;
      const lista = JSON.parse(nodo.textContent || '[]') as { id: string }[];
      const q = document.getElementById('buscar') as HTMLInputElement, items = [...document.querySelectorAll<HTMLLIElement>('li.pista')];
      let filtro = ''; const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '');
      const visibles = () => items.filter((li) => !li.hidden);
      const aplicar = () => { const t = norm(q.value.toLowerCase()); let n = 0;
        items.forEach((li) => { const ok = (!filtro || li.dataset.genero === filtro || li.dataset.origen === filtro) && (!t || norm(li.dataset.texto!).includes(t)); li.hidden = !ok; if (ok) n++; });
        document.querySelectorAll<HTMLElement>('[data-grupo]').forEach((g) => { const v = g.querySelectorAll('li.pista:not([hidden])').length; g.hidden = v === 0; g.querySelector('[data-grupo-n]')!.textContent = `${v} pistas`; });
        document.getElementById('sin')!.classList.toggle('hidden', n > 0);
        document.querySelectorAll<HTMLButtonElement>('[data-f]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.f === filtro))); };
      document.querySelectorAll<HTMLButtonElement>('[data-f]').forEach((b) => b.addEventListener('click', () => { filtro = b.dataset.f!; aplicar(); }));
      q.addEventListener('input', aplicar);
      const reproducir = (indice: number, alternar = true) => { document.dispatchEvent(new CustomEvent('lvt:reproducir', { detail: { lista, indice, alternar } })); registrarReproduccion(lista[indice].id); };
      document.querySelectorAll<HTMLButtonElement>('.reproducir').forEach((b) => b.addEventListener('click', () => reproducir(Number(b.dataset.indice))));
      document.querySelector('[data-todo]')?.addEventListener('click', () => { const v = visibles(); if (v.length) reproducir(lista.findIndex((p) => p.id === v[0].dataset.id), false); });
      document.querySelector('[data-azar]')?.addEventListener('click', () => { const v = visibles(); const li = v[Math.floor(Math.random() * v.length)]; if (li) { reproducir(lista.findIndex((p) => p.id === li.dataset.id), false); li.scrollIntoView({ behavior: 'smooth', block: 'center' }); } });
      // Estado del reproductor → iconos, «Ahora suena», texto abierto
      const ahora = document.querySelector<HTMLElement>('[data-ahora]')!;
      document.addEventListener('lvt:estado', (e: Event) => {
        const d = (e as CustomEvent).detail as { id: string | null; reproduciendo: boolean };
        items.forEach((li) => { const on = li.dataset.id === d.id; li.classList.toggle('bg-hundido/60', on); const b = li.querySelector('.reproducir')!; b.classList.toggle('bg-naranja', on);
          b.querySelector('.icono-play')!.classList.toggle('hidden', on && d.reproduciendo); b.querySelector('.icono-pausa')!.classList.toggle('hidden', !(on && d.reproduciendo)); });
        const li = items.find((x) => x.dataset.id === d.id);
        if (li) { ahora.dataset.estado = d.reproduciendo ? 'sonando' : 'pausado'; ahora.querySelector('[data-a-titulo]')!.textContent = li.querySelector('.font-serif')!.textContent; ahora.querySelector('[data-a-autor]')!.textContent = li.querySelector('.text-grafito')!.textContent!.trim(); const det = li.querySelector<HTMLDetailsElement>('details[data-leer]'); if (det && d.reproduciendo && !det.dataset.abierto) { det.open = true; det.dataset.abierto = '1'; } }
      });
      document.dispatchEvent(new Event('lvt:consultar'));
      // Duraciones (metadatos) sin descargar el audio completo
      document.querySelectorAll<HTMLElement>('[data-dur]').forEach((el) => { const a = new Audio(); a.preload = 'metadata'; a.src = el.dataset.dur!; a.addEventListener('loadedmetadata', () => { el.textContent = `${Math.floor(a.duration / 60)}:${String(Math.floor(a.duration % 60)).padStart(2, '0')}`; }, { once: true }); });
      // Conteo de reproducciones (si Supabase está activo)
      if (SUPABASE_ACTIVO) conteoReproducciones().then((c) => { document.querySelectorAll<HTMLElement>('[data-conteo]').forEach((el) => { const n = c[el.dataset.conteo!]; if (n) { el.textContent = `${n} ▶`; el.classList.remove('hidden'); } }); });
      // Si llegan con #pista desde otra página, abrimos su texto
      if (location.hash) { const li = document.getElementById(location.hash.slice(1)); li?.querySelector<HTMLDetailsElement>('details')?.setAttribute('open', ''); }
    }
    document.addEventListener('astro:page-load', init);
  </script>
  <style>
    [data-ahora][data-estado="sonando"] [data-forma-onda] rect { animation: latido 1.1s ease-in-out infinite; animation-delay: calc(var(--k) * 23ms); transform-origin: center; transform-box: fill-box; }
    @keyframes latido { 0%, 100% { transform: scaleY(.55); } 50% { transform: scaleY(1.15); } }
    [data-ahora]:not([data-estado="sonando"]) .ondas i { animation-play-state: paused; }
  </style>
</BaseLayout>
