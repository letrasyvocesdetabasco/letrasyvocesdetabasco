---
// src/pages/descargas.astro - Centro de Descargas Documentales, Certámenes y Afiliación de LVT
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import CentroDescargas from '../components/CentroDescargas.astro';
import Convocatorias from '../components/Convocatorias.astro';
import ProcesoMembresia from '../components/ProcesoMembresia.astro';
import GaleriaEventos from '../components/GaleriaEventos.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const basePath = "";
---

<BaseLayout 
  title="Centro de Descargas Documentales, Convocatorias & Afiliación · Sociedad de Escritores LVT"
  description="Descarga de estatutos sociales públicos, formatos de postulación para nuevos socios, directorio de concursos literarios y convocatorias oficiales de LVT, A.C."
>
  <Navbar />

  <main class="pt-16 sm:pt-20">
    <div class="bg-paper-warm border-b border-paper-border py-3">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 text-xs font-swiss tracking-normal text-ink-muted">
        <a href="/" class="hover:text-cacao transition">Inicio</a>
        <span>/</span>
        <span class="text-cacao font-bold">Descargas, Convocatorias & Afiliación</span>
      </div>
    </div>

    <!-- 1. Repositorio de Documentos PDF -->
    <CentroDescargas />

    <!-- 2. Certámenes y Convocatorias Estatales -->
    <Convocatorias />

    <!-- 3. Protocolo de Ingreso y Membresía Gremial -->
    <ProcesoMembresia />

    <!-- 4. Galería y Archivo Gráfico -->
    <GaleriaEventos />
  </main>

  <Footer />
</BaseLayout>
