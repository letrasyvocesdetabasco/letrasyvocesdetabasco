---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LECTURAS, lecturaPorId, palabras } from '../../lib/lecturas';
import { porId } from '../../lib/escritores';
import { PISTAS, aPistaJSON } from '../../lib/voces';
import { SITIO } from '../../lib/sitio';
export async function getStaticPaths() { return LECTURAS.map((l) => ({ params: { id: l.id } })); }
const l = lecturaPorId(Astro.params.id!)!;
const a = porId(l.autorId);
const i = LECTURAS.indexOf(l);
const sig = LECTURAS[(i + 1) % LECTURAS.length], ant = LECTURAS[(i - 1 + LECTURAS.length) % LECTURAS.length];
const mismos = LECTURAS.filter((x) => x.autorId === l.autorId && x.id !== l.id).slice(0, 3);
const pista = PISTAS.find((p) => p.titulo.toLowerCase().includes(l.titulo.toLowerCase().slice(0, 12)) && p.autorId === l.autorId);
const esVerso = l.genero === 'lirica';
const parrafos = esVerso ? [] : l.texto.split(/\n\s*\n/);
const estrofas = esVerso ? l.texto.split(/\n\s*\n/) : [];
const jsonLd = { '@context': 'https://schema.org', '@type': esVerso ? 'Poem' : 'ShortStory', name: l.titulo, author: { '@type': 'Person', name: l.autor }, inLanguage: 'es', isAccessibleForFree: true, license: 'https://es.wikipedia.org/wiki/Dominio_p%C3%BAblico', url: new URL(`/sala-de-lectura/${l.id}`, SITIO).href, wordCount: palabras(l.texto), isPartOf: l.obra };
---
<BaseLayout title={`${l.titulo} · ${l.autor} · Sala de lectura`} description={`${l.titulo}, de ${l.autor} (${l.obra}). Texto íntegro de dominio público para leer en línea en la Sala de lectura de Letras y Voces de Tabasco.`} image={a?.foto} tipo="article" jsonLd={jsonLd}>
  <div id="progreso-lectura"></div>
  <article class="lectura" data-genero={l.genero}>
    <header class="envoltura pt-10 sm:pt-14">
      <nav class="flex flex-wrap items-center gap-2 text-xs text-tenue" aria-label="Migas">
        <a href="/sala-de-lectura" class="hover:text-tinta">Sala de lectura</a><span>/</span><span>{esVerso ? 'Lírica' : 'Narrativa'}</span><span>/</span><span>{l.forma}</span>
      </nav>
      <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
          {a ? <a href={`/escritores/${a.id}`} class="etiqueta entra hover:text-tinta" style="--i:0">{l.autor}</a> : <p class="etiqueta entra">{l.autor}</p>}
          <h1 class="entra mt-4 font-serif text-[2.6rem] font-medium italic leading-[1.05] sm:text-6xl" style="--i:1">{l.titulo}</h1>
          <p class="entra mt-4 text-grafito" style="--i:2">{l.obra}{l.traductor ? ` · Traducción: ${l.traductor}` : ''} · <span class="numero">{l.minutosLectura} min</span> de lectura</p>
        </div>
        {a && <a href={`/escritores/${a.id}`} class="entra group flex items-center gap-4 rounded-pieza border border-linea p-3 pr-5 transition hover:border-naranja" style="--i:2">
          <img src={a.foto} alt={`Retrato de ${a.nombreCorto}`} class="h-16 w-14 rounded-xl object-cover object-top grayscale transition group-hover:grayscale-0" loading="lazy" />
          <span><span class="block text-xs text-tenue">Sobre el autor</span><span class="block font-display font-bold">{a.nombreCorto}</span><span class="block text-xs text-tenue numero">{a.anios}</span></span>
        </a>}
      </div>
    </header>

    <!-- Controles de lectura -->
    <div class="envoltura sticky top-[4.5rem] z-30 mt-10" data-controles>
      <div class="flex flex-wrap items-center gap-2 rounded-full border border-linea bg-fondo/85 px-3 py-2 shadow-suave backdrop-blur-xl">
        <span class="hidden px-2 text-xs font-semibold uppercase tracking-[0.12em] text-tenue sm:inline">Lectura</span>
        <button type="button" class="chip" data-tamano="-" aria-label="Reducir letra">A−</button>
        <button type="button" class="chip" data-tamano="+" aria-label="Aumentar letra">A+</button>
        <button type="button" class="chip" data-fuente aria-pressed="false" title="Cambiar entre serif y sans">Aa</button>
        <button type="button" class="chip" data-interlineado aria-label="Interlineado">↕</button>
        <span class="flex-1"></span>
        {pista && <button type="button" class="chip chip-naranja" data-escuchar={JSON.stringify([aPistaJSON(pista)])}>▶ Escuchar</button>}
        <button type="button" class="chip hidden sm:inline-flex" data-compartir>Compartir</button>
        <button type="button" class="chip hidden sm:inline-flex" onclick="window.print()">Imprimir</button>
      </div>
    </div>

    <div class="envoltura mt-12">
      <div class:list={['texto-lectura mx-auto max-w-[62ch]', esVerso ? 'verso' : 'prosa-larga']} data-texto>
        {esVerso ? estrofas.map((s) => <p class="mb-7 last:mb-0">{s}</p>) : parrafos.map((p) => <p>{p}</p>)}
      </div>
      <footer class="mx-auto mt-14 max-w-[62ch] border-t border-linea pt-6 text-sm text-grafito">
        <p><span class="font-semibold text-tinta">Fuente del texto:</span> <a href={l.fuente} target="_blank" rel="noopener" class="enlace break-all font-normal">{l.fuente.replace(/^https?:\/\//, '')}</a></p>
        <p class="mt-2">Obra en dominio público. {l.notas}</p>
        {a && <p class="mt-6"><a href={`/escritores/${a.id}`} class="enlace">Ver la ficha completa de {a.nombreCorto} →</a></p>}
      </footer>
    </div>

    {mismos.length > 0 && (
      <section class="envoltura mt-20">
        <p class="etiqueta">Del mismo autor</p>
        <ul class="mt-5 grid gap-3 sm:grid-cols-3">
          {mismos.map((m) => <li><a href={`/sala-de-lectura/${m.id}`} class="pieza-viva block p-5"><span class="text-xs text-tenue">{m.forma}</span><span class="mt-1 block font-serif text-lg font-semibold italic leading-tight">{m.titulo}</span></a></li>)}
        </ul>
      </section>
    )}

    <nav class="envoltura mt-16 grid gap-3 sm:grid-cols-2" aria-label="Anterior y siguiente">
      <a href={`/sala-de-lectura/${ant.id}`} class="pieza-viva flex items-center gap-4 p-4"><span class="text-2xl text-naranja">←</span><span><span class="block text-xs text-tenue">Anterior</span><span class="font-serif text-lg font-semibold italic">{ant.titulo}</span><span class="block text-xs text-tenue">{ant.autor}</span></span></a>
      <a href={`/sala-de-lectura/${sig.id}`} class="pieza-viva flex items-center justify-end gap-4 p-4 text-right"><span><span class="block text-xs text-tenue">Siguiente</span><span class="font-serif text-lg font-semibold italic">{sig.titulo}</span><span class="block text-xs text-tenue">{sig.autor}</span></span><span class="text-2xl text-naranja">→</span></a>
    </nav>
  </article>

  <style>
    @media print { header + div[data-controles], nav, footer:not(.lectura footer), #progreso-lectura, #reproductor, a[aria-label="Escríbenos por WhatsApp"], #encabezado { display: none !important; } .texto-lectura { font-size: 13pt !important; } }
  </style>
  <script>
    function init() {
      const root = document.documentElement;
      const pref = (k: string, d: string) => { try { return localStorage.getItem('lvt-lectura-' + k) || d; } catch { return d; } };
      const guardar = (k: string, v: string) => { try { localStorage.setItem('lvt-lectura-' + k, v); } catch {} };
      let tam = Number(pref('tamano', '1.35')), inter = Number(pref('inter', '1.6')), sans = pref('fuente', 'serif') === 'sans';
      const aplicar = () => { root.style.setProperty('--lectura-tamano', tam + 'rem'); root.style.setProperty('--lectura-interlineado', String(inter)); root.style.setProperty('--lectura-fuente', sans ? 'Inter, system-ui, sans-serif' : '"EB Garamond", Georgia, serif'); document.querySelector('[data-fuente]')?.setAttribute('aria-pressed', String(sans)); };
      aplicar();
      document.querySelectorAll<HTMLButtonElement>('[data-tamano]').forEach((b) => b.addEventListener('click', () => { tam = Math.min(2.2, Math.max(1, tam + (b.dataset.tamano === '+' ? 0.1 : -0.1))); guardar('tamano', tam.toFixed(2)); aplicar(); }));
      document.querySelector('[data-fuente]')?.addEventListener('click', () => { sans = !sans; guardar('fuente', sans ? 'sans' : 'serif'); aplicar(); });
      document.querySelector('[data-interlineado]')?.addEventListener('click', () => { inter = inter >= 2 ? 1.4 : +(inter + 0.2).toFixed(1); guardar('inter', String(inter)); aplicar(); });
      document.querySelector<HTMLButtonElement>('[data-compartir]')?.addEventListener('click', async (e) => { const b = e.currentTarget as HTMLButtonElement; try { if (navigator.share) await navigator.share({ title: document.title, url: location.href }); else { await navigator.clipboard.writeText(location.href); b.textContent = 'Copiado'; } } catch {} });
      document.querySelectorAll<HTMLButtonElement>('[data-escuchar]').forEach((b) => b.addEventListener('click', () => document.dispatchEvent(new CustomEvent('lvt:reproducir', { detail: { lista: JSON.parse(b.dataset.escuchar!), indice: 0 } }))));
    }
    document.addEventListener('astro:page-load', init);
  </script>
</BaseLayout>
