---
// src/pages/index.astro - Pórtico Editorial y Portal de Bienvenida Autónomo LVT
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import LanzadoresDashboard from '../components/LanzadoresDashboard.astro';
import EscritoresIlustres from '../components/EscritoresIlustres.astro';
import ProximamenteRevista from '../components/ProximamenteRevista.astro';
import GaleriaEventos from '../components/GaleriaEventos.astro';
import RifaInteractiva from '../components/RifaInteractiva.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<BaseLayout title="Sociedad de Escritores Letras y Voces de Tabasco, A.C. · Portal Oficial">
  <Navbar />
  
  <main>
    <!-- 1. Pórtico de Bienvenida Editorial -->
    <Hero />
    
    <!-- 2. Pabellones y Lanzadores Interactivos a cada Área Especializada -->
    <LanzadoresDashboard />

    <!-- 3. Pabellón de Honor: Panteón Canónico de Escritores Ilustres (30 Autores) -->
    <EscritoresIlustres />

    <!-- 4. Próximamente: Revista Literaria «Letra y Voz» (Efecto Frosted Glass & Blur) -->
    <ProximamenteRevista />

    <!-- 4. Memoria Gráfica & Galería Fotográfica Multi-Evento -->
    <GaleriaEventos />

    <!-- 5. Gran Rifa Cultural Pro-Fondos -->
    <RifaInteractiva />

    <!-- 6. Secretaría General, Correspondencia y Buzón Directo -->
    <Contacto />
  </main>

  <Footer />
</BaseLayout>

