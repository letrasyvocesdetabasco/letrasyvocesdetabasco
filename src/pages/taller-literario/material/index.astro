---
// Índice del material de clase del taller (consulta en línea, sin descarga).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import material from '../../../data/material_taller.json';
import { lecturas } from '../../../lib/taller';
const sesiones = [...material.sesiones].sort((a, b) => b.sesion - a.sesion);
---
<BaseLayout title="Material de clase · Taller literario · Letras y Voces de Tabasco" description="Material de clase del Taller Literario «Letras y Voces» (Librería Universitaria UJAT): diapositivas, fichas de trabajo y cuadernos de lecturas para consultar en línea.">
  <section class="envoltura py-14 sm:py-20">
    <p><a href="/taller-literario" class="enlace text-sm">← Taller literario</a></p>
    <p class="etiqueta mt-6">Taller literario «Letras y Voces» · UJAT</p>
    <h1 class="titular-l mt-4">Material de clase</h1>
    <p class="entradilla mt-5 max-w-2xl">Diapositivas, ficha de trabajo y cuaderno de lecturas de cada sesión, para repasar en casa o ponerse al día. Se consultan en pantalla; no se descargan.</p>
    <ul class="mt-12 grid gap-4 md:grid-cols-2">
      {sesiones.map((s) => (
        <li>
          <a href={`/taller-literario/material/sesion-${s.sesion}`} class="pieza group block p-6 transition hover:shadow-alta sm:p-7">
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-tenue">Sesión {s.sesion} · Módulo {s.modulo}</p>
            <h2 class="mt-2 font-serif text-[1.45rem] font-medium leading-snug">{s.titulo}</h2>
            <p class="mt-2 text-sm text-grafito">{lecturas(s as any).map((x) => x.autor).join(' · ')}</p>
            <p class="mt-4 text-sm font-semibold text-naranja-tinta">{s.documentos.map((d) => d.titulo).join(' · ')} <span aria-hidden="true">→</span></p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
