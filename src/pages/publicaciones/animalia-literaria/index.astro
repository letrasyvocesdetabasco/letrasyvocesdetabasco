---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ANIMALIA, INDICE_ANIMALIA, TEXTOS_ANIMALIA, AUTORES_ANIMALIA } from '../../../data/animalia';
import { personaPorNombre, iniciales } from '../../../lib/personas';
import { wa, SITIO } from '../../../lib/sitio';

const A = ANIMALIA;
const narrativa = TEXTOS_ANIMALIA.filter((t) => t.parte === 'narrativa');
const lirica = TEXTOS_ANIMALIA.filter((t) => t.parte === 'lirica');
const autores = AUTORES_ANIMALIA.map((nombre) => ({ nombre, socio: personaPorNombre(nombre), textos: TEXTOS_ANIMALIA.filter((t) => t.autor === nombre) }));
const liliana = personaPorNombre(A.prologuista);
const prologo = INDICE_ANIMALIA.find((e) => e.titulo === 'Prólogo')!;
const abierta = A.lecturaAbierta;
const Enlace = abierta ? 'a' : 'div';
const enlace = (p: number) => (abierta ? { href: `${A.lector}?p=${p}` } : {});
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Book', name: `${A.titulo}: ${A.subtitulo}`, url: new URL(A.ficha, SITIO).href,
  image: new URL(A.portada, SITIO).href, inLanguage: 'es', bookFormat: 'https://schema.org/Paperback', numberOfPages: 131, datePublished: '2026-08',
  bookEdition: 'Primera edición', genre: ['Narrativa', 'Poesía', 'Antología'], ...(abierta ? { isAccessibleForFree: true } : {}),
  editor: { '@type': 'Person', name: A.compilador }, publisher: { '@type': 'Organization', name: A.sello },
  author: AUTORES_ANIMALIA.map((n) => ({ '@type': 'Person', name: n })), description: A.contraportada[0],
  ...(abierta ? { potentialAction: { '@type': 'ReadAction', target: new URL(A.lector, SITIO).href } } : {}),
};
---
<BaseLayout title="Animalia Literaria (2026) · Antología de narrativa y lírica · Letras y Voces de Tabasco" description="Animalia Literaria: diecinueve textos de dieciséis autores sobre el reino animal. Impresa en agosto de 2026 por Letras y Voces de Tabasco; presentación y lectura en línea, próximamente." image={A.imagenSocial} tipo="book" jsonLd={jsonLd}>
  <!-- PORTADA -->
  <section class="relative isolate overflow-hidden bg-[#0b3b47] text-white">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_20%_40%,rgb(196_154_60/0.35),transparent_55%),radial-gradient(ellipse_at_90%_100%,rgb(239_123_56/0.25),transparent_50%)]"></div>
    <div class="grano absolute inset-0 -z-10"></div>
    <div class="envoltura grid gap-12 py-14 sm:py-20 lg:grid-cols-[0.95fr_1.1fr] lg:items-center lg:gap-16 lg:py-24">
      <div class="entra flex justify-center lg:justify-start" style="--i:0">
        <Enlace {...(abierta ? { href: A.lector, 'aria-label': 'Abrir el libro en el lector en línea' } : {})} class="libro3d" data-libro3d>
          <span class="libro3d-cuerpo">
            <img src={A.portada} alt="Portada de Animalia Literaria, antología de Letras y Voces de Tabasco, edición 2026" class="libro3d-frente" width="1200" height="1840" fetchpriority="high" />
            <span class="libro3d-brillo" aria-hidden="true"></span>
          </span>
          <span class="libro3d-sombra" aria-hidden="true"></span>
        </Enlace>
      </div>
      <div>
        <nav class="entra flex flex-wrap items-center gap-2 text-xs text-white/60" aria-label="Migas" style="--i:0"><a href="/publicaciones" class="hover:text-white">Publicaciones</a><span>/</span><span>Fondo contemporáneo</span></nav>
        <p class="entra mt-6 inline-flex items-center gap-2.5 rounded-full bg-white/10 px-4 py-2 text-xs font-semibold uppercase tracking-[0.14em] text-[#f0d28a] ring-1 ring-white/15" style="--i:1"><span class="relative flex h-2.5 w-2.5"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#f0d28a] opacity-70"></span><span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[#f0d28a]"></span></span>Impreso · presentación próximamente</p>
        <h1 class="titular-hero entra mt-6 !text-[clamp(2.8rem,6.4vw,5.6rem)]" style="--i:2">Animalia <em class="!text-[#f0d28a]">Literaria</em></h1>
        <p class="entra mt-3 font-serif text-2xl italic text-white/80" style="--i:3">{A.subtitulo}</p>
        <p class="entra mt-6 max-w-xl text-[1.06rem] leading-relaxed text-white/80" style="--i:4">{A.contraportada[0]}</p>
        <dl class="entra mt-8 grid max-w-lg grid-cols-4 gap-4 border-y border-white/15 py-5" style="--i:5">
          {[[TEXTOS_ANIMALIA.length, 'textos'], [AUTORES_ANIMALIA.length, 'autores'], [131, 'páginas'], [2, 'géneros']].map(([n, t]) => <div><dd class="font-display text-3xl font-extrabold leading-none numero sm:text-4xl">{n}</dd><dt class="mt-1 text-xs text-white/55">{t}</dt></div>)}
        </dl>
        <div class="entra mt-8 flex flex-wrap gap-3" style="--i:6">
          {abierta ? (
            <a href={A.lector} class="boton-primario !min-h-[54px] !px-7 !text-base">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 5.5C5 4 8.5 4 12 6c3.5-2 7-2 10-.5V19c-3-1.5-6.5-1.5-10 .5-3.5-2-7-2-10-.5Z"/><path d="M12 6v13.5"/></svg>
              Leer en línea, gratis
            </a>
          ) : (
            <a href="/boletin" class="boton-primario !min-h-[54px] !px-7 !text-base">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 5.5C5 4 8.5 4 12 6c3.5-2 7-2 10-.5V19c-3-1.5-6.5-1.5-10 .5-3.5-2-7-2-10-.5Z"/><path d="M12 6v13.5"/></svg>
              Avísenme de la presentación
            </a>
          )}
          <a href={wa('Hola, me interesa un ejemplar impreso de «Animalia Literaria».')} target="_blank" rel="noopener" class="boton-claro !min-h-[54px] !px-7 !text-base">Quiero un ejemplar</a>
        </div>
        <p class="entra mt-5 text-sm text-white/55" style="--i:7">{abierta ? 'Edición completa para leer en pantalla. No está disponible para descarga.' : 'Lectura en línea, próximamente: se abrirá después de la presentación del libro.'}</p>
      </div>
    </div>
  </section>

  <!-- EPÍGRAFE -->
  <section class="envoltura py-20 sm:py-28">
    <figure class="mx-auto max-w-4xl text-center">
      <blockquote class="cita-gigante aparece !text-[clamp(1.6rem,3.4vw,2.9rem)]">«{A.epigrafe}»</blockquote>
      <figcaption class="mt-8 flex items-center justify-center gap-4 text-grafito"><span class="h-px w-12 bg-naranja"></span>Epígrafe de la antología<span class="h-px w-12 bg-naranja"></span></figcaption>
    </figure>
  </section>

  <!-- ÍNDICE -->
  <section id="indice" class="bg-hundido py-20 sm:py-24">
    <div class="envoltura">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div><p class="etiqueta">Índice general</p><h2 class="titular-l mt-4">Diecinueve textos, dos caminos</h2></div>
        {abierta ? <a href={`${A.lector}?p=${prologo.pagina}`} class="boton-contorno">Empezar por el prólogo</a> : <span class="chip chip-naranja !py-2">Lectura en línea: próximamente</span>}
      </div>
      <div class="mt-12 grid gap-10 lg:grid-cols-2">
        {[{ t: 'Parte I · Narrativa', l: narrativa }, { t: 'Parte II · Lírica', l: lirica }].map((g) => (
          <div>
            <h3 class="border-b border-linea pb-3 font-display text-sm font-bold uppercase tracking-[0.14em] text-grafito">{g.t}</h3>
            <ol class="divide-y divide-linea">
              {g.l.map((e, k) => (
                <li class="aparece" style={`--i:${k % 8}`}>
                  <Enlace {...enlace(e.pagina)} class="group grid grid-cols-[2.2rem_1fr_auto] items-baseline gap-3 py-4 transition hover:bg-superficie/60">
                    <span class="font-display text-sm font-extrabold text-naranja-tinta numero">{String(e.n).padStart(2, '0')}</span>
                    <span class="min-w-0"><span class="block font-serif text-[1.3rem] font-medium italic leading-tight group-hover:text-naranja-tinta">{e.titulo}</span><span class="block truncate text-sm text-grafito">{e.autor}</span></span>
                    <span class="flex items-center gap-2 text-xs text-tenue"><span class="numero">p. {e.paginaImpresa}</span>{abierta && <span class="font-display font-bold text-naranja-tinta opacity-0 transition group-hover:translate-x-0.5 group-hover:opacity-100">Leer →</span>}</span>
                  </Enlace>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AUTORES -->
  <section class="envoltura py-20 sm:py-24">
    <p class="etiqueta">Las voces del libro</p>
    <h2 class="titular-l mt-4 max-w-[20ch]">Dieciséis autores, una misma mirada atenta</h2>
    <p class="prosa mt-4">Socios de Letras y Voces, talleristas y autores invitados de Tabasco y de otros estados. Quienes forman parte del padrón tienen su ficha en la sección de autores.</p>
    <ul class="mt-12 grid grid-cols-2 gap-x-5 gap-y-8 sm:grid-cols-3 lg:grid-cols-4">
      {autores.map((x, i) => (
        <li class="aparece" style={`--i:${i % 8}`}>
          <a href={x.socio ? `/autores#${x.socio.id}` : abierta ? `${A.lector}?p=${x.textos[0].pagina}` : '#indice'} class="group flex items-center gap-4">
            {x.socio?.foto
              ? <img src={x.socio.foto} alt={`Retrato de ${x.nombre}`} loading="lazy" class="retrato h-20 w-16 shrink-0 rounded-xl object-top group-hover:grayscale-0" width="160" height="200" />
              : <span class="grid h-20 w-16 shrink-0 place-items-center rounded-xl bg-[#0b3b47] font-display text-lg font-bold text-[#f0d28a]">{iniciales(x.nombre)}</span>}
            <span class="min-w-0">
              <span class="block font-display text-[0.98rem] font-bold leading-tight group-hover:text-naranja-tinta">{x.nombre}</span>
              <span class="mt-1 block font-serif text-sm italic leading-snug text-grafito">{x.textos.map((t) => t.titulo).join(' · ')}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- PRÓLOGO -->
  <section class="bg-noche py-20 text-white sm:py-24">
    <div class="envoltura grid gap-12 lg:grid-cols-[1fr_1.5fr] lg:items-center">
      <div class="flex items-center gap-5">
        {liliana?.foto && <img src={liliana.foto} alt={`Retrato de ${A.prologuista}`} class="h-40 w-32 rounded-pieza object-cover object-top grayscale" loading="lazy" />}
        <div><p class="etiqueta etiqueta-clara">Prólogo</p><p class="mt-3 font-display text-2xl font-bold leading-tight">{A.prologuista}</p><p class="mt-1 text-sm text-white/60">Delegada Emérita de Letras y Voces de Tabasco</p></div>
      </div>
      <div>
        <p class="font-serif text-[1.45rem] leading-snug text-white/85 sm:text-[1.65rem]">«{A.prologoInicio}»</p>
        {abierta && <a href={`${A.lector}?p=${prologo.pagina}`} class="enlace-vivo mt-6 inline-block font-display text-sm font-bold text-naranja">Seguir leyendo el prólogo →</a>}
      </div>
    </div>
  </section>

  <!-- FICHA Y PRESENTACIÓN -->
  <section class="envoltura grid gap-10 py-20 sm:py-24 lg:grid-cols-[1.2fr_1fr]">
    <div>
      <p class="etiqueta">Ficha técnica</p>
      <h2 class="titular-m mt-4">Un libro hecho con oficio</h2>
      <dl class="mt-8 grid gap-px overflow-hidden rounded-pieza border border-linea bg-linea sm:grid-cols-2">
        {A.fichaTecnica.map(([k, v]) => <div class="bg-superficie p-5"><dt class="text-xs font-semibold uppercase tracking-[0.12em] text-tenue">{k}</dt><dd class="mt-1 font-display font-bold">{v}</dd></div>)}
        <div class="bg-superficie p-5 sm:col-span-2"><dt class="text-xs font-semibold uppercase tracking-[0.12em] text-tenue">Compilación, diseño editorial y cuidado de la edición</dt><dd class="mt-1 font-display font-bold">{A.compilador}</dd></div>
        <div class="bg-superficie p-5 sm:col-span-2"><dt class="text-xs font-semibold uppercase tracking-[0.12em] text-tenue">Sello editorial</dt><dd class="mt-1 font-display font-bold">{A.sello}</dd></div>
      </dl>
      <p class="mt-6 font-serif text-lg italic text-grafito">{A.colofon} <span class="not-italic text-sm text-tenue">— Colofón</span></p>
    </div>
    <div class="grid content-start gap-5">
      <div class="relative overflow-hidden rounded-[1.5rem] bg-naranja p-8 text-white">
        <img src="/assets/logos/LVT Logo Iso 6 Blanco Relleno.svg" alt="" aria-hidden="true" class="flota pointer-events-none absolute -right-10 -top-10 w-56 opacity-15" />
        <p class="etiqueta etiqueta-clara !text-white/85 before:!bg-white">Primera presentación</p>
        <h3 class="mt-4 font-display text-2xl font-extrabold leading-tight">Muy pronto anunciaremos fecha y sede</h3>
        <p class="mt-3 text-white/90">Los autores leerán fragmentos de sus textos y habrá ejemplares disponibles. Si quieres que te avisemos, escríbenos.</p>
        <a href={wa('Hola, quiero que me avisen de la presentación de «Animalia Literaria».')} target="_blank" rel="noopener" class="boton mt-6 bg-white text-carbon hover:bg-carbon hover:text-white">Avísenme por WhatsApp</a>
      </div>
      <div class="pieza p-7">
        <p class="etiqueta">Lectura en línea</p>
        {abierta ? (
          <>
            <p class="mt-3 text-grafito">La edición completa, con sus 133 páginas e ilustraciones al óleo, puede leerse gratis en pantalla. Por respeto a los derechos de los autores, el libro no se ofrece para descarga.</p>
            <a href={A.lector} class="boton-oscuro mt-5">Abrir el libro</a>
          </>
        ) : (
          <>
            <p class="mt-3 font-display text-lg font-bold">Próximamente</p>
            <p class="mt-2 text-grafito">Después de la presentación, la edición completa con sus ilustraciones al óleo podrá leerse gratis en pantalla. Suscríbete al boletín y te avisamos el día que se abra.</p>
            <a href="/boletin" class="boton-oscuro mt-5">Suscribirme al boletín</a>
          </>
        )}
      </div>
    </div>
  </section>

  <style>
    .libro3d { --w: clamp(14rem, 28vw, 20rem); position: relative; display: block; width: var(--w); aspect-ratio: 1200 / 1840; perspective: 1600px; }
    .libro3d-cuerpo { position: absolute; inset: 0; transform-style: preserve-3d; transform: rotateY(-20deg) rotateX(4deg); transform-origin: 40% 50%; transition: transform 1s cubic-bezier(.16,1,.3,1); }
    .libro3d:hover .libro3d-cuerpo, .libro3d:focus-visible .libro3d-cuerpo { transform: rotateY(-6deg) rotateX(2deg) translateY(-6px); }
    .libro3d-frente { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 2px 7px 7px 2px;
      box-shadow: 3px 2px 0 -1px #f6f0e4, 5px 4px 0 -1px #ddd3c1, 7px 6px 0 -2px #f6f0e4, 9px 8px 0 -2px #d8ccb7, 11px 10px 0 -3px #f3ecdf, 13px 12px 0 -3px #cfc2ab, 40px 50px 70px -25px rgb(0 0 0 / .75); }
    .libro3d-cuerpo::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 7%; z-index: 2; border-radius: 2px 0 0 2px; pointer-events: none;
      background: linear-gradient(90deg, rgb(0 0 0 / .35), rgb(255 255 255 / .18) 35%, rgb(0 0 0 / .12) 60%, transparent); }
    .libro3d-brillo { position: absolute; inset: 0; z-index: 3; background: linear-gradient(105deg, rgb(255 255 255 / 0) 30%, rgb(255 255 255 / .2) 45%, rgb(255 255 255 / 0) 60%); background-size: 250% 100%; background-position: 120% 0; transition: background-position 1.2s cubic-bezier(.16,1,.3,1); border-radius: 2px 7px 7px 2px; pointer-events: none; }
    .libro3d:hover .libro3d-brillo { background-position: -40% 0; }
    .libro3d-sombra { position: absolute; left: 6%; right: -8%; bottom: -5%; height: 8%; background: radial-gradient(ellipse at center, rgb(0 0 0 / .5), transparent 70%); filter: blur(10px); z-index: -1; }
    @media (prefers-reduced-motion: reduce) { .libro3d-cuerpo, .libro3d-brillo { transition: none; } }
  </style>
  <script>
    function init() {
      const l = document.querySelector<HTMLElement>('[data-libro3d]'); if (!l || !matchMedia('(hover:hover)').matches || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const c = l.querySelector<HTMLElement>('.libro3d-cuerpo')!;
      l.addEventListener('pointermove', (e) => { const r = l.getBoundingClientRect(); const x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5; c.style.transform = `rotateY(${-10 + x * 18}deg) rotateX(${3 - y * 8}deg)`; });
      l.addEventListener('pointerleave', () => { c.style.transform = ''; });
    }
    document.addEventListener('astro:page-load', init);
  </script>
</BaseLayout>
