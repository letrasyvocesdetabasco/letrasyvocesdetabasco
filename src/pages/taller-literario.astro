                        {modulo.nombre}
                      </h3>
                    </div>
                  </div>

                  <div class="px-4 py-2 rounded-xl bg-paper-warm border border-paper-border text-xs font-swiss text-ink">
                    <strong class="text-cacao block text-[10px] uppercase">Producto Entregable:</strong>
                    <span>{modulo.productoEntregable}</span>
                  </div>
                </div>

                <p class="text-sm sm:text-base text-ink-muted font-sans leading-relaxed">
