      .module-panel {
        display: block !important;
        page-break-after: always;
      }
      .session-card {
        page-break-inside: avoid;
        box-shadow: none !important;
        border: 1px solid #ccc !important;
      }
    }
  </style>

  <!-- SCRIPT CLIENT-SIDE PARA BÚSQUEDA EN TIEMPO REAL Y CONMUTADOR FLUIDO -->
  <script is:inline>
    let currentActiveModule = 'narrativa';

    function showModule(moduleId) {
      currentActiveModule = moduleId;
      document.querySelectorAll('.module-panel').forEach(panel => {
        panel.classList.add('hidden');
      });

      const activePanel = document.getElementById(`panel-${moduleId}`);
      if (activePanel) {
        activePanel.classList.remove('hidden');
      }

      document.querySelectorAll('.mod-tab-btn').forEach(btn => {
        btn.classList.remove('bg-cacao', 'text-white', 'border-cacao', 'shadow-elevated', 'scale-102');
        btn.classList.add('bg-paper-card', 'text-ink-muted', 'border-paper-border');
      });

      const activeBtn = document.getElementById(`tab-mod-${moduleId}`);
      if (activeBtn) {
        activeBtn.classList.remove('bg-paper-card', 'text-ink-muted', 'border-paper-border');
        activeBtn.classList.add('bg-cacao', 'text-white', 'border-cacao', 'shadow-elevated', 'scale-102');
      }
    }

    function filterTallerSessions(query) {
      const q = (query || '').trim().toLowerCase();
      const clearBtn = document.getElementById('clear-search-btn');
      const countEl = document.getElementById('search-results-count');
      const tabsBar = document.getElementById('module-tabs-bar');
      const panels = document.querySelectorAll('.module-panel');
      const cards = document.querySelectorAll('.session-card');

      if (!q) {
        clearTallerSearch();
        return;
      }

      if (clearBtn) clearBtn.classList.remove('hidden');
      if (tabsBar) tabsBar.classList.add('opacity-40', 'pointer-events-none');

      let matches = 0;
      panels.forEach(p => p.classList.remove('hidden'));

      cards.forEach(card => {
        const text = card.getAttribute('data-search') || '';
        if (text.includes(q)) {
          card.classList.remove('hidden');
          card.classList.add('ring-2', 'ring-cacao/40');
          matches++;
        } else {
          card.classList.add('hidden');
          card.classList.remove('ring-2', 'ring-cacao/40');
        }
      });

      if (countEl) {
        countEl.classList.remove('hidden');
        countEl.textContent = `${matches} sesión${matches === 1 ? '' : 'es'} encontrada${matches === 1 ? '' : 's'}`;
      }
    }

    function clearTallerSearch() {
      const input = document.getElementById('taller-search-input');
      if (input) input.value = '';
      const clearBtn = document.getElementById('clear-search-btn');
      if (clearBtn) clearBtn.classList.add('hidden');
      const countEl = document.getElementById('search-results-count');
      if (countEl) countEl.classList.add('hidden');
      const tabsBar = document.getElementById('module-tabs-bar');
      if (tabsBar) tabsBar.classList.remove('opacity-40', 'pointer-events-none');

      document.querySelectorAll('.session-card').forEach(card => {
        card.classList.remove('hidden', 'ring-2', 'ring-cacao/40');
      });

      showModule(currentActiveModule);
    }

    function showToast(msg) {
      const toast = document.getElementById('taller-toast');
      const textEl = document.getElementById('toast-message');
      if (!toast || !textEl) return;
      textEl.textContent = msg;
      toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
      toast.classList.add('translate-y-0', 'opacity-100');
      setTimeout(() => {
        toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
        toast.classList.remove('translate-y-0', 'opacity-100');
      }, 3200);
    }

    function copySessionCard(semana, titulo, teoria, lecturas, ejercicio) {
      const text = `📖 *TALLER LITERARIO LVT-UJAT (GRATIS) · SEMANA ${semana}*\n` +
        `🏛️ *Sesión:* ${titulo}\n\n` +
        `💡 *Eje Teórico:* ${teoria}\n\n` +
        `📚 *Lecturas Canónicas:* ${lecturas}\n\n` +
        `✍️ *Gimnasio Creativo:* ${ejercicio}\n\n` +
        `📍 *Sábados 11:00 a 13:00 hrs* · Librería Universitaria UJAT (Entrada libre y gratuita)\n` +
        `🌐 *Más detalles:* https://letrasyvocesdetabasco.org/taller-literario`;

      navigator.clipboard.writeText(text).then(() => {
        showToast(`✅ Temario de Semana ${semana} copiado al portapapeles`);
      }).catch(() => {
        showToast("⚠️ No se pudo copiar al portapapeles");
      });
    }
  </script>
</BaseLayout>
