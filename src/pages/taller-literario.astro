---
import BaseLayout from '../layouts/BaseLayout.astro';
import SesionTaller from '../components/sitio/SesionTaller.astro';
import { DATOS_GENERALES_TALLER as T } from '../data/taller';
import { TALLER, SESIONES, modulos, fechaLarga, lecturas, sesionVigente } from '../lib/taller';
import { CONTACTO, wa } from '../lib/sitio';

const mods = modulos();
const { proxima } = sesionVigente();
const recesos = TALLER.calendario.filter((s) => !s.sesion);
const preguntas = [
  ['¿Cuánto cuesta?', 'Nada. El taller es gratuito y abierto; no hay inscripción ni requisitos de admisión.'],
  ['¿Puedo llegar a mitad del ciclo?', 'Sí. Cada sábado es una sesión completa: lectura, ejercicio y clínica de textos. Puedes llegar a cualquiera.'],
  ['¿Necesito haber publicado o tener experiencia?', 'No. Hay quienes escriben desde hace años y quienes empiezan. La mesa es intergeneracional.'],
  ['¿Qué debo llevar?', 'Libreta o computadora, y si quieres, un texto tuyo para leer en voz alta en la clínica.'],
  ['¿Hay constancia?', 'Quienes asisten de manera regular reciben constancia de Letras y Voces de Tabasco y la Librería Universitaria UJAT, y pueden participar en la antología del taller.'],
  ['¿Qué pasa en vacaciones?', `Seguimos el calendario escolar de la UJAT: no hay sesión el ${recesos.map((r) => fechaLarga(r.fecha, false)).join(' ni el ')}.`],
];
---
<BaseLayout title="Taller literario gratuito · Letras y Voces de Tabasco" description="Taller literario gratuito todos los sábados de 11:00 a 13:00 h en la Librería Universitaria UJAT, Villahermosa. Narrativa, poesía, ensayo y crónica en 24 sesiones.">
  <section class="relative overflow-hidden border-b border-linea">
    <div class="envoltura grid gap-12 py-14 sm:py-20 lg:grid-cols-[1.3fr_1fr] lg:items-center">
      <div>
        <p class="etiqueta">Taller literario «Letras y Voces» · UJAT</p>
        <h1 class="titular-xl mt-6 max-w-[13ch]">Escribir se aprende en la mesa.</h1>
        <p class="entradilla mt-6">{T.lemaPedagogico}. Cada sábado leemos a un autor, escribimos en el aula y comentamos los textos con respeto y técnica.</p>
        <dl class="mt-10 grid max-w-xl grid-cols-2 gap-x-6 gap-y-5 border-t border-linea pt-6">
          <div><dt class="text-xs font-semibold uppercase tracking-[0.14em] text-tenue">Cuándo</dt><dd class="mt-1 font-display font-bold">Sábados, 11:00 a 13:00 h</dd></div>
          <div><dt class="text-xs font-semibold uppercase tracking-[0.14em] text-tenue">Costo</dt><dd class="mt-1 font-display font-bold">Gratis, sin inscripción</dd></div>
          <div class="col-span-2"><dt class="text-xs font-semibold uppercase tracking-[0.14em] text-tenue">Dónde</dt><dd class="mt-1 font-display font-bold">{CONTACTO.sedeTaller} <a href={CONTACTO.mapaTaller} target="_blank" rel="noopener" class="enlace ml-1 font-sans text-sm">Ver mapa</a></dd></div>
        </dl>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#inscripcion" class="boton-primario">Quiero participar</a>
          <a href="#calendario" class="boton-contorno">Ver el calendario completo</a>
        </div>
      </div>
      <div class="relative">
        <img src="/assets/galeria/web/evento_cacao_04.webp" alt="Lectura en voz alta durante una actividad de Letras y Voces" class="mb-5 aspect-[16/10] w-full rounded-pieza object-cover grayscale" loading="eager" />
        <SesionTaller />
      </div>
    </div>
  </section>

  <!-- SESIÓN -->
  <section class="envoltura py-20 sm:py-24">
    <p class="etiqueta">Cómo es una sesión</p>
    <h2 class="titular-l mt-4 max-w-[20ch]">Dos horas, tres momentos</h2>
    <ol class="mt-12 grid gap-px overflow-hidden rounded-pieza border border-linea bg-linea md:grid-cols-3">
      {T.estructuraTriadica.map((b, i) => (
        <li class="bg-superficie p-7 sm:p-8">
          <div class="flex items-baseline justify-between">
            <span class="font-display text-5xl font-extrabold text-naranja numero">{i + 1}</span>
            <span class="rounded-full bg-hundido px-3 py-1 text-xs font-semibold text-grafito numero">{b.duracion}</span>
          </div>
          <h3 class="mt-6 font-display text-xl font-bold">{b.bloque.replace(/^Bloque [IVX]+:\s*/, '')}</h3>
          <p class="mt-3 text-grafito">{b.metodologia}</p>
        </li>
      ))}
    </ol>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="pieza p-7"><h3 class="font-display text-lg font-bold">{T.dobleVia.horizontal.titulo}</h3><p class="mt-2 text-grafito">{T.dobleVia.horizontal.descripcion}</p></div>
      <div class="pieza p-7"><h3 class="font-display text-lg font-bold">{T.dobleVia.vertical.titulo}</h3><p class="mt-2 text-grafito">{T.dobleVia.vertical.descripcion}</p></div>
    </div>
  </section>

  <!-- CALENDARIO -->
  <section id="calendario" class="bg-hundido py-20 sm:py-24">
    <div class="envoltura">
      <div class="grid gap-6 lg:grid-cols-[1fr_1fr] lg:items-end">
        <div>
          <p class="etiqueta">Calendario del ciclo 2026–2027</p>
          <h2 class="titular-l mt-4">24 sesiones, cuatro géneros</h2>
        </div>
        <p class="text-grafito lg:justify-self-end lg:text-right">{TALLER.calendario_base}.<br />Toca una sesión para ver el tema y el ejercicio.</p>
      </div>
      <div class="mt-12 grid gap-12">
        {mods.map((m) => (
          <div class="grid gap-6 lg:grid-cols-[16rem_1fr]">
            <div class="lg:sticky lg:top-28 lg:self-start">
              <p class="font-display text-6xl font-extrabold text-naranja/90">{m.modulo}</p>
              <h3 class="mt-2 font-display text-xl font-bold leading-tight">{m.nombre}</h3>
              <p class="mt-1 text-sm text-tenue">Sesiones {m.sesiones[0].sesion} a {m.sesiones[m.sesiones.length - 1].sesion}</p>
            </div>
            <ol class="grid gap-3">
              {m.sesiones.map((s) => {
                const lec = lecturas(s);
                const previa = SESIONES[SESIONES.indexOf(s) - 1]?.fecha ?? '0';
                const receso = recesos.filter((r) => r.fecha < s.fecha && r.fecha > previa);
                return (
                  <>
                    {receso.length > 0 && <li class="rounded-pieza border border-dashed border-linea px-5 py-4 text-sm text-tenue">Vacaciones de invierno UJAT: sin sesión el {receso.map((r) => fechaLarga(r.fecha, false)).join(' y el ')}.</li>}
                    <li data-fecha={s.fecha} id={`sesion-${s.sesion}`} class:list={['sesion group rounded-pieza border bg-superficie transition', proxima?.fecha === s.fecha ? 'border-naranja shadow-alta' : 'border-linea']}>
                      <details>
                        <summary class="grid cursor-pointer list-none grid-cols-[3.5rem_1fr_auto] items-start gap-4 p-5 sm:p-6 [&::-webkit-details-marker]:hidden">
                          <span class="font-display text-3xl font-extrabold leading-none numero">{String(s.sesion).padStart(2, '0')}</span>
                          <span class="min-w-0">
                            <span class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.12em] text-tenue">
                              <span class="first-letter:uppercase">{fechaLarga(s.fecha)}</span>
                              <span class="marca-actual hidden rounded-full bg-naranja px-2 py-0.5 text-[0.65rem] text-white">Próxima</span>
                              <span class="marca-pasada hidden rounded-full bg-hundido px-2 py-0.5 text-[0.65rem]">Realizada</span>
                            </span>
                            <span class="mt-1 block font-serif text-[1.35rem] font-medium leading-snug">{s.titulo}</span>
                            {lec.length > 0 && <span class="mt-1 block text-sm text-grafito">{lec.map((x) => x.autor).join(' · ')}</span>}
                          </span>
                          <span class="mt-1 grid h-8 w-8 place-items-center rounded-full border border-linea text-grafito transition group-open:rotate-45" aria-hidden="true">+</span>
                        </summary>
                        <div class="grid gap-5 border-t border-linea px-5 pb-6 pt-5 sm:px-6 md:grid-cols-2">
                          <div><p class="text-xs font-semibold uppercase tracking-[0.12em] text-naranja-tinta">Tema</p><p class="mt-2 text-[0.97rem] text-grafito">{s.eje}</p></div>
                          <div>
                            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-naranja-tinta">Leeremos</p>
                            <ul class="mt-2 grid gap-1 text-[0.97rem]">{lec.map((x) => <li><span class="font-semibold">{x.autor}</span>{x.obra && <span class="voz text-grafito">, {x.obra}</span>}</li>)}</ul>
                            <p class="mt-4 text-xs font-semibold uppercase tracking-[0.12em] text-naranja-tinta">Ejercicio</p>
                            <p class="mt-2 text-[0.97rem] text-grafito">{s.ejercicio}</p>
                          </div>
                        </div>
                      </details>
                    </li>
                  </>
                );
              })}
            </ol>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COORDINA -->
  <section class="envoltura grid gap-12 py-20 sm:py-24 lg:grid-cols-[1fr_1.2fr]">
    <div>
      <p class="etiqueta">Quién coordina</p>
      <h2 class="titular-l mt-4">{T.titularAcademico.nombre}</h2>
      <p class="mt-2 font-display text-sm font-semibold text-naranja-tinta">{T.titularAcademico.cargo}</p>
      <p class="prosa mt-6">{T.titularAcademico.semblanza}</p>
      <p class="prosa mt-4">{T.coordinacionDocente.enfoque}</p>
    </div>
    <div>
      <p class="etiqueta">La clínica de textos</p>
      <ol class="mt-6 grid gap-4">
        {T.reglasClinica.map((r) => (
          <li class="pieza grid grid-cols-[3rem_1fr] gap-4 p-6">
            <span class="font-serif text-3xl italic text-naranja">{r.numero}</span>
            <div><h3 class="font-display font-bold">{r.nombre}</h3><p class="mt-1 font-serif text-lg italic text-tinta">{r.principio}</p><p class="mt-2 text-sm text-grafito">{r.descripcion}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- INSCRIPCIÓN -->
  <section id="inscripcion" class="bg-noche py-20 text-white sm:py-24">
    <div class="envoltura grid gap-12 lg:grid-cols-[1.1fr_1fr]">
      <div>
        <p class="etiqueta etiqueta-clara">Cómo participar</p>
        <h2 class="titular-l mt-4">Llega el sábado. Así de simple.</h2>
        <ol class="mt-8 grid gap-6">
          {[['Avísanos por WhatsApp', 'Escríbenos tu nombre para tenerte en la lista y mandarte las lecturas de la semana.'],
            ['Lee el texto de la sesión', 'Cada martes publicamos en redes qué vamos a leer; si no alcanzas, también puedes ir.'],
            ['Ve a la Librería Universitaria UJAT', 'Av. 27 de Febrero 626, Centro, a unos pasos del Instituto Juárez. Empezamos a las 11:00.']].map(([t, d], i) => (
            <li class="grid grid-cols-[2.5rem_1fr] gap-4">
              <span class="grid h-10 w-10 place-items-center rounded-full bg-naranja font-display font-bold">{i + 1}</span>
              <div><h3 class="font-display text-lg font-bold">{t}</h3><p class="mt-1 text-white/70">{d}</p></div>
            </li>
          ))}
        </ol>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href={wa(T.logistica.contacto.mensajePredefinido)} target="_blank" rel="noopener" class="boton-primario">Avisar por WhatsApp</a>
          <a href={CONTACTO.mapaTaller} target="_blank" rel="noopener" class="boton-claro">Cómo llegar</a>
        </div>
      </div>
      <div>
        <p class="etiqueta etiqueta-clara">Preguntas frecuentes</p>
        <div class="mt-6 divide-y divide-white/10 border-y border-white/10">
          {preguntas.map(([p, r]) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display font-bold [&::-webkit-details-marker]:hidden">{p}<span class="text-naranja transition group-open:rotate-45" aria-hidden="true">+</span></summary>
              <p class="mt-3 text-white/70">{r}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var hoy = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Mexico_City' }).format(new Date());
      var filas = Array.prototype.slice.call(document.querySelectorAll('.sesion[data-fecha]'));
      var prox = filas.find(function (f) { return f.dataset.fecha >= hoy; });
      filas.forEach(function (f) {
        var pasada = f.dataset.fecha < hoy;
        f.classList.toggle('opacity-60', pasada);
        f.querySelector('.marca-pasada').classList.toggle('hidden', !pasada);
        f.querySelector('.marca-actual').classList.toggle('hidden', f !== prox);
        f.classList.toggle('border-naranja', f === prox); f.classList.toggle('shadow-alta', f === prox);
        if (f !== prox) f.classList.add('border-linea');
      });
      if (prox) prox.querySelector('details').open = true;
    })();
  </script>
</BaseLayout>
