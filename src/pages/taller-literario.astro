                            title="Copiar temario de esta sesión para WhatsApp"
                          >
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                          </button>
                        </div>
                      </div>

                      <h4 class="text-lg sm:text-xl font-monograph font-bold text-ink-deep group-hover:text-cacao transition leading-snug">
                        {sesion.titulo}
                      </h4>

                      <!-- Conceptos Clave Badges -->
                      <div class="flex flex-wrap gap-1.5 pt-0.5">
                        {sesion.conceptosClave.map((concepto) => (
                          <span class="px-2.5 py-1 rounded-lg bg-paper-warm text-xs font-swiss font-medium text-ink-deep border border-paper-border">
                            {concepto}
                          </span>
                        ))}
                      </div>

                      <!-- Eje Teórico -->
                      <p class="text-xs sm:text-sm text-ink-deep font-sans leading-relaxed pt-1">
                        {sesion.ejeTeorico}
                      </p>
                    </div>

                    <!-- Lecturas Canónicas Comentadas -->
                    <div class="p-4 rounded-2xl bg-paper-warm/80 border border-paper-border space-y-2">
                      <span class="text-xs font-swiss font-bold uppercase tracking-wider text-cacao-dark flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-oro" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                        <span>Lecturas de Referencia Comentadas:</span>
                      </span>
                      <ul class="text-xs sm:text-sm text-ink space-y-1.5 font-serif">
                        {sesion.lecturasReferencia.map((lectura) => (
                          <li class="leading-relaxed">
                            <strong class="text-ink-deep">{lectura.autor}:</strong> <em>«{lectura.obra}»</em> 
                            <span class="text-xs text-ink-muted font-sans block sm:inline">({lectura.enfoque})</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <!-- Ejercicio en Aula & Clínica -->
                    <div class="pt-2 border-t border-paper-border space-y-2.5">
                      
                      <!-- Ejercicio Práctico -->
                      <div class="bg-paper-warm/50 p-3.5 rounded-xl border border-paper-border space-y-1">
                        <div class="flex flex-wrap justify-between items-center gap-1 text-xs font-swiss font-bold text-cacao uppercase">
                          <span>✍️ Gimnasio Creativo ({sesion.ejercicioAula.duracion})</span>
                          <span>{sesion.ejercicioAula.titulo}</span>
                        </div>
                        <p class="text-ink-deep text-xs sm:text-sm leading-relaxed">
                          {sesion.ejercicioAula.instruccion}
                        </p>
                        {sesion.ejercicioAula.restricciones && (
                          <span class="text-xs text-cacao-dark font-mono block italic font-medium">
