---
// src/pages/taller-literario.astro - Portal Oficial del Taller Literario LVT-UJAT (Gratis)
// Sociedad de Escritores Letras y Voces de Tabasco, A.C. & Librería Universitaria UJAT
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { 
  DATOS_GENERALES_TALLER, 
  PILARES_PEDAGOGICOS, 
  MODULOS_TALLER 
} from '../data/taller';
import '../styles/global.css';

const basePath = "";
---

<BaseLayout 
  title="TALLER LITERARIO LVT-UJAT (GRATIS) · Librería Universitaria UJAT & LVT, A.C."
  description="Programa formativo oficial del Taller Literario Sabatino: 24 semanas, 4 módulos (Narrativa, Poesía, Ensayo, Crónica y Edición) en la Librería Universitaria UJAT. Entrada libre y gratuita para todo público."
>
  <!-- DATOS ESTRUCTURADOS SCHEMA.ORG (CURSO / EVENTO FORMATIVO) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Course",
    "name": "Taller Literario LVT-UJAT (Gratis)",
    "description": "Programa formativo sabatino de 24 semanas y 4 módulos (Narrativa, Poesía, Ensayo, Crónica y Edición de Antología Impresa) en la Librería Universitaria UJAT. Entrada 100% libre y gratuita.",
    "provider": {
      "@type": "EducationalOrganization",
      "name": "Sociedad de Escritores Letras y Voces de Tabasco, A.C. en colaboración con Librería Universitaria UJAT",
      "url": "https://letrasyvocesdetabasco.org"
    },
    "isAccessibleForFree": true,
    "inLanguage": "es",
    "location": {
      "@type": "Place",
      "name": "Librería Universitaria UJAT",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Av. 27 de Febrero No. 626, Col. Centro",
        "addressLocality": "Villahermosa",
        "addressRegion": "Tabasco",
        "addressCountry": "MX"
      }
    },
    "courseSchedule": {
      "@type": "Schedule",
      "repeatFrequency": "Weekly",
      "byDay": "Saturday",
      "startTime": "11:00:00-06:00",
      "endTime": "13:00:00-06:00"
    }
  })} />

  <Navbar />

  <main class="pt-16 sm:pt-20 bg-paper min-h-screen text-ink selection:bg-cacao selection:text-white">
    
    <!-- 0. MIGAS DE PAN & BARRA DE ACCESOS DIRECTOS -->
    <div class="bg-paper-warm border-b border-paper-border py-2.5">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-wrap items-center justify-between gap-3 text-xs sm:text-sm font-swiss text-ink-muted">
        <div class="flex items-center gap-2">
          <a href={`${basePath}/`} class="hover:text-cacao transition">Inicio</a>
          <span>/</span>
          <a href={`${basePath}/EEJG`} class="hover:text-cacao transition">Escuela & Formación</a>
          <span>/</span>
          <span class="text-cacao font-bold">Taller Literario LVT-UJAT (Gratis)</span>
        </div>

        <nav class="hidden md:flex items-center gap-4 text-xs font-bold uppercase tracking-wider text-ink-muted">
          <a href="#coordinacion" class="hover:text-cacao transition">Coordinación</a>
          <span class="text-paper-border">·</span>
          <a href="#pilares" class="hover:text-cacao transition">Pilares</a>
          <span class="text-paper-border">·</span>
          <a href="#metodologia" class="hover:text-cacao transition">Modalidad</a>
          <span class="text-paper-border">·</span>
          <a href="#triada" class="hover:text-cacao transition">Dinámica</a>
          <span class="text-paper-border">·</span>
          <a href="#reglas-oro" class="hover:text-cacao transition">Clínica</a>
          <span class="text-paper-border">·</span>
          <a href="#programa-curricular" class="text-cacao hover:underline transition">24 Sesiones</a>
          <span class="text-paper-border">·</span>
          <a href="#acreditacion" class="hover:text-cacao transition">Constancia</a>
          <span class="text-paper-border">·</span>
          <a href="#sede" class="hover:text-cacao transition">Sede</a>
        </nav>
      </div>
    </div>

    <!-- 1. HERO INSTITUCIONAL -->
    <section class="relative py-16 sm:py-24 overflow-hidden border-b border-paper-border bg-gradient-to-b from-paper-warm/70 via-paper to-paper">
      <!-- Acentos de fondo -->
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-cacao/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-oro/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <div class="max-w-4xl mx-auto text-center space-y-6">
          
          <!-- Sellos de Alianza Institucional -->
          <div class="inline-flex flex-wrap items-center justify-center gap-2 sm:gap-3 px-4 py-2 rounded-full bg-paper-card border border-paper-border shadow-subtle text-xs sm:text-sm font-swiss font-bold tracking-wider uppercase text-ink-muted">
            <span class="flex items-center gap-1.5 text-cacao">
              <span class="w-2 h-2 rounded-full bg-cacao animate-pulse"></span>
              Librería Universitaria UJAT
            </span>
            <span class="text-paper-border">|</span>
            <span class="text-ink-deep font-bold">Letras y Voces de Tabasco, A.C.</span>
            <span class="text-paper-border">|</span>
            <span class="px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-800 text-xs font-bold uppercase">Entrada Libre y Gratuita</span>
          </div>

          <!-- Título Principal con Jerarquía Editorial -->
          <div class="space-y-3">
            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-monograph font-bold text-ink-deep tracking-tight leading-[1.15]">
              Taller Literario <br class="hidden sm:inline" />
              <span class="italic text-cacao font-serif">LVT - UJAT (Gratis)</span>
            </h1>
            <p class="text-base sm:text-xl font-serif italic text-ink-muted max-w-2xl mx-auto leading-relaxed">
              Lectura crítica, práctica creativa y clínica de textos en comunidad
            </p>
          </div>

          <!-- Píldoras Informativas Clave Accesibles -->
          <div class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-3 pt-2">
            <span class="px-4 py-2 rounded-xl bg-paper-card border border-paper-border text-ink text-xs sm:text-sm font-swiss font-bold flex items-center gap-2 shadow-subtle">
              <svg class="w-4 h-4 text-cacao shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <span>Todos los Sábados · 11:00 a 13:00 hrs</span>
            </span>

            <span class="px-4 py-2 rounded-xl bg-paper-card border border-paper-border text-ink text-xs sm:text-sm font-swiss font-bold flex items-center gap-2 shadow-subtle">
              <svg class="w-4 h-4 text-oro shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span>Librería Universitaria UJAT (Centro Histórico)</span>
            </span>

            <span class="px-4 py-2 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-800 text-xs sm:text-sm font-swiss font-extrabold tracking-wide uppercase flex items-center gap-1.5 shadow-subtle">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>100% Libre y Gratuito</span>
            </span>
          </div>

          <!-- Lema Pedagógico Destacado -->
          <div class="pt-4 max-w-xl mx-auto">
            <blockquote class="p-4 rounded-2xl bg-paper-card/90 border-l-4 border-cacao shadow-subtle text-sm sm:text-base font-serif italic text-ink-muted">
              «Escribir se aprende leyendo con atención y reescribiendo con paciencia. El taller es un espacio abierto para descubrir y afinar la propia voz.»
            </blockquote>
          </div>

          <!-- Botones de Acción Inmediata -->
          <div class="pt-4 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
            <a 
              href="#programa-curricular" 
              class="touch-target-48 inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-cacao hover:bg-cacao-dark text-white font-swiss text-xs sm:text-sm font-bold uppercase tracking-wider shadow-elevated hover:scale-102 active:scale-95 transition"
            >
              <span>Explorar las 24 Sesiones</span>
              <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </a>

            <a 
              href={`https://wa.me/${DATOS_GENERALES_TALLER.logistica.contacto.telefonoClean}?text=${encodeURIComponent(DATOS_GENERALES_TALLER.logistica.contacto.mensajePredefinido)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="touch-target-48 inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-paper-card hover:bg-paper-warm text-ink font-swiss text-xs sm:text-sm font-bold uppercase tracking-wider border border-paper-border shadow-subtle hover:scale-102 active:scale-95 transition"
            >
              <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.97.53 1.961.815 2.796.815 3.183 0 5.769-2.586 5.77-5.766.001-3.182-2.585-5.768-5.77-5.768zm0 10.369c-.759 0-1.503-.205-2.155-.595l-.154-.092-1.6.42.427-1.56-.1-.16c-.43-.685-.658-1.482-.657-2.31 0-2.536 2.063-4.6 4.601-4.6 2.536 0 4.6 2.064 4.6 4.6 0 2.537-2.064 4.601-4.602 4.601z"/></svg>
              <span>Preguntar por WhatsApp</span>
            </a>
          </div>

        </div>

      </div>
    </section>

    <!-- 2. COORDINACIÓN DOCENTE & COLECTIVO LITERARIO -->
    <section id="coordinacion" class="py-14 sm:py-18 bg-paper border-b border-paper-border scroll-mt-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="bg-paper-card rounded-3xl p-6 sm:p-10 border border-paper-border shadow-elevated grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <!-- Sello Institucional -->
          <div class="lg:col-span-4 flex flex-col items-center text-center space-y-4">
            <div class="relative w-36 h-36 sm:w-44 sm:h-44 rounded-3xl bg-gradient-to-br from-[#2D241E] to-[#191614] p-1 shadow-2xl border border-paper-border flex items-center justify-center group">
              <div class="w-full h-full rounded-[22px] bg-[#231B15] flex flex-col items-center justify-center text-white space-y-2 relative overflow-hidden">
                <div class="absolute inset-0 bg-cacao/10 opacity-0 group-hover:opacity-100 transition duration-300"></div>
                <svg class="w-14 h-14 text-oro-bright" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                <span class="text-xs font-swiss font-bold tracking-widest uppercase text-oro">Coordinación</span>
              </div>
            </div>

            <div class="space-y-1">
              <span class="inline-block px-3.5 py-1 rounded-full bg-cacao/15 text-cacao text-xs font-swiss font-extrabold uppercase tracking-wider border border-cacao/30">
                Letras y Voces de Tabasco, A.C.
              </span>
              <h3 class="text-xl sm:text-2xl font-monograph font-bold text-ink-deep">
                {DATOS_GENERALES_TALLER.coordinacionDocente.colectivo}
              </h3>
              <p class="text-xs sm:text-sm font-swiss text-ink-muted">
                Espacio cultural en Librería Universitaria UJAT
              </p>
            </div>
          </div>

          <!-- Presentación Institucional -->
          <div class="lg:col-span-8 space-y-4">
            
            <div class="space-y-2">
              <div class="inline-flex items-center gap-2 text-xs font-swiss font-bold text-cacao uppercase tracking-wider">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span>Propósito y Ambiente del Taller</span>
              </div>
              <h4 class="text-2xl font-monograph font-bold text-ink-deep leading-snug">
                Un Espacio Abierto para Leer, Escribir y Crecer Juntos
              </h4>
            </div>

            <p class="text-sm sm:text-base text-ink-muted leading-relaxed font-sans">
              El taller está a cargo del colegiado de autores y promotores culturales de la <strong class="text-ink">Sociedad «Letras y Voces de Tabasco, A.C.»</strong>, con la participación regular de mediadores y talleristas invitados. Nuestro enfoque es colaborativo e intergeneracional: jóvenes, adultos y personas mayores encuentran aquí un entorno propicio para explorar su vocación literaria.
            </p>

            <p class="text-sm sm:text-base text-ink-muted leading-relaxed font-sans">
              {DATOS_GENERALES_TALLER.coordinacionDocente.enfoque} Cada sesión combina el análisis de lecturas fundamentales con ejercicios de redacción en la mesa y una clínica de textos respetuosa, donde aprendemos a mirar el propio borrador con ojos críticos y constructivos.
            </p>

            <div class="p-4 rounded-2xl bg-paper-warm border border-paper-border space-y-1">
              <span class="text-xs font-swiss font-bold text-cacao uppercase tracking-widest block">Principio del Taller</span>
              <p class="text-xs sm:text-sm font-serif italic text-ink leading-relaxed">
                {DATOS_GENERALES_TALLER.coordinacionDocente.cita}
              </p>
            </div>

          </div>

        </div>

      </div>
    </section>

    <!-- 3. PILARES DEL OFICIO Y MODELO DE DOBLE VÍA -->
    <section id="pilares" class="py-14 sm:py-20 bg-paper-warm/40 border-b border-paper-border scroll-mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
        
        <div class="text-center max-w-3xl mx-auto space-y-3">
          <span class="px-3 py-1 rounded-full bg-paper-card border border-paper-border text-cacao text-[11px] font-swiss font-bold uppercase tracking-widest shadow-subtle">
            Sustento Teórico y Metodológico
          </span>
          <h2 class="text-3xl sm:text-4xl font-monograph font-bold text-ink-deep tracking-tight">
            Los Cuatro Pilares del <span class="italic text-cacao font-serif">Oficio Literario</span>
          </h2>
          <p class="text-sm sm:text-base font-serif italic text-ink-muted">
            «Un marco pedagógico concebido para transformar el impulso creativo en una práctica formal reflexiva y profesional.»
          </p>
        </div>

        <!-- Grilla de los 4 Pilares -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {PILARES_PEDAGOGICOS.map((pilar) => (
            <div class="bg-paper-card rounded-2xl p-6 border border-paper-border shadow-subtle hover:border-cacao hover:shadow-elevated transition duration-300 flex flex-col justify-between space-y-4 group">
              <div class="space-y-3">
                <div class="w-10 h-10 rounded-xl bg-cacao/10 text-cacao border border-cacao/20 flex items-center justify-center font-bold text-sm group-hover:bg-cacao group-hover:text-white transition duration-300">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                </div>
                <h3 class="text-base font-monograph font-bold text-ink-deep leading-snug">
                  {pilar.titulo}
                </h3>
                <p class="text-xs text-ink-muted font-sans leading-relaxed">
                  {pilar.descripcion}
                </p>
              </div>
            </div>
          ))}
        </div>

        <!-- Tarjetas del Modelo de Doble Vía (Walk-In vs Ruta Completa) -->
        <div id="metodologia" class="mt-8 pt-8 border-t border-paper-border scroll-mt-20">
          <div class="text-center max-w-2xl mx-auto space-y-2 mb-8">
            <span class="text-[11px] font-swiss font-bold text-oro uppercase tracking-widest">Estrategia de Mediación</span>
            <h3 class="text-2xl font-monograph font-bold text-ink-deep">
              El Modelo de Doble Vía: Entrada Libre y Rigor Curricular
            </h3>
            <p class="text-xs text-ink-muted">
              Diseñado para conciliar el acceso público sin barreras socioeconómicas con la excelencia en formación de autores.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            <!-- Vía Horizontal -->
            <div class="bg-paper-card rounded-3xl p-6 sm:p-8 border border-paper-border shadow-subtle flex flex-col justify-between space-y-4">
              <div class="space-y-3">
                <span class="px-3 py-1 rounded-full bg-amber-500/10 text-amber-800 text-[10px] font-swiss font-bold uppercase tracking-wider border border-amber-500/20">
                  Para Asistentes Ocasionales o Nuevos
                </span>
                <h4 class="text-xl font-monograph font-bold text-ink-deep">
                  {DATOS_GENERALES_TALLER.dobleVia.horizontal.titulo}
                </h4>
                <p class="text-xs sm:text-sm text-ink-muted leading-relaxed font-sans">
                  {DATOS_GENERALES_TALLER.dobleVia.horizontal.descripcion}
                </p>
              </div>
              <ul class="text-xs text-ink-muted space-y-2 pt-2 border-t border-paper-border">
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-cacao"></span>
                  <span>Sin necesidad de haber asistido a sábados anteriores.</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-cacao"></span>
                  <span>Entrega de fichas de trabajo físicas (One-Page Handouts).</span>
                </li>
              </ul>
            </div>

            <!-- Vía Vertical -->
            <div class="bg-paper-card rounded-3xl p-6 sm:p-8 border border-cacao/30 shadow-elevated flex flex-col justify-between space-y-4 bg-gradient-to-br from-paper-card to-paper-warm/50">
              <div class="space-y-3">
                <span class="px-3 py-1 rounded-full bg-cacao/15 text-cacao text-[10px] font-swiss font-bold uppercase tracking-wider border border-cacao/30">
                  Para Talleristas Regulares
                </span>
                <h4 class="text-xl font-monograph font-bold text-ink-deep">
                  {DATOS_GENERALES_TALLER.dobleVia.vertical.titulo}
                </h4>
                <p class="text-xs sm:text-sm text-ink-muted leading-relaxed font-sans">
                  {DATOS_GENERALES_TALLER.dobleVia.vertical.descripcion}
                </p>
              </div>
              <ul class="text-xs text-ink-muted space-y-2 pt-2 border-t border-paper-border">
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-oro"></span>
                  <span>Construcción del Dossier Individual para becas y concursos.</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-oro"></span>
                  <span>Publicación autoral formal en la Antología Impresa del Taller.</span>
                </li>
              </ul>
            </div>

          </div>
        </div>

      </div>
    </section>

    <!-- 4. ESTRUCTURA TRÍADICA Y REGLAS DE ORO DE LA CLÍNICA -->
    <section id="triada" class="py-14 sm:py-20 bg-paper border-b border-paper-border scroll-mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
        
        <!-- Dinámica de las 2 Horas Sabatinas -->
        <div class="text-center max-w-3xl mx-auto space-y-3">
          <span class="px-3 py-1 rounded-full bg-paper-warm border border-paper-border text-ink text-[11px] font-swiss font-bold uppercase tracking-widest">
            Cronometría Sabatina (11:00 a 13:00 hrs)
          </span>
          <h2 class="text-3xl sm:text-4xl font-monograph font-bold text-ink-deep">
            La Estructura Tríadica de <span class="italic text-cacao font-serif">Cada Sesión</span>
          </h2>
          <p class="text-sm font-serif italic text-ink-muted">
            «120 minutos diseñados para equilibrar teoría provocadora, creación inmediata y crítica rigurosa.»
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {DATOS_GENERALES_TALLER.estructuraTriadica.map((bloque, idx) => (
            <div class="bg-paper-card rounded-2xl p-6 border border-paper-border shadow-subtle flex flex-col justify-between space-y-4">
              <div class="space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-mono font-bold text-cacao uppercase">Fase {idx + 1}</span>
                  <span class="px-2.5 py-0.5 rounded-full bg-paper-warm text-ink text-[10px] font-mono font-bold">
                    ⏱️ {bloque.duracion}
                  </span>
                </div>
                <h3 class="text-lg font-monograph font-bold text-ink-deep">
                  {bloque.bloque}
                </h3>
                <p class="text-xs text-ink-muted leading-relaxed font-sans">
                  {bloque.metodologia}
                </p>
              </div>
            </div>
          ))}
        </div>

        <!-- Las 3 Reglas de Oro de la Clínica -->
        <div id="reglas-oro" class="mt-12 bg-gradient-to-br from-[#1C1814] to-[#25201B] rounded-3xl p-6 sm:p-10 border border-[#3A2E26] shadow-2xl text-white space-y-6 scroll-mt-20">
          <div class="text-center max-w-2xl mx-auto space-y-2">
            <span class="px-3 py-1 rounded-full bg-oro/20 text-oro-bright text-[10px] font-swiss font-bold uppercase tracking-wider border border-oro/30">
