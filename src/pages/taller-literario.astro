                      </div>

                      <!-- Dinámica de Clínica -->
                      <div class="bg-paper-warm/50 p-3.5 rounded-xl border border-paper-border space-y-1">
                        <span class="text-xs font-swiss font-bold text-ink-deep uppercase block">
                          🔍 Clínica de Textos ({sesion.clinicaTextos.duracion})
                        </span>
                        <p class="text-ink text-xs sm:text-sm leading-relaxed">
                          {sesion.clinicaTextos.dinamica}
                        </p>
                        <span class="text-xs text-ink-muted font-sans block pt-1 border-t border-paper-border/60">
                          <strong>Criterio:</strong> {sesion.clinicaTextos.criterioEvaluacion}
                        </span>
                      </div>

                    </div>

                  </div>
                ))}
              </div>

            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- 6. PRODUCTOS TANGIBLES Y SISTEMA DE EVALUACIÓN FORMATIVA -->
    <section id="acreditacion" class="py-14 sm:py-20 bg-paper border-b border-paper-border scroll-mt-20">
