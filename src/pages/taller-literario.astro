                          <span class="text-xs font-mono font-semibold text-ink-muted">120 min</span>
                          <button 
                            type="button" 
                            onclick={`copySessionCard(${sesion.semana}, '${sesion.titulo.replace(/'/g, "\\'")}', '${sesion.ejeTeorico.replace(/'/g, "\\'")}', '${sesion.lecturasReferencia.map(l => l.autor + ' - ' + l.obra).join(', ').replace(/'/g, "\\'")}', '${sesion.ejercicioAula.titulo.replace(/'/g, "\\'")}')`}
