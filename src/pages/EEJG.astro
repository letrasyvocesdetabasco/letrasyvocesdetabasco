---
import BaseLayout from '../layouts/BaseLayout.astro';
import { IDENTIDAD_ESCUELA as E, DIPLOMADOS_GOROSTIZA as DIPLO, CURSOS_CONTINUOS_GOROSTIZA as CURSOS } from '../data/escuela';
const waEscuela = (t: string) => `https://wa.me/${E.contactoDirecto.telefonosClean[0]}?text=${encodeURIComponent(t)}`;
---
<BaseLayout title="Escuela de Escritores «José Gorostiza» · Letras y Voces de Tabasco" description="Diplomados y cursos de creación literaria, redacción, periodismo, guion y oratoria con aval de la UJAT desde 2001. Escuela de Escritores «José Gorostiza».">
  <section class="relative overflow-hidden bg-noche text-white">
    <img src="/assets/galeria/web/presentacion_tardes_opalos_autores.webp" alt="" class="absolute inset-0 h-full w-full object-cover opacity-30 grayscale" />
    <div class="absolute inset-0 bg-gradient-to-r from-noche via-noche/85 to-noche/30"></div>
    <div class="envoltura relative grid gap-10 py-16 sm:py-24 lg:grid-cols-[1.4fr_1fr] lg:items-end">
      <div>
        <p class="etiqueta etiqueta-clara">{E.siglaOficial} · Filial de Letras y Voces · desde 2001</p>
        <h1 class="titular-xl mt-6 max-w-[14ch]">Escuela de Escritores «José Gorostiza»</h1>
        <p class="mt-6 max-w-xl font-serif text-2xl italic leading-snug text-white/80">«{E.lema}». {E.filosofia}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={waEscuela('Hola, quiero información sobre los diplomados de la Escuela «José Gorostiza».')} target="_blank" rel="noopener" class="boton-primario">Pedir informes</a>
          <a href="#diplomados" class="boton-claro">Ver diplomados</a>
        </div>
      </div>
      <dl class="grid grid-cols-2 gap-6 rounded-pieza bg-white/[0.06] p-6 ring-1 ring-white/15">
        <div><dt class="text-xs uppercase tracking-[0.14em] text-white/50">Diplomados</dt><dd class="font-display text-4xl font-extrabold numero">{DIPLO.length}</dd></div>
        <div><dt class="text-xs uppercase tracking-[0.14em] text-white/50">Cursos</dt><dd class="font-display text-4xl font-extrabold numero">{CURSOS.length}</dd></div>
        <div class="col-span-2"><dt class="text-xs uppercase tracking-[0.14em] text-white/50">Alianza UJAT</dt><dd class="font-display font-bold">{E.alianzaUjat.vigencia}</dd></div>
      </dl>
    </div>
  </section>

  <section class="envoltura grid gap-12 py-20 sm:py-24 lg:grid-cols-[1fr_1.2fr]">
    <div>
      <p class="etiqueta">La escuela</p>
      <h2 class="titular-l mt-4">Creada por escritores, para escritores</h2>
      <p class="prosa mt-5">{E.mision}</p>
      <p class="prosa mt-4">Fundada en {E.fechaFundacion.toLowerCase()} por el {E.primerDirector}.</p>
    </div>
    <div class="grid gap-4">
      <p class="etiqueta">Beneficios de la alianza con la UJAT</p>
      <ul class="grid gap-3">{E.alianzaUjat.beneficios.map((b) => <li class="pieza flex gap-4 p-5"><span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-naranja"></span><span class="text-grafito">{b}</span></li>)}</ul>
      <p class="text-sm text-tenue">Para acreditar: {E.reglasAcreditacion.asistenciaMinima} y calificación mínima de {E.reglasAcreditacion.calificacionMinima}.</p>
    </div>
  </section>

  <section id="diplomados" class="bg-hundido py-20 sm:py-24">
    <div class="envoltura">
      <p class="etiqueta">Diplomados</p>
      <h2 class="titular-l mt-4">Formación con aval curricular</h2>
      <div class="mt-12 grid gap-5 md:grid-cols-2">
        {DIPLO.map((d) => (
          <article class="pieza flex flex-col p-7">
            <div class="flex flex-wrap gap-2 text-xs"><span class="chip">{d.modalidad}</span><span class="chip">{d.modulosCount} módulos</span></div>
            <h3 class="mt-4 font-display text-xl font-bold leading-tight">{d.nombre}</h3>
            <p class="mt-3 text-[0.96rem] text-grafito"><span class="font-semibold text-tinta">Para:</span> {d.dirigidoA}</p>
            <details class="group mt-4 border-t border-linea pt-4">
              <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-semibold text-naranja-tinta [&::-webkit-details-marker]:hidden">Materias y perfil de egreso<span class="transition group-open:rotate-45" aria-hidden="true">+</span></summary>
              <ul class="mt-3 grid gap-1.5 text-sm text-grafito">{d.materiasClave.map((m) => <li class="flex gap-2"><span class="text-naranja">—</span>{m}</li>)}</ul>
              <p class="mt-3 text-sm text-grafito">{d.perfilEgresado}</p>
            </details>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="cursos" class="envoltura py-20 sm:py-24">
    <p class="etiqueta">Cursos continuos</p>
    <h2 class="titular-l mt-4">Para afinar el oficio</h2>
    <ul class="mt-12 grid gap-px overflow-hidden rounded-pieza border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-3">
      {CURSOS.map((c, i) => (
        <li class:list={['bg-superficie p-7', i === CURSOS.length - 1 && CURSOS.length % 3 === 1 && 'lg:col-span-3', i === CURSOS.length - 1 && CURSOS.length % 2 === 1 && 'sm:max-lg:col-span-2']}>
          <h3 class="font-display text-lg font-bold">{c.nombre}</h3>
          <p class="mt-2 text-[0.96rem] text-grafito">{c.descripcion}</p>
          <p class="mt-4 text-xs text-tenue">{c.ejes.join(' · ')}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="envoltura">
    <div class="grid gap-10 rounded-[1.75rem] bg-noche p-8 text-white sm:p-12 lg:grid-cols-2">
      <div>
        <p class="etiqueta etiqueta-clara">Sede y horarios</p>
        <h2 class="titular-m mt-4">{E.ubicacion.sede}</h2>
        <p class="mt-3 text-white/70">{E.ubicacion.direccion}</p>
        <p class="mt-4 font-display font-bold">{E.ubicacion.horarios}</p>
      </div>
      <div>
        <p class="etiqueta etiqueta-clara">Dirección</p>
        <ul class="mt-4 grid gap-4">
          {E.direccionActual.map((d, i) => (
            <li class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 pb-4">
              <div><p class="font-display font-bold">{d.nombre}</p><p class="text-sm text-white/60">{d.cargo}</p></div>
              <a href={`https://wa.me/${d.telefonoClean}`} target="_blank" rel="noopener" class="boton-claro !min-h-[40px] !px-4 !text-xs">WhatsApp {d.telefono}</a>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-sm text-white/60">Correo: <span class="select-all">{E.contactoDirecto.email}</span></p>
      </div>
    </div>
  </section>
</BaseLayout>
