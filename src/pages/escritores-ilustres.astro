---
import BaseLayout from '../layouts/BaseLayout.astro';
import Portada from '../components/sitio/Portada.astro';
import TarjetaEscritor from '../components/sitio/TarjetaEscritor.astro';
import Efemeride from '../components/sitio/Efemeride.astro';
import { ESCRITORES, BLOQUES } from '../lib/escritores';
const cuenta = (b: string) => ESCRITORES.filter((x) => x.bloque === b).length;
const generos = [...new Set(ESCRITORES.flatMap((e) => e.generos))];
const siglos = [...new Set(ESCRITORES.map((e) => e.siglo).filter(Boolean))].sort();
const letras = [...new Set(ESCRITORES.map((e) => e.nombreCorto.split(' ').pop()![0].toUpperCase()))].sort();
---
<BaseLayout title="Escritores ilustres · Letras y Voces de Tabasco" description={`Semblanzas, obras y citas con fuente de ${ESCRITORES.length} escritores de Tabasco, México y el mundo que forman el canon de lectura de Letras y Voces de Tabasco.`}>
  <Portada etiqueta="Canon de lectura" titulo="Escritores ilustres" entradilla="Las voces de Tabasco primero, y junto a ellas los autores de México y del mundo que leemos en el taller. Cada ficha reúne su vida, su obra, sus textos y citas con fuente.">
    <div class="mt-10 grid gap-6 border-y border-linea py-6 lg:grid-cols-[1fr_22rem] lg:items-start">
      <div class="grid gap-4">
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar por origen">
          <button type="button" class="chip" data-f="bloque" data-v="" aria-pressed="true">Todos <span class="ml-1.5 text-tenue numero">{ESCRITORES.length}</span></button>
          {BLOQUES.map((b) => <button type="button" class="chip" data-f="bloque" data-v={b.id} aria-pressed="false">{b.nombre} <span class="ml-1.5 text-tenue numero">{cuenta(b.id)}</span></button>)}
        </div>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar por género">
          {generos.map((g) => <button type="button" class="chip" data-f="genero" data-v={g} aria-pressed="false">{g}</button>)}
          <span class="mx-1 hidden h-6 w-px bg-linea sm:block"></span>
          {siglos.map((s) => <button type="button" class="chip" data-f="siglo" data-v={s} aria-pressed="false">{s}</button>)}
          <button type="button" class="chip" data-f="pd" data-v="1" aria-pressed="false" title="Autores cuya obra puede leerse íntegra en la Sala de lectura">Dominio público</button>
        </div>
      </div>
      <div class="grid gap-3">
        <label class="relative block">
          <span class="sr-only">Buscar escritor</span>
          <input id="buscar" type="search" placeholder="Buscar por nombre, obra o lugar" class="campo !rounded-full !pl-10" autocomplete="off" />
          <svg class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-tenue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </label>
        <Efemeride />
      </div>
    </div>
  </Portada>

  <section class="envoltura pb-8">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3 text-sm text-tenue">
      <p><span id="conteo" class="font-semibold text-tinta numero">{ESCRITORES.length}</span> escritores</p>
      <nav class="hidden flex-wrap gap-1 lg:flex" aria-label="Índice alfabético por apellido">
        {letras.map((l) => <button type="button" class="h-7 w-7 rounded-full text-xs font-semibold text-grafito transition hover:bg-hundido hover:text-tinta" data-letra={l}>{l}</button>)}
      </nav>
    </div>
    <ul id="rejilla" class="grid grid-cols-2 gap-x-5 gap-y-10 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
      {ESCRITORES.map((e, i) => (
        <li class="aparece" data-bloque={e.bloque} data-genero={e.generos.join('|')} data-siglo={e.siglo} data-pd={e.dominioPublico ? '1' : ''} data-letra={e.nombreCorto.split(' ').pop()![0].toUpperCase()}
            data-texto={`${e.nombre} ${e.obras.map((o) => o.titulo).join(' ')} ${e.municipioOrigen} ${e.movimiento}`.toLowerCase()}>
          <TarjetaEscritor e={e} i={i} cita={e.citas[0]?.texto} />
        </li>
      ))}
    </ul>
    <p id="sin-resultados" class="hidden py-16 text-center text-grafito">No encontramos a nadie con esa búsqueda. <button type="button" id="limpiar" class="enlace">Limpiar filtros</button></p>
  </section>

  <section class="envoltura mt-16">
    <div class="grid gap-6 rounded-[1.75rem] bg-noche p-8 text-white sm:p-12 lg:grid-cols-[1.4fr_1fr] lg:items-center">
      <div>
        <p class="etiqueta etiqueta-clara">¿Falta alguien?</p>
        <h2 class="titular-l mt-4">El canon es una conversación abierta</h2>
        <p class="mt-4 max-w-xl text-white/75">Cada ficha cita sus fuentes. Si encuentras un dato que corregir o quieres proponer a un autor tabasqueño, escríbenos: lo revisamos en la mesa del taller.</p>
      </div>
      <div class="grid gap-3"><a href="/contacto?asunto=Propuesta+de+autor" class="boton-primario">Proponer un autor</a><a href="/sala-de-lectura" class="boton-claro">Ir a la Sala de lectura</a></div>
    </div>
  </section>

  <script>
    function init() {
      const items = [...document.querySelectorAll<HTMLLIElement>('#rejilla > li')]; if (!items.length) return;
      const q = document.getElementById('buscar') as HTMLInputElement, vacio = document.getElementById('sin-resultados')!, conteo = document.getElementById('conteo')!;
      const filtros: Record<string, string> = { bloque: '', genero: '', siglo: '', pd: '' };
      const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '');
      const params = new URLSearchParams(location.search);
      if (params.get('bloque')) filtros.bloque = params.get('bloque')!;
      const aplicar = () => {
        const t = norm((q.value || '').toLowerCase()); let n = 0;
        items.forEach((li) => {
          const ok = (!filtros.bloque || li.dataset.bloque === filtros.bloque) && (!filtros.genero || (li.dataset.genero || '').split('|').includes(filtros.genero))
            && (!filtros.siglo || li.dataset.siglo === filtros.siglo) && (!filtros.pd || li.dataset.pd === '1') && (!t || norm(li.dataset.texto || '').includes(t));
          li.hidden = !ok; if (ok) n++;
        });
        vacio.classList.toggle('hidden', n > 0); conteo.textContent = String(n);
        document.querySelectorAll<HTMLButtonElement>('[data-f]').forEach((b) => b.setAttribute('aria-pressed', String(filtros[b.dataset.f!] === b.dataset.v)));
      };
      document.querySelectorAll<HTMLButtonElement>('[data-f]').forEach((b) => b.addEventListener('click', () => { const f = b.dataset.f!, v = b.dataset.v!; filtros[f] = filtros[f] === v && v !== '' ? '' : v; aplicar(); }));
      q.addEventListener('input', aplicar);
      document.getElementById('limpiar')?.addEventListener('click', () => { Object.keys(filtros).forEach((k) => (filtros[k] = '')); q.value = ''; aplicar(); });
      document.querySelectorAll<HTMLButtonElement>('[data-letra]').forEach((b) => b.addEventListener('click', () => { const li = items.find((x) => !x.hidden && x.dataset.letra === b.dataset.letra); li?.scrollIntoView({ behavior: 'smooth', block: 'center' }); }));
      aplicar();
    }
    document.addEventListener('astro:page-load', init);
  </script>
</BaseLayout>
