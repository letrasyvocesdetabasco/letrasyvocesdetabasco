---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Página no encontrada · Letras y Voces de Tabasco">
  <section class="envoltura grid min-h-[60vh] place-items-center py-20 text-center">
    <div>
      <p class="font-display text-[7rem] font-extrabold leading-none text-naranja numero">404</p>
      <h1 class="titular-l mt-4">Esta página se perdió entre los ríos</h1>
      <p class="mx-auto mt-4 max-w-md font-serif text-xl italic text-grafito">Quizá cambió de lugar con el rediseño. Prueba desde el inicio o ve directo al taller.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="boton-oscuro">Ir al inicio</a>
        <a href="/taller-literario" class="boton-contorno">Ver el taller</a>
      </div>
    </div>
  </section>
</BaseLayout>
