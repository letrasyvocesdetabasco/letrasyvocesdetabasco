---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ESCRITORES } from '../lib/escritores';
const cita = ESCRITORES.find((e) => e.id === 'jorge-luis-borges')?.citas[0];
---
<BaseLayout title="Página no encontrada · Letras y Voces de Tabasco" sinIndexar>
  <section class="envoltura grid min-h-[70vh] place-items-center py-20 text-center">
    <div class="max-w-xl">
      <p class="etiqueta justify-center">Error 404</p>
      <h1 class="titular-xl mt-6">Esta página se extravió entre los libros.</h1>
      {cita && <blockquote class="mt-8 font-serif text-xl italic text-grafito">«{cita.texto}»<footer class="mt-2 text-sm not-italic text-tenue">{cita.obra}</footer></blockquote>}
      <div class="mt-10 flex flex-wrap justify-center gap-3"><a href="/" class="boton-primario">Volver al inicio</a><a href="/buscar" class="boton-contorno">Buscar en el sitio</a></div>
    </div>
  </section>
</BaseLayout>
