---
// src/pages/autores.astro - Padrón Oficial de Escritores, Fundadores y Plumas de Tabasco
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import DirectorioAutores from '../components/DirectorioAutores.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const basePath = "";
---

<BaseLayout 
  title="Padrón Oficial de Autores y Fundadores · Sociedad de Escritores LVT, A.C."
  description="Directorio de escritoras, escritores, poetas, cronistas y miembros de la Sociedad de Escritores Letras y Voces de Tabasco, A.C."
>
  <Navbar />

  <main class="pt-16 sm:pt-20">
    <div class="bg-paper-warm border-b border-paper-border py-3">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 text-xs font-swiss tracking-normal text-ink-muted">
        <a href="/" class="hover:text-cacao transition">Inicio</a>
        <span>/</span>
        <span class="text-cacao font-bold">Padrón de Escritores y Fundadores</span>
      </div>
    </div>

    <DirectorioAutores />
  </main>

  <Footer />
</BaseLayout>
