---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PADRON_AUTORES as A } from '../data/autores';
const categorias = [...new Set(A.map((a) => a.categoria))];
const nombreCat: Record<string, string> = { 'Mesa Directiva & Órganos Colegiados': 'Mesa directiva', 'Socios Activos & Colaboradores': 'Socios y colaboradores', 'Expresidentes & Fundadores Históricos': 'Fundadores y expresidentes' };
const iniciales = (n: string) => n.replace(/\(.*?\)|†/g, '').split(' ').filter(Boolean).slice(0, 2).map((p) => p[0]).join('');
---
<BaseLayout title="Padrón de autores · Letras y Voces de Tabasco" description="Directorio de socios, fundadores y mesa directiva de la Sociedad de Escritores Letras y Voces de Tabasco.">
  <section class="envoltura pb-10 pt-14 sm:pt-20">
    <p class="etiqueta">Padrón de autores</p>
    <div class="mt-6 grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-end">
      <h1 class="titular-xl max-w-[12ch]">Quienes escriben con nosotros</h1>
      <p class="entradilla">Más de cien escritoras y escritores han formado parte de Letras y Voces de Tabasco. Aquí está una muestra de la mesa directiva, los socios y quienes fundaron la Sociedad.</p>
    </div>
  </section>
  {categorias.map((c) => (
    <section class="envoltura py-10">
      <h2 class="titular-m border-b border-linea pb-4">{nombreCat[c] ?? c}</h2>
      <ul class="mt-8 grid gap-5 md:grid-cols-2">
        {A.filter((a) => a.categoria === c).map((a) => (
          <li class="pieza grid grid-cols-[3.5rem_1fr] gap-5 p-6">
            <span class="grid h-14 w-14 place-items-center rounded-full bg-tinta font-display text-lg font-bold text-fondo">{iniciales(a.nombre)}</span>
            <div class="min-w-0">
              <h3 class="font-display text-lg font-bold leading-tight">{a.tratamiento ? `${a.tratamiento} ` : ''}{a.nombre}</h3>
              <p class="mt-1 text-sm font-semibold text-naranja-tinta">{a.rolGremial}</p>
              <p class="mt-3 text-[0.96rem] text-grafito">{a.semblanza}</p>
              {a.obraRepresentativa && <p class="mt-3 text-sm"><span class="text-tenue">Obra:</span> <span class="voz">{a.obraRepresentativa}</span></p>}
              {a.antologiasParticipadas?.length > 0 && <div class="mt-3 flex flex-wrap gap-1.5">{a.antologiasParticipadas.map((x) => <span class="chip !text-[0.7rem]">{x}</span>)}</div>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
