---
// src/pages/historia.astro - Cronología Fundacional, Fundadores y Gobernanza Histórica 1987-2026
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Semblanza from '../components/Semblanza.astro';
import CronologiaFundacional from '../components/CronologiaFundacional.astro';
import SolvenciaInstitucional from '../components/SolvenciaInstitucional.astro';
import MesaDirectiva from '../components/MesaDirectiva.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const basePath = "";
---

<BaseLayout 
  title="Historia, Fundadores y Gobernanza (1987–2026) · Sociedad de Escritores LVT"
  description="Trayectoria histórica de 39 años, cuadro de fundadores con el Arq. Mario de Lille Fuentes, solvencia jurídica y Mesa Directiva 2026–2029 de Letras y Voces de Tabasco, A.C."
>
  <Navbar />

  <main class="pt-16 sm:pt-20">
    <div class="bg-paper-warm border-b border-paper-border py-3">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 text-xs font-swiss tracking-normal text-ink-muted">
        <a href="/" class="hover:text-cacao transition">Inicio</a>
        <span>/</span>
        <span class="text-cacao font-bold">Historia, Fundadores & Gobernanza</span>
      </div>
    </div>

    <Semblanza />
    <CronologiaFundacional />
    <MesaDirectiva />
    <SolvenciaInstitucional />
  </main>

  <Footer />
</BaseLayout>
