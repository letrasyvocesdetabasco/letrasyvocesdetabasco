---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CRONOLOGIA_DIRECTIVA as CRONO, CUADRO_FUNDADORES as FUNDADORES } from '../data/historia';
import { PADRON_AUTORES } from '../data/autores';
const mesa = PADRON_AUTORES.filter((a) => a.esMesaDirectiva);
const alianzas = [
  ['UJAT', 'Universidad Juárez Autónoma de Tabasco'], ['IEC', 'Instituto Estatal de Cultura de Tabasco'],
  ['FECA', 'Fondo Estatal para la Cultura y las Artes'], ['INBAL', 'Instituto Nacional de Bellas Artes y Literatura'],
];
const anios = new Date().getFullYear() - 1987;
---
<BaseLayout title="Nosotros · Historia y mesa directiva · Letras y Voces de Tabasco" description="Historia de la Sociedad de Escritores Letras y Voces de Tabasco desde 1987: fundadores, presidencias, mesa directiva 2026–2029 y alianzas.">
  <section class="envoltura pb-16 pt-14 sm:pt-20">
    <p class="etiqueta">Nosotros · Desde 1987</p>
    <div class="mt-6 grid gap-10 lg:grid-cols-[1.25fr_1fr] lg:items-end">
      <h1 class="titular-xl max-w-[14ch]">{anios} años haciendo comunidad con la palabra</h1>
      <p class="entradilla">La Sociedad de Escritores Letras y Voces de Tabasco es una asociación civil sin fines de lucro, fundada en Villahermosa en 1987, que forma escritores, edita antologías y preserva la memoria literaria del sureste.</p>
    </div>
    <div class="mt-14 grid gap-px overflow-hidden rounded-pieza border border-linea bg-linea md:grid-cols-2">
      <div class="bg-superficie p-8 sm:p-10">
        <p class="etiqueta">Misión</p>
        <p class="mt-4 font-serif text-[1.35rem] leading-snug">Contribuir a la creación, difusión, profesionalización y preservación de la literatura, la cultura y la memoria de Tabasco y el sureste de México, formando nuevas generaciones de escritores.</p>
      </div>
      <div class="bg-superficie p-8 sm:p-10">
        <p class="etiqueta">Visión</p>
        <p class="mt-4 font-serif text-[1.35rem] leading-snug">Ser la institución civil de referencia en Tabasco para la docencia literaria, la dignificación de sus escritores y el cuidado vivo de las voces de nuestra tierra.</p>
      </div>
    </div>
  </section>

  <section class="bg-hundido py-20 sm:py-24">
    <div class="envoltura">
      <p class="etiqueta">Cronología</p>
      <h2 class="titular-l mt-4">De la fundación a hoy</h2>
      <ol class="relative mt-14 grid gap-12 border-l-2 border-linea pl-8 sm:pl-12">
        {CRONO.map((c, i) => (
          <li class="aparece relative">
            <span class:list={['absolute -left-[2.6rem] top-1 h-4 w-4 rounded-full ring-4 ring-hundido sm:-left-[3.6rem]', i === CRONO.length - 1 ? 'bg-naranja' : 'bg-tinta']}></span>
            <p class="font-display text-3xl font-extrabold numero text-naranja-tinta">{c.periodo}</p>
            <h3 class="mt-2 max-w-3xl font-display text-lg font-bold leading-snug">{c.liderazgo}</h3>
            <p class="prosa mt-3">{c.descripcion}</p>
            {c.hitos?.length > 0 && <ul class="mt-4 grid max-w-3xl gap-2">{c.hitos.map((h) => <li class="flex gap-3 text-[0.97rem] text-grafito"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-naranja"></span>{h}</li>)}</ul>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="envoltura py-20 sm:py-24">
    <p class="etiqueta">Cuadro fundacional</p>
    <h2 class="titular-l mt-4 max-w-[18ch]">Quienes pusieron la primera piedra</h2>
    <ul class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {FUNDADORES.map((f) => (
        <li class="border-t border-linea pt-5">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-naranja-tinta">{f.rol}</p>
          <h3 class="mt-2 font-display text-lg font-bold">{f.nombre}</h3>
          <p class="mt-2 text-[0.97rem] text-grafito">{f.detalle}</p>
        </li>
      ))}
    </ul>
  </section>

  <section id="directiva" class="bg-noche py-20 text-white sm:py-24">
    <div class="envoltura">
      <p class="etiqueta etiqueta-clara">Mesa directiva 2026–2029</p>
      <h2 class="titular-l mt-4">Quién encabeza hoy la Sociedad</h2>
      <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {mesa.map((m) => (
          <li class="rounded-pieza bg-white/[0.05] p-7 ring-1 ring-white/10">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-naranja">{m.rolGremial.split('·')[0].trim()}</p>
            <h3 class="mt-3 font-display text-xl font-bold">{m.tratamiento ? `${m.tratamiento} ` : ''}{m.nombre}</h3>
            <p class="mt-3 text-sm leading-relaxed text-white/70">{m.semblanza}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="solvencia" class="envoltura py-20 sm:py-24">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.2fr]">
      <div>
        <p class="etiqueta">Transparencia</p>
        <h2 class="titular-l mt-4">Una asociación civil, con reglas claras</h2>
        <p class="prosa mt-5">Somos una A.C. constituida conforme a las leyes de Tabasco, sin fines de lucro. Los órganos de gobierno se eligen en asamblea general y rinden cuentas a la membresía. La documentación legal está bajo resguardo de la Secretaría General y puede consultarse previa solicitud.</p>
      </div>
      <div>
        <p class="etiqueta">Alianzas</p>
        <ul class="mt-6 grid grid-cols-2 gap-4">
          {alianzas.map(([s, n]) => (
            <li class="pieza p-6"><p class="font-display text-2xl font-extrabold">{s}</p><p class="mt-1 text-sm text-grafito">{n}</p></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
