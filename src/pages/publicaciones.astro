---
// src/pages/publicaciones.astro - Catálogo Editorial Completo y Fondo Bibliográfico Histórico de LVT
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Publicaciones from '../components/Publicaciones.astro';
import ProximamenteRevista from '../components/ProximamenteRevista.astro';
import ReadingModal from '../components/ReadingModal.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const basePath = "";
---

<BaseLayout 
  title="Catálogo Editorial & Antologías Oficiales · Sociedad de Escritores LVT, A.C."
  description="Acervo editorial oficial de Letras y Voces de Tabasco: Animalia Literaria, A corazón abierto, Tardes Tabasqueñas de Ópalos y Topacios, La Mujer en el Siglo XXI, Amarellus y publicaciones históricas."
>
  <Navbar />

  <main class="pt-16 sm:pt-20">
    <div class="bg-paper-warm border-b border-paper-border py-3">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 text-xs font-swiss tracking-normal text-ink-muted">
        <a href="/" class="hover:text-cacao transition">Inicio</a>
        <span>/</span>
        <span class="text-cacao font-bold">Catálogo Editorial & Antologías</span>
      </div>
    </div>

    <!-- 1. Catálogo de Libros y Obras Publicadas -->
    <Publicaciones />

    <!-- 2. Próximamente: Revista Literaria Letra y Voz -->
    <ProximamenteRevista />
  </main>

  <ReadingModal />
  <Footer />
</BaseLayout>
